<!-- ===== SCRIPTS ===== -->
<script>
(function() {
  'use strict';

  /* A. NOTIFICACIONES SOCIALES */
  (function initSocialNotifications() {
    var toast = document.getElementById('frc-social-toast');
    if (!toast) return;
    var names = {{ section.settings.social_names | default: 'Maria,Juan,Ana,Luisa,Carlos,Carmen,Pedro,Diana,Andres,Laura' | split: ',' | json }};
    var neighborhoods = {{ section.settings.social_neighborhoods | default: 'Bosa,Kennedy,Chapinero,Usaquen,Suba,Teusaquillo,Fontibon,Engativa,Puente Aranda,Martires' | split: ',' | json }};
    var products = {{ section.settings.social_products | default: 'Aceite de Coco Virgen,Harina de Almendras,Leche de Almendras,Mantequilla de Mani,Aceite de Oliva,Chia Organica,Quinoa,Panela Organica,Cacao en Polvo,Avena en Hojuelas' | split: ',' | json }};
    var icons = ['🛒','🔥','✅','⭐','🌿','📦','💚'];
    var actions = ['acaba de comprar','acaba de anadir a su carrito','compro hace unos minutos','acaba de comprar 2 unidades de'];
    var viewerMessages = [
      '{{ section.settings.social_viewer_msg_1 | default: "3 personas estan viendo esta pagina ahora" }}',
      '{{ section.settings.social_viewer_msg_2 | default: "5 personas tienen este producto en su carrito" }}',
      '{{ section.settings.social_viewer_msg_3 | default: "Alguien de Kennedy acaba de comprar" }}'
    ];
    var toastText = document.getElementById('frc-social-toast-text');
    var toastIcon = document.getElementById('frc-social-toast-icon');
    var toastTime = document.getElementById('frc-social-toast-time');
    var toastClose = document.getElementById('frc-social-toast-close');
    var dismissTimer = null;
    var intervalTimer = null;
    function pick(arr) { return arr[Math.floor(Math.random() * arr.length)]; }
    function generateMessage() {
      var isViewer = Math.random() < 0.25;
      if (isViewer) return { icon: '👀', text: pick(viewerMessages) };
      var name = pick(names).trim();
      var hood = pick(neighborhoods).trim();
      var prod = pick(products).trim();
      var action = pick(actions);
      var icon = pick(icons);
      return { icon: icon, text: name + ' de ' + hood + ' ' + action + ' ' + prod };
    }
    function showToast() {
      clearTimeout(dismissTimer);
      var msg = generateMessage();
      toastText.textContent = msg.text;
      toastIcon.textContent = msg.icon;
      var mins = Math.floor(Math.random() * 10) + 1;
      toastTime.textContent = 'Hace ' + mins + ' min';
      toast.classList.add('visible');
      dismissTimer = setTimeout(hideToast, {{ section.settings.social_display_duration | default: 5000 }});
    }
    function hideToast() { toast.classList.remove('visible'); }
    if (toastClose) toastClose.addEventListener('click', function() { hideToast(); clearTimeout(dismissTimer); });
    var firstDelay = {{ section.settings.social_first_delay | default: 5000 }};
    var intervalMin = {{ section.settings.social_interval_min | default: 240000 }};
    var intervalMax = {{ section.settings.social_interval_max | default: 240000 }};
    setTimeout(function() {
      showToast();
      intervalTimer = setInterval(function() { showToast(); }, Math.floor(Math.random() * (intervalMax - intervalMin) + intervalMin));
    }, firstDelay);
    document.addEventListener('visibilitychange', function() { if (document.hidden) { clearTimeout(dismissTimer); clearInterval(intervalTimer); } });
  })();

  /* B. COUNTDOWN */
  (function initCountdown() {
    var timerEl = document.getElementById('frutos-countdown-timer');
    var barEl = document.getElementById('frutos-countdown-bar');
    if (!timerEl) return;
    var targetDateStr = '{{ section.settings.countdown_target_date }}';
    var targetHour = {{ section.settings.countdown_target_hour | default: 23 }};
    var targetMinute = {{ section.settings.countdown_target_minute | default: 59 }};
    var endMsg = '{{ section.settings.countdown_ended_text | default: "Oferta finalizada!" }}';
    var hideOnEnd = {{ section.settings.countdown_hide_on_end | default: false }};
    var stickyOnScroll = {{ section.settings.countdown_sticky | default: false }};
    var targetDate;
    function getTargetDate() {
      var now = new Date();
      if (targetDateStr && targetDateStr.match(/^\d{4}-\d{2}-\d{2}$/)) {
        var parts = targetDateStr.split('-');
        return new Date(parseInt(parts[0]), parseInt(parts[1]) - 1, parseInt(parts[2]), targetHour, targetMinute, 0);
      }
      return new Date(now.getFullYear(), now.getMonth(), now.getDate(), targetHour, targetMinute, 0);
    }
    targetDate = getTargetDate();
    var now = new Date();
    if (targetDate < now && !targetDateStr) targetDate = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1, targetHour, targetMinute, 0);
    function updateCountdown() {
      var now = new Date();
      var diff = Math.max(0, Math.floor((targetDate - now) / 1000));
      if (diff <= 0) {
        if (hideOnEnd && barEl) { barEl.style.display = 'none'; } else {
          var labelEl = document.getElementById('frc-countdown-label');
          var suffixEl = document.getElementById('frc-countdown-suffix');
          var timerWrap = document.getElementById('frutos-countdown-timer');
          if (labelEl) labelEl.textContent = endMsg;
          if (suffixEl) suffixEl.style.display = 'none';
          if (timerWrap) timerWrap.style.display = 'none';
          if (barEl) barEl.classList.add('frc-countdown--ended');
        }
        clearInterval(countdownInterval);
        return;
      }
      var d = Math.floor(diff / 86400);
      var h = Math.floor((diff % 86400) / 3600);
      var m = Math.floor((diff % 3600) / 60);
      var s = diff % 60;
      var daysEl = document.getElementById('cd-days');
      if (daysEl) daysEl.textContent = String(d).padStart(2,'0');
      document.getElementById('cd-hours').textContent = String(h).padStart(2,'0');
      document.getElementById('cd-minutes').textContent = String(m).padStart(2,'0');
      document.getElementById('cd-seconds').textContent = String(s).padStart(2,'0');
    }
    updateCountdown();
    var countdownInterval = setInterval(updateCountdown, 1000);
    if (stickyOnScroll && barEl) {
      var originalOffset = barEl.offsetTop;
      window.addEventListener('scroll', function() {
        if (window.pageYOffset > originalOffset) barEl.classList.add('frc-countdown--sticky-active');
        else barEl.classList.remove('frc-countdown--sticky-active');
      });
    }
  })();

  /* C. EXIT INTENT */
  (function initExitIntent() {
    var popup = document.getElementById('frc-exit-popup');
    var backdrop = document.getElementById('frc-exit-backdrop');
    var closeBtn = document.getElementById('frc-exit-close');
    if (!popup) return;
    var cooldownDays = {{ section.settings.popup_cooldown_days | default: 7 }};
    var lsKey = 'frc_exit_shown_v3';
    var lsTimestampKey = 'frc_exit_timestamp';
    var triggered = false;
    function shouldShow() {
      var stored = localStorage.getItem(lsKey);
      var timestamp = localStorage.getItem(lsTimestampKey);
      if (!stored || !timestamp) return true;
      return (Date.now() - parseInt(timestamp)) > (cooldownDays * 24 * 60 * 60 * 1000);
    }
    function showPopup() {
      if (triggered || !shouldShow()) return;
      triggered = true;
      localStorage.setItem(lsKey, '1');
      localStorage.setItem(lsTimestampKey, String(Date.now()));
      popup.classList.add('visible');
      if (backdrop) backdrop.classList.add('visible');
    }
    function closePopup() { popup.classList.remove('visible'); if (backdrop) backdrop.classList.remove('visible'); }
    document.addEventListener('mouseleave', function(e) { if (e.clientY <= 5 && e.relatedTarget === null) showPopup(); });
    var lastScrollY = window.scrollY;
    var scrollUpCount = 0;
    var scrollThreshold = {{ section.settings.popup_mobile_scroll_threshold | default: 80 }};
    function checkMobileScroll() {
      var currentY = window.scrollY;
      var diff = lastScrollY - currentY;
      if (diff > scrollThreshold) {
        scrollUpCount++;
        if (scrollUpCount >= 2) { showPopup(); window.removeEventListener('scroll', onMobileScroll); }
      }
      lastScrollY = currentY;
    }
    function onMobileScroll() { if (window.innerWidth <= 768) checkMobileScroll(); }
    window.addEventListener('scroll', onMobileScroll, { passive: true });
    if (closeBtn) closeBtn.addEventListener('click', closePopup);
    if (backdrop) backdrop.addEventListener('click', closePopup);
    document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closePopup(); });
    var form = document.getElementById('frc-exit-form');
    if (form) form.addEventListener('submit', function() { setTimeout(closePopup, 1500); });
  })();

  /* COPIAR CUPON */
  window.frcCopyCoupon = function() {
    var code = document.getElementById('frc-coupon-code');
    var btn = document.getElementById('frc-coupon-copy-btn');
    if (!code || !btn) return;
    var text = code.textContent.trim();
    function onCopied() {
      btn.textContent = '\u00a1Copiado!';
      btn.classList.add('copied');
      setTimeout(function() { btn.textContent = 'Copiar'; btn.classList.remove('copied'); }, 2500);
    }
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(onCopied).catch(function() { fallbackCopy(text); });
    } else { fallbackCopy(text); }
    function fallbackCopy(txt) {
      var ta = document.createElement('textarea');
      ta.value = txt; ta.style.position = 'fixed'; ta.style.opacity = '0';
      document.body.appendChild(ta); ta.select();
      try { document.execCommand('copy'); } catch(e) {}
      document.body.removeChild(ta); onCopied();
    }
  };

  /* E. BARRA DE PROGRESO */
  (function initProgressBar() {
    var bar = document.getElementById('frc-progress-bar');
    if (!bar) return;
    var showAfterScroll = {{ section.settings.progress_show_after | default: 300 }};
    var hideAtBottom = {{ section.settings.progress_hide_at_bottom | default: true }};
    function updateProgress() {
      var scrollTop = window.pageYOffset || document.documentElement.scrollTop;
      var docHeight = document.documentElement.scrollHeight - window.innerHeight;
      if (docHeight <= 0) return;
      var progress = Math.min(1, Math.max(0, scrollTop / docHeight));
      if (scrollTop > showAfterScroll) bar.classList.add('visible'); else bar.classList.remove('visible');
      if (hideAtBottom && progress > 0.96) bar.classList.remove('visible');
      var steps = bar.querySelectorAll('.frc-progress-step');
      var fills = bar.querySelectorAll('.frc-progress-fill');
      if (progress < 0.33) { setStepState(steps, 0); setFillWidth(fills, 0, progress / 0.33 * 100); setFillWidth(fills, 1, 0); }
      else if (progress < 0.66) { setStepState(steps, 1); setFillWidth(fills, 0, 100); setFillWidth(fills, 1, (progress - 0.33) / 0.33 * 100); }
      else { setStepState(steps, 2); setFillWidth(fills, 0, 100); setFillWidth(fills, 1, 100); }
    }
    function setStepState(steps, activeIndex) {
      steps.forEach(function(step, i) {
        step.classList.remove('frc-progress-step--active', 'frc-progress-step--done');
        if (i < activeIndex) step.classList.add('frc-progress-step--done');
        else if (i === activeIndex) step.classList.add('frc-progress-step--active');
      });
    }
    function setFillWidth(fills, index, pct) { if (fills[index]) fills[index].style.width = pct + '%'; }
    window.addEventListener('scroll', updateProgress, { passive: true });
    updateProgress();
  })();

  /* F. WHATSAPP */
  (function initWhatsApp() {
    var waBtn = document.getElementById('frc-wa-btn');
    var waCard = document.getElementById('frc-wa-card');
    var waClose = document.getElementById('frc-wa-card-close');
    var waShown = false;
    if (waBtn && waCard) {
      waBtn.addEventListener('click', function() { waShown = !waShown; waCard.style.display = waShown ? 'block' : 'none'; });
      if (waClose) waClose.addEventListener('click', function() { waShown = false; waCard.style.display = 'none'; });
      var delay = {{ section.settings.wa_auto_open_delay }};
      if (delay > 0) {
        setTimeout(function() {
          if (!sessionStorage.getItem('frc_wa_opened')) { waCard.style.display = 'block'; waShown = true; sessionStorage.setItem('frc_wa_opened','1'); }
        }, delay * 1000);
      }
    }
  })();

  /* G. FADE-UP */
  (function initFadeUp() {
    var elements = document.querySelectorAll('.frc-fade-up');
    if (!elements.length) return;
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) { if (entry.isIntersecting) { entry.target.classList.add('frc-visible'); observer.unobserve(entry.target); } });
    }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
    elements.forEach(function(el) { observer.observe(el); });
  })();

  /* H. FILTROS Y BÚSQUEDA POR ZONAS */
  (function initZoneFilters() {
    var searchInput = document.getElementById('fdr-rates-search');
    var zoneCards = document.querySelectorAll('.fdr-rates-zone-card');
    var filterBtns = document.querySelectorAll('.fdr-rates-filter');
    var emptyMsg = document.getElementById('fdr-rates-empty');
    if (!searchInput) return;

    function fmtCOP(n) { return '$' + Number(n).toLocaleString('es-CO'); }
    document.querySelectorAll('[data-price]').forEach(function(el) {
      var p = el.getAttribute('data-price');
      if (p) el.textContent = fmtCOP(p);
    });

    function doSearch(query) {
      var q = query.trim().toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
      var anyVisible = false;
      zoneCards.forEach(function(card) {
        var keywords = (card.getAttribute('data-keywords') || '').toLowerCase();
        var title = card.querySelector('.fdr-zone-header__title').textContent.toLowerCase();
        var visible = !q || keywords.includes(q) || title.includes(q);
        card.hidden = !visible;
        if (visible) anyVisible = true;
      });
      if (emptyMsg) emptyMsg.hidden = anyVisible;
      if (q) filterBtns.forEach(function(b) { b.classList.remove('is-active'); b.setAttribute('aria-pressed','false'); });
    }

    searchInput.addEventListener('input', function() { doSearch(this.value); });

    filterBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var zone = this.getAttribute('data-zone');
        var isActive = this.classList.contains('is-active');
        filterBtns.forEach(function(b) { b.classList.remove('is-active'); b.setAttribute('aria-pressed','false'); });
        zoneCards.forEach(function(c) { c.hidden = false; });
        if (!isActive) {
          this.classList.add('is-active');
          this.setAttribute('aria-pressed','true');
          var anyVisible = false;
          zoneCards.forEach(function(card) {
            var match = card.getAttribute('data-zone') === zone;
            card.hidden = !match;
            if (match) anyVisible = true;
          });
          if (emptyMsg) emptyMsg.hidden = anyVisible;
          searchInput.value = '';
        } else {
          if (emptyMsg) emptyMsg.hidden = true;
        }
      });
    });
  })();

})();
</script>

