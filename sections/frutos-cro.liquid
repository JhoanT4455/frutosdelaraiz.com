      "default": "Maria,Juan,Ana,Luisa,Carlos,Carmen,Pedro,Diana,Andres,Laura,Sofia,Miguel"
    },
    {
      "type": "textarea",
      "id": "social_neighborhoods",
      "label": "Barrios (separados por coma)",
      "default": "Bosa,Kennedy,Chapinero,Usaquen,Suba,Teusaquillo,Fontibon,Engativa,Puente Aranda,Martires"
    },
    {
      "type": "textarea",
      "id": "social_products",
      "label": "Productos (separados por coma)",
      "default": "Aceite de Coco Virgen,Harina de Almendras,Leche de Almendras,Mantequilla de Mani,Aceite de Oliva,Chia Organica,Quinoa,Panela Organica,Cacao en Polvo,Avena en Hojuelas"
    },
    {
      "type": "text",
      "id": "social_viewer_msg_1",
      "label": "Mensaje viewers 1",
      "default": "3 personas estan viendo esta pagina ahora"
    },
    {
