{{ 'https://fonts.googleapis.com/css2?family=Amatic+SC:wght@700&family=Lato:wght@300;400;700&family=Montserrat:wght@500;600;700&display=swap' | stylesheet_tag }}

<!-- ============================================================
     FRUTOS CRO EXTRAS v3.2 — ZONAS DE ENVÍO ACTUALIZADAS
     ============================================================ -->

<!-- ===== A. NOTIFICACIONES SOCIALES DE COMPRAS RECIENTES ===== -->
{%- if section.settings.show_social_notifications -%}
<div class="frc-social-toast" id="frc-social-toast" aria-live="polite" aria-atomic="true">
  <div class="frc-social-toast__icon" id="frc-social-toast-icon">🛒</div>
  <div class="frc-social-toast__body">
    <p class="frc-social-toast__text" id="frc-social-toast-text"></p>
    <span class="frc-social-toast__time" id="frc-social-toast-time">Hace unos segundos</span>
  </div>
  <button class="frc-social-toast__close" id="frc-social-toast-close" aria-label="Cerrar notificacion">✕</button>
</div>
{%- endif -%}

<!-- ===== D. SECCION COMO FUNCIONA ===== -->
{%- if section.settings.show_how_it_works -%}
<section class="hiw-section frc-fade-up" style="background:{{ section.settings.hiw_bg }}; padding:{{ section.settings.hiw_padding_top }}px 5% {{ section.settings.hiw_padding_bottom }}px;">
  <div class="hiw-inner">
    {%- if section.settings.hiw_eyebrow != blank -%}
      <span class="hiw-eyebrow frc-fade-up" style="color:{{ section.settings.hiw_accent }};">{{ section.settings.hiw_eyebrow }}</span>
    {%- endif -%}
    <h2 class="hiw-title frc-fade-up" style="color:{{ section.settings.hiw_title_color }};">{{ section.settings.hiw_title }}</h2>
    {%- if section.settings.hiw_subtitle != blank -%}
      <p class="hiw-subtitle frc-fade-up" style="color:{{ section.settings.hiw_subtitle_color }};">{{ section.settings.hiw_subtitle }}</p>
    {%- endif -%}
    <div class="hiw-steps">
      {%- for i in (1..4) -%}
        {%- liquid
          case i
          when 1
            assign step_emoji = section.settings.step1_emoji
            assign step_title = section.settings.step1_title
            assign step_desc  = section.settings.step1_desc
          when 2
            assign step_emoji = section.settings.step2_emoji
            assign step_title = section.settings.step2_title
            assign step_desc  = section.settings.step2_desc
          when 3
            assign step_emoji = section.settings.step3_emoji
            assign step_title = section.settings.step3_title
            assign step_desc  = section.settings.step3_desc
          when 4
            assign step_emoji = section.settings.step4_emoji
            assign step_title = section.settings.step4_title
            assign step_desc  = section.settings.step4_desc
          endcase
        -%}
        {%- if step_title != blank -%}
          <div class="hiw-step frc-fade-up">
            <div class="hiw-step__num" style="background:{{ section.settings.hiw_accent }}; color:{{ section.settings.hiw_bg }};">{{ i }}</div>
            <div class="hiw-step__icon">{{ step_emoji }}</div>
            <h3 class="hiw-step__title" style="color:{{ section.settings.hiw_title_color }};">{{ step_title }}</h3>
            <p class="hiw-step__desc" style="color:{{ section.settings.hiw_subtitle_color }};">{{ step_desc }}</p>
          </div>
          {%- if i < 4 and step_title != blank -%}
            <div class="hiw-arrow frc-fade-up" style="color:{{ section.settings.hiw_accent }}">→</div>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- if section.settings.hiw_cta_text != blank -%}
      <div class="hiw-cta frc-fade-up">
        <a href="{{ section.settings.hiw_cta_link | default: '/collections/all' }}" class="hiw-cta-btn" style="background:{{ section.settings.hiw_accent }}; color:{{ section.settings.hiw_btn_text_color }};">
          {{ section.settings.hiw_cta_text }} →
        </a>
      </div>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

<!-- ===== H. MAPA + TARIFAS POR ZONAS DE BOGOTÁ ===== -->
{%- if section.settings.show_delivery_map -%}
{%- liquid
  assign z_bosa     = section.settings.price_bosa     | default: 5500
  assign z_sur_occ  = section.settings.price_sur_occ  | default: 8500
  assign z_centro_o = section.settings.price_centro_o | default: 10500
  assign z_centro_e = section.settings.price_centro_e | default: 11500
  assign z_sur_e    = section.settings.price_sur_e    | default: 12600
  assign z_norte    = section.settings.price_norte    | default: 17500

  assign free_bosa     = section.settings.free_bosa     | default: 180000
  assign free_sur_occ  = section.settings.free_sur_occ  | default: 200000
  assign free_centro_o = section.settings.free_centro_o | default: 200000
  assign free_centro_e = section.settings.free_centro_e | default: 200000
  assign free_sur_e    = section.settings.free_sur_e    | default: 200000
  assign free_norte    = section.settings.free_norte    | default: 250000
-%}
<section
  class="fdr-rates-section frc-fade-up"
  id="fdr-delivery-rates"
  style="background:{{ section.settings.map_bg | default: '#f1f8e9' }}; padding:{{ section.settings.map_padding_top | default: 64 }}px 5% {{ section.settings.map_padding_bottom | default: 64 }}px;"
  aria-labelledby="fdr-rates-title"
>
  <div class="fdr-rates-inner">
    <header class="fdr-rates-header">
      {%- if section.settings.map_eyebrow != blank -%}
        <span class="fdr-rates-eyebrow" style="color:{{ section.settings.map_accent | default: '#156529' }};">{{ section.settings.map_eyebrow }}</span>
      {%- endif -%}
      <h2 class="fdr-rates-title" id="fdr-rates-title" style="color:{{ section.settings.map_title_color | default: '#156529' }};">{{ section.settings.map_title | default: '¿Cuánto cuesta el domicilio en tu zona?' }}</h2>
      {%- if section.settings.map_subtitle != blank -%}
        <p class="fdr-rates-subtitle">{{ section.settings.map_subtitle }}</p>
      {%- endif -%}
    </header>

    <div class="fdr-rates-layout">
      <figure class="fdr-rates-map">
        {%- if section.settings.map_image != blank -%}
          {{
            section.settings.map_image
            | image_url: width: 900
            | image_tag:
              loading: 'lazy',
              decoding: 'async',
              class: 'fdr-rates-map__img',
              alt: section.settings.map_image_alt | default: 'Mapa de zonas de domicilio en Bogotá',
              widths: '400, 600, 900',
              sizes: '(min-width: 900px) 52vw, 100vw'
          }}
        {%- else -%}
          <img
            class="fdr-rates-map__img"
            src="{{ 'mapa-bogota-zonas.png' | asset_url }}"
            alt="{{ section.settings.map_image_alt | default: 'Mapa de zonas de domicilio en Bogotá' }}"
            width="900"
            height="auto"
            loading="lazy"
            decoding="async"
          >
        {%- endif -%}
        {%- if section.settings.map_sede_badge != blank -%}
          <figcaption class="fdr-rates-map__badge">{{ section.settings.map_sede_badge }}</figcaption>
        {%- endif -%}
      </figure>

      <div class="fdr-rates-info">
        <div class="fdr-rates-toolbar">
          <label class="fdr-rates-search__label" for="fdr-rates-search">Busca tu localidad o zona</label>
          <input
            type="search"
            id="fdr-rates-search"
            class="fdr-rates-search__input"
            placeholder="Ej: Bosa, Kennedy, Chapinero, Fontibón…"
            autocomplete="off"
            enterkeyhint="search"
          >
          <div class="fdr-rates-filters" id="fdr-rates-filters" role="group" aria-label="Filtrar por zona">
            <button type="button" class="fdr-rates-filter fdr-rates-filter--bosa" data-zone="bosa" aria-pressed="false">
              <span class="fdr-rates-filter__swatch" aria-hidden="true"></span>
              <span>Zona Local</span>
            </button>
            <button type="button" class="fdr-rates-filter fdr-rates-filter--sur-occ" data-zone="sur-occ" aria-pressed="false">
              <span class="fdr-rates-filter__swatch" aria-hidden="true"></span>
              <span>Sur-Occidente</span>
            </button>
            <button type="button" class="fdr-rates-filter fdr-rates-filter--centro-o" data-zone="centro-o" aria-pressed="false">
              <span class="fdr-rates-filter__swatch" aria-hidden="true"></span>
              <span>Centro-Occidente</span>
            </button>
            <button type="button" class="fdr-rates-filter fdr-rates-filter--centro-e" data-zone="centro-e" aria-pressed="false">
              <span class="fdr-rates-filter__swatch" aria-hidden="true"></span>
              <span>Centro-Oriente</span>
            </button>
            <button type="button" class="fdr-rates-filter fdr-rates-filter--sur-e" data-zone="sur-e" aria-pressed="false">
              <span class="fdr-rates-filter__swatch" aria-hidden="true"></span>
              <span>Sur-Oriente</span>
            </button>
            <button type="button" class="fdr-rates-filter fdr-rates-filter--norte" data-zone="norte" aria-pressed="false">
              <span class="fdr-rates-filter__swatch" aria-hidden="true"></span>
              <span>Norte</span>
            </button>
          </div>
        </div>

        <div class="fdr-rates-list" id="fdr-rates-list" role="region" aria-label="Tarifas por zona">

          <div class="fdr-rates-zone-card fdr-rates-zone-card--bosa" data-zone="bosa" data-keywords="bosa">
            <div class="fdr-zone-header">
              <span class="fdr-zone-header__dot" aria-hidden="true"></span>
              <h3 class="fdr-zone-header__title">Zona Local — Bosa</h3>
              <span class="fdr-zone-header__price" data-price="{{ z_bosa }}"></span>
            </div>
            <p class="fdr-zone-note">🚚 De 1 a 2 días hábiles</p>
            <div class="fdr-zone-free">Gratis en pedidos desde <span data-price="{{ free_bosa }}"></span></div>
            <ul class="fdr-zone-locals" role="list">
              <li class="fdr-zone-local fdr-zone-local--featured"><span>Bosa</span> <span class="fdr-zone-tag">Sede</span></li>
            </ul>
          </div>

          <div class="fdr-rates-zone-card fdr-rates-zone-card--sur-occ" data-zone="sur-occ" data-keywords="kennedy tunjuelito ciudad bolivar soacha">
            <div class="fdr-zone-header">
              <span class="fdr-zone-header__dot" aria-hidden="true"></span>
              <h3 class="fdr-zone-header__title">Sur-Occidente</h3>
              <span class="fdr-zone-header__price" data-price="{{ z_sur_occ }}"></span>
            </div>
            <p class="fdr-zone-note">🚚 De 1 a 2 días hábiles</p>
            <div class="fdr-zone-free">Gratis en pedidos desde <span data-price="{{ free_sur_occ }}"></span></div>
            <ul class="fdr-zone-locals" role="list">
              <li class="fdr-zone-local"><span>Kennedy</span></li>
              <li class="fdr-zone-local"><span>Tunjuelito</span></li>
              <li class="fdr-zone-local"><span>Ciudad Bolívar</span></li>
              <li class="fdr-zone-local"><span>Soacha</span></li>
            </ul>
          </div>

          <div class="fdr-rates-zone-card fdr-rates-zone-card--centro-o" data-zone="centro-o" data-keywords="fontibon engativa puente aranda teusaquillo">
            <div class="fdr-zone-header">
              <span class="fdr-zone-header__dot" aria-hidden="true"></span>
              <h3 class="fdr-zone-header__title">Centro-Occidente</h3>
              <span class="fdr-zone-header__price" data-price="{{ z_centro_o }}"></span>
            </div>
            <p class="fdr-zone-note">🚚 De 1 a 2 días hábiles</p>
            <div class="fdr-zone-free">Gratis en pedidos desde <span data-price="{{ free_centro_o }}"></span></div>
            <ul class="fdr-zone-locals" role="list">
              <li class="fdr-zone-local"><span>Fontibón</span></li>
              <li class="fdr-zone-local"><span>Engativá</span></li>
              <li class="fdr-zone-local"><span>Puente Aranda</span></li>
              <li class="fdr-zone-local"><span>Teusaquillo</span></li>
            </ul>
          </div>

          <div class="fdr-rates-zone-card fdr-rates-zone-card--centro-e" data-zone="centro-e" data-keywords="candelaria santa fe martires">
            <div class="fdr-zone-header">
              <span class="fdr-zone-header__dot" aria-hidden="true"></span>
              <h3 class="fdr-zone-header__title">Centro-Oriente</h3>
              <span class="fdr-zone-header__price" data-price="{{ z_centro_e }}"></span>
            </div>
            <p class="fdr-zone-note">🚚 De 1 a 2 días hábiles</p>
            <div class="fdr-zone-free">Gratis en pedidos desde <span data-price="{{ free_centro_e }}"></span></div>
            <ul class="fdr-zone-locals" role="list">
              <li class="fdr-zone-local"><span>La Candelaria</span></li>
              <li class="fdr-zone-local"><span>Santa Fe</span></li>
              <li class="fdr-zone-local"><span>Los Mártires</span></li>
            </ul>
          </div>

          <div class="fdr-rates-zone-card fdr-rates-zone-card--sur-e" data-zone="sur-e" data-keywords="rafael uribe uribe san cristobal usme antonio narino">
            <div class="fdr-zone-header">
              <span class="fdr-zone-header__dot" aria-hidden="true"></span>
              <h3 class="fdr-zone-header__title">Sur-Oriente</h3>
              <span class="fdr-zone-header__price" data-price="{{ z_sur_e }}"></span>
            </div>
            <p class="fdr-zone-note">🚚 De 1 a 2 días hábiles</p>
            <div class="fdr-zone-free">Gratis en pedidos desde <span data-price="{{ free_sur_e }}"></span></div>
            <ul class="fdr-zone-locals" role="list">
              <li class="fdr-zone-local"><span>Rafael Uribe Uribe</span></li>
              <li class="fdr-zone-local"><span>San Cristóbal</span></li>
              <li class="fdr-zone-local"><span>Usme</span></li>
              <li class="fdr-zone-local"><span>Antonio Nariño</span></li>
            </ul>
          </div>

          <div class="fdr-rates-zone-card fdr-rates-zone-card--norte" data-zone="norte" data-keywords="suba usaquen chapinero">
            <div class="fdr-zone-header">
              <span class="fdr-zone-header__dot" aria-hidden="true"></span>
              <h3 class="fdr-zone-header__title">Norte</h3>
              <span class="fdr-zone-header__price" data-price="{{ z_norte }}"></span>
            </div>
            <p class="fdr-zone-note">🚚 De 1 a 2 días hábiles</p>
            <div class="fdr-zone-free">Gratis en pedidos desde <span data-price="{{ free_norte }}"></span></div>
            <ul class="fdr-zone-locals" role="list">
              <li class="fdr-zone-local"><span>Suba</span></li>
              <li class="fdr-zone-local"><span>Usaquén</span></li>
              <li class="fdr-zone-local"><span>Chapinero</span></li>
            </ul>
          </div>

        </div>

        <p class="fdr-rates-empty" id="fdr-rates-empty" hidden>No encontramos esa localidad. Revisa el nombre o consulta el mapa.</p>

        {%- if section.settings.map_free_note != blank -%}
          <p class="fdr-rates-note">{{ section.settings.map_free_note }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
{%- endif -%}

<!-- ===== B. COUNTDOWN DE URGENCIA ===== -->
{%- if section.settings.show_countdown -%}
<div class="frutos-countdown-bar frc-countdown--sticky" id="frutos-countdown-bar" style="background:{{ section.settings.countdown_bg }}; color:{{ section.settings.countdown_text_color }}; padding:{{ section.settings.countdown_padding }}px 20px;">
  <span class="countdown-label" id="frc-countdown-label">{{ section.settings.countdown_label }}</span>
  <div class="countdown-timer" id="frutos-countdown-timer">
    <div class="countdown-unit"><span id="cd-days">00</span><small>d</small></div>
    <span class="countdown-sep">:</span>
    <div class="countdown-unit"><span id="cd-hours">00</span><small>h</small></div>
    <span class="countdown-sep">:</span>
    <div class="countdown-unit"><span id="cd-minutes">00</span><small>m</small></div>
    <span class="countdown-sep">:</span>
    <div class="countdown-unit"><span id="cd-seconds">00</span><small>s</small></div>
  </div>
  <span class="countdown-suffix" id="frc-countdown-suffix">{{ section.settings.countdown_suffix }}</span>
  {%- if section.settings.countdown_cta_text != blank -%}
    <a href="{{ section.settings.countdown_cta_link | default: '/collections/all' }}" class="countdown-cta" style="background:{{ section.settings.countdown_cta_bg }}; color:{{ section.settings.countdown_cta_text_color }};">
      {{ section.settings.countdown_cta_text }}
    </a>
  {%- endif -%}
</div>
{%- endif -%}

<!-- ===== E. BARRA DE PROGRESO STICKY ===== -->
{%- if section.settings.show_progress_bar -%}
<div class="frc-progress-bar" id="frc-progress-bar">
  <div class="frc-progress-inner">
    <div class="frc-progress-step frc-progress-step--active" data-step="1">
      <div class="frc-progress-bubble">{{ section.settings.progress_step1_icon }}</div>
      <span class="frc-progress-label">{{ section.settings.progress_step1_text }}</span>
    </div>
    <div class="frc-progress-line"><div class="frc-progress-fill" id="frc-progress-fill"></div></div>
    <div class="frc-progress-step" data-step="2">
      <div class="frc-progress-bubble">{{ section.settings.progress_step2_icon }}</div>
      <span class="frc-progress-label">{{ section.settings.progress_step2_text }}</span>
    </div>
    <div class="frc-progress-line"><div class="frc-progress-fill" id="frc-progress-fill-2"></div></div>
    <div class="frc-progress-step" data-step="3">
      <div class="frc-progress-bubble">{{ section.settings.progress_step3_icon }}</div>
      <span class="frc-progress-label">{{ section.settings.progress_step3_text }}</span>
    </div>
  </div>
</div>
{%- endif -%}

<!-- ===== F. WHATSAPP BURBUJA EXPANDIDA ===== -->
{%- if section.settings.show_whatsapp_bubble -%}
<div class="frc-wa-wrapper" id="frc-wa-wrapper">
  <div class="frc-wa-tooltip" id="frc-wa-tooltip">
    <span class="frc-wa-tooltip__dot"></span>
    <span class="frc-wa-tooltip__text">{{ section.settings.wa_preview_text }}</span>
    <div class="frc-wa-tooltip__arrow"></div>
  </div>
  <div class="frc-wa-card" id="frc-wa-card" style="display:none; background:{{ section.settings.wa_card_bg }};">
    <div class="frc-wa-card__header" style="background:{{ section.settings.wa_header_bg }};">
      <div class="frc-wa-card__avatar">
        {%- if section.settings.wa_avatar -%}
          <img src="{{ section.settings.wa_avatar | image_url: width: 80 }}" alt="{{ section.settings.wa_agent_name }}" width="42" height="42">
        {%- else -%}
          <span class="frc-wa-card__avatar-emoji">{{ section.settings.wa_avatar_emoji }}</span>
        {%- endif -%}
      </div>
      <div class="frc-wa-card__info">
        <div class="frc-wa-card__name" style="color:{{ section.settings.wa_header_text }};">{{ section.settings.wa_agent_name }}</div>
        <div class="frc-wa-card__status">
          <span class="frc-wa-card__dot"></span>
          {{ section.settings.wa_status_text }}
        </div>
      </div>
      <button class="frc-wa-card__close" id="frc-wa-card-close" aria-label="Cerrar chat">✕</button>
    </div>
    <div class="frc-wa-card__body">
      <div class="frc-wa-card__bubble" style="background:{{ section.settings.wa_bubble_bg }};">
        <p style="color:{{ section.settings.wa_bubble_text }};">{{ section.settings.wa_message }}</p>
        <span class="frc-wa-card__time">{{ section.settings.wa_time_label }}</span>
      </div>
    </div>
    <a href="https://wa.me/57{{ section.settings.wa_number }}?text={{ section.settings.wa_prefill | url_encode }}"
       target="_blank" rel="noopener"
       class="frc-wa-card__cta"
       style="background:{{ section.settings.wa_cta_bg }}; color:{{ section.settings.wa_cta_text }};">
      {{ section.settings.wa_cta_label }}
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="flex-shrink:0;"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/></svg>
    </a>
  </div>
  <button class="frc-wa-btn" id="frc-wa-btn" aria-label="{{ section.settings.wa_tooltip }}"
    style="background:{{ section.settings.wa_btn_bg }}; width:{{ section.settings.wa_btn_size }}px; height:{{ section.settings.wa_btn_size }}px;">
    <span class="frc-wa-pulse-ring"></span>
    <span class="frc-wa-pulse-ring" style="animation-delay:0.6s"></span>
    <svg viewBox="0 0 24 24" fill="currentColor" style="width:{{ section.settings.wa_btn_size | times: 0.46 | round }}px; height:{{ section.settings.wa_btn_size | times: 0.46 | round }}px; color:{{ section.settings.wa_btn_icon_color }};"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
    <span class="frc-wa-online-badge">
      <span class="frc-wa-online-dot"></span>
    </span>
    {%- if section.settings.wa_show_notification -%}
      <span class="frc-wa-notification">{{ section.settings.wa_notification_count }}</span>
    {%- endif -%}
  </button>
</div>
{%- endif -%}

<!-- ===== ESTILOS ===== -->
<style>
/* ============================================================
   A. NOTIFICACIONES SOCIALES
   ============================================================ */
.frc-social-toast {
  position: fixed;
  bottom: 24px;
  left: 24px;
  z-index: 9990;
  display: flex;
  align-items: flex-start;
  gap: 12px;
  background: #fff;
  border-radius: 14px;
  padding: 14px 18px;
  box-shadow: 0 8px 32px rgba(0,0,0,0.18);
  max-width: 360px;
  width: calc(100vw - 48px);
  font-family: 'Lato', sans-serif;
  transform: translateY(200px);
  opacity: 0;
  transition: transform 0.5s cubic-bezier(0.175,0.885,0.32,1.275), opacity 0.4s ease;
  pointer-events: auto;
}
.frc-social-toast.visible { transform: translateY(0); opacity: 1; }
.frc-social-toast__icon { font-size: 1.6rem; flex-shrink: 0; margin-top: 2px; }
.frc-social-toast__body { flex: 1; min-width: 0; }
.frc-social-toast__text { margin: 0 0 3px; font-size: 0.88rem; line-height: 1.4; color: #333; }
.frc-social-toast__time { font-size: 0.72rem; color: #999; }
.frc-social-toast__close { background: none; border: none; font-size: 0.9rem; color: #bbb; cursor: pointer; padding: 2px; line-height: 1; flex-shrink: 0; transition: color 0.2s; }
.frc-social-toast__close:hover { color: #666; }

/* ============================================================
   D. COMO FUNCIONA
   ============================================================ */
.hiw-inner { max-width: 1100px; margin: 0 auto; text-align: center; }
.hiw-eyebrow { display: inline-block; font-family: 'Montserrat', sans-serif; font-size: 0.75rem; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; margin-bottom: 10px; }
.hiw-title { font-family: 'Amatic SC', cursive; font-size: {{ section.settings.hiw_title_size }}rem; font-weight: 700; line-height: 1; margin: 0 0 10px; }
.hiw-subtitle { font-family: 'Lato', sans-serif; font-size: 1.05rem; margin-bottom: 50px; max-width: 540px; margin-left: auto; margin-right: auto; }
.hiw-steps { display: flex; align-items: flex-start; justify-content: center; gap: 8px; flex-wrap: wrap; margin-bottom: 40px; }
.hiw-step { flex: 1 1 180px; max-width: 220px; padding: 28px 20px; background: rgba(255,255,255,0.7); border-radius: 16px; text-align: center; transition: transform 0.3s, box-shadow 0.3s; }
.hiw-step:hover { transform: translateY(-6px); box-shadow: 0 12px 30px rgba(0,0,0,0.08); }
.hiw-step__num { width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-family: 'Montserrat', sans-serif; font-weight: 700; font-size: 0.9rem; margin: 0 auto 14px; }
.hiw-step__icon { font-size: {{ section.settings.hiw_icon_size }}rem; margin-bottom: 12px; line-height: 1; }
.hiw-step__title { font-family: 'Amatic SC', cursive; font-size: 2.2rem; font-weight: 700; line-height: 1; margin: 0 0 8px; }
.hiw-step__desc { font-family: 'Lato', sans-serif; font-size: 0.88rem; line-height: 1.6; margin: 0; }
.hiw-arrow { font-size: 2rem; align-self: center; opacity: 0.4; flex-shrink: 0; margin-top: -20px; }
.hiw-cta { text-align: center; }
.hiw-cta-btn { display: inline-flex; align-items: center; gap: 8px; padding: 14px 36px; border-radius: 50px; font-family: 'Montserrat', sans-serif; font-size: 1rem; font-weight: 700; text-decoration: none; transition: all 0.3s; box-shadow: 0 4px 16px rgba(0,0,0,0.15); }
.hiw-cta-btn:hover { transform: translateY(-3px); box-shadow: 0 10px 28px rgba(0,0,0,0.2); opacity: 0.9; }

/* ============================================================
   B. COUNTDOWN MEJORADO
   ============================================================ */
.frutos-countdown-bar { display: flex; align-items: center; justify-content: center; gap: 14px; flex-wrap: wrap; font-family: 'Montserrat', sans-serif; font-size: 0.9rem; font-weight: 600; text-align: center; transition: opacity 0.4s; }
.frutos-countdown-bar.frc-countdown--ended { opacity: 0.7; }
.countdown-label { font-size: 0.88rem; }
.countdown-timer { display: flex; align-items: center; gap: 4px; }
.countdown-unit { display: flex; align-items: baseline; gap: 1px; font-size: 1.3rem; font-weight: 700; background: rgba(0,0,0,0.15); padding: 4px 10px; border-radius: 8px; min-width: 52px; justify-content: center; }
.countdown-unit small { font-size: 0.6rem; font-weight: 600; opacity: 0.8; }
.countdown-sep { font-size: 1.3rem; font-weight: 700; margin: 0 2px; }
.countdown-cta { display: inline-block; padding: 8px 20px; border-radius: 30px; font-family: 'Montserrat', sans-serif; font-size: 0.85rem; font-weight: 700; text-decoration: none; transition: all 0.25s; white-space: nowrap; }
.countdown-cta:hover { opacity: 0.9; transform: translateY(-2px); }

/* ============================================================
   C. EXIT INTENT POP-UP MEJORADO
   ============================================================ */
.frc-exit-backdrop { position: fixed; inset: 0; background: rgba(0,0,0,0.55); backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px); z-index: 9998; display: none; animation: frcFadeIn 0.35s ease both; }
.frc-exit-backdrop.visible { display: block; }
.frc-exit-gift-ring { position: fixed; top: 50%; left: 50%; width: 60px; height: 60px; border: 2px solid rgba(255,255,255,0.3); border-radius: 50%; transform: translate(-50%,-50%) scale(0); z-index: 9997; pointer-events: none; }
.frc-exit-backdrop.visible .frc-exit-gift-ring { animation: frcRingExpand 0.8s cubic-bezier(0.175,0.885,0.32,1.275) 0.2s both; }
@keyframes frcRingExpand { 0%{transform:translate(-50%,-50%) scale(0);opacity:1;} 100%{transform:translate(-50%,-50%) scale(8);opacity:0;} }
.frc-exit-popup { position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%) scale(0.88); z-index: 9999; border-radius: 20px; padding: 40px 36px 32px; max-width: 480px; width: 92%; box-shadow: 0 24px 60px rgba(0,0,0,0.3); display: none; opacity: 0; }
.frc-exit-popup.visible { display: block; animation: frcPopIn 0.5s cubic-bezier(0.175,0.885,0.32,1.275) 0.1s both; }
@keyframes frcPopIn { from{opacity:0;transform:translate(-50%,-55%) scale(0.82);} to{opacity:1;transform:translate(-50%,-50%) scale(1);} }
@keyframes frcFadeIn { from{opacity:0;} to{opacity:1;} }
.frc-exit-close { position: absolute; top: 14px; right: 16px; background: none; border: none; font-size: 1.2rem; cursor: pointer; color: #aaa; line-height: 1; padding: 4px; transition: color 0.2s, transform 0.2s; }
.frc-exit-close:hover { color: #333; transform: rotate(90deg); }
.frc-exit-gift-shake { display: inline-block; animation: frcGiftShake 0.8s ease 0.6s both; }
@keyframes frcGiftShake { 0%,100%{transform:rotate(0deg);} 10%{transform:rotate(-12deg);} 20%{transform:rotate(12deg);} 30%{transform:rotate(-8deg);} 40%{transform:rotate(8deg);} 50%{transform:rotate(-4deg);} 60%{transform:rotate(4deg);} 70%{transform:rotate(-2deg);} 80%{transform:rotate(2deg);} }
.frc-exit-emoji { font-size: 3.5rem; margin-bottom: 10px; line-height: 1; }
.frc-exit-title { font-family: 'Amatic SC', cursive; font-size: {{ section.settings.popup_title_size }}rem; font-weight: 700; line-height: 1; margin: 0 0 10px; }
.frc-exit-subtitle { font-family: 'Lato', sans-serif; font-size: 1rem; line-height: 1.6; margin-bottom: 22px; }
.frc-exit-coupon { display: inline-flex; align-items: center; gap: 10px; border: 2px dashed; border-radius: 12px; padding: 12px 18px; margin-bottom: 20px; font-family: 'Montserrat', sans-serif; flex-wrap: wrap; justify-content: center; background: rgba(27,94,32,0.04); transition: transform 0.2s; }
.frc-exit-coupon:hover { transform: scale(1.03); }
.frc-coupon-label { font-size: 0.8rem; font-weight: 600; opacity: 0.7; }
.frc-coupon-code { font-size: 1.4rem; font-weight: 700; letter-spacing: 3px; }
.frc-coupon-copy { border: none; border-radius: 8px; padding: 6px 14px; font-family: 'Montserrat', sans-serif; font-size: 0.78rem; font-weight: 700; cursor: pointer; transition: opacity 0.2s, transform 0.2s; }
.frc-coupon-copy:hover { opacity: 0.85; transform: translateY(-1px); }
.frc-coupon-copy.copied { background: #4CAF50 !important; }
.frc-exit-form { display: flex; flex-direction: column; gap: 10px; margin-bottom: 12px; }
.frc-exit-email { padding: 13px 18px; border: 2px solid; border-radius: 10px; font-family: 'Lato', sans-serif; font-size: 1rem; outline: none; transition: box-shadow 0.2s, border-color 0.2s; }
.frc-exit-email:focus { box-shadow: 0 0 0 3px rgba(27,94,32,0.15); }
.frc-exit-submit { padding: 14px; border: none; border-radius: 10px; font-family: 'Montserrat', sans-serif; font-size: 1rem; font-weight: 700; cursor: pointer; transition: opacity 0.25s, transform 0.25s, box-shadow 0.25s; box-shadow: 0 4px 14px rgba(27,94,32,0.25); }
.frc-exit-submit:hover { opacity: 0.88; transform: translateY(-2px); box-shadow: 0 8px 24px rgba(27,94,32,0.3); }
.frc-exit-disclaimer { font-family: 'Lato', sans-serif; font-size: 0.75rem; opacity: 0.5; margin-bottom: 18px; }
.frc-exit-trust { display: flex; align-items: center; justify-content: center; gap: 16px; padding-top: 16px; border-top: 1px solid rgba(0,0,0,0.08); flex-wrap: wrap; }
.frc-trust-item { display: flex; align-items: center; gap: 5px; font-family: 'Lato', sans-serif; font-size: 0.78rem; color: #666; }
.frc-trust-icon { font-size: 1rem; }
.frc-trust-text { white-space: nowrap; }

/* ============================================================
   E. BARRA DE PROGRESO STICKY
   ============================================================ */
.frc-progress-bar { position: fixed; bottom: 0; left: 0; right: 0; z-index: 9980; background: #fff; box-shadow: 0 -4px 20px rgba(0,0,0,0.1); padding: 12px 20px; font-family: 'Montserrat', sans-serif; transform: translateY(100%); transition: transform 0.4s cubic-bezier(0.175,0.885,0.32,1.275); }
.frc-progress-bar.visible { transform: translateY(0); }
.frc-progress-inner { max-width: 600px; margin: 0 auto; display: flex; align-items: center; justify-content: center; gap: 0; }
.frc-progress-step { display: flex; flex-direction: column; align-items: center; gap: 6px; flex-shrink: 0; }
.frc-progress-bubble { width: 36px; height: 36px; border-radius: 50%; background: #e0e0e0; display: flex; align-items: center; justify-content: center; font-size: 1rem; transition: background 0.4s, transform 0.3s; }
.frc-progress-step--active .frc-progress-bubble { background: #1B5E20; transform: scale(1.1); box-shadow: 0 2px 10px rgba(27,94,32,0.3); }
.frc-progress-step--done .frc-progress-bubble { background: #4CAF50; }
.frc-progress-label { font-size: 0.68rem; font-weight: 600; color: #999; text-align: center; white-space: nowrap; transition: color 0.3s; }
.frc-progress-step--active .frc-progress-label { color: #1B5E20; font-weight: 700; }
.frc-progress-step--done .frc-progress-label { color: #4CAF50; }
.frc-progress-line { flex: 1; height: 3px; background: #e0e0e0; border-radius: 2px; margin: 0 6px; position: relative; overflow: hidden; margin-bottom: 18px; min-width: 30px; }
.frc-progress-fill { position: absolute; top: 0; left: 0; height: 100%; width: 0%; background: linear-gradient(90deg, #1B5E20, #4CAF50); border-radius: 2px; transition: width 0.6s ease; }

/* ============================================================
   F. WHATSAPP BURBUJA MEJORADA
   ============================================================ */
.frc-wa-wrapper { position: fixed; z-index: 3000; }
.frc-wa-btn { position: fixed; bottom: {{ section.settings.wa_btn_bottom }}px; right: {{ section.settings.wa_btn_right }}px; border: none; border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 18px rgba(0,0,0,0.25); transition: transform 0.3s, box-shadow 0.3s; z-index: 3001; }
.frc-wa-btn:hover { transform: scale(1.12); box-shadow: 0 8px 30px rgba(0,0,0,0.35); }
.frc-wa-pulse-ring { position: absolute; inset: -4px; border: 2px solid rgba(37,211,102,0.5); border-radius: 50%; animation: frcWaPulse 2.5s ease-out infinite; pointer-events: none; }
@keyframes frcWaPulse { 0%{transform:scale(1);opacity:0.6;} 100%{transform:scale(1.6);opacity:0;} }
.frc-wa-online-badge { position: absolute; bottom: -2px; left: -2px; background: #fff; border-radius: 10px; padding: 2px 5px; display: flex; align-items: center; gap: 3px; box-shadow: 0 1px 4px rgba(0,0,0,0.15); pointer-events: none; }
.frc-wa-online-dot { width: 7px; height: 7px; background: #4CAF50; border-radius: 50%; animation: frcOnlineBlink 2s infinite; }
@keyframes frcOnlineBlink { 0%,100%{opacity:1;} 50%{opacity:0.35;} }
.frc-wa-notification { position: absolute; top: -3px; right: -3px; background: #FF5722; color: #fff; font-family: 'Montserrat', sans-serif; font-weight: 700; font-size: 0.6rem; min-width: 18px; height: 18px; border-radius: 50%; display: flex; align-items: center; justify-content: center; border: 2px solid #fff; animation: frcWaNotifyBounce 2s infinite; }
@keyframes frcWaNotifyBounce { 0%,100%{transform:scale(1);} 50%{transform:scale(1.15);} }
.frc-wa-tooltip { position: fixed; bottom: {{ section.settings.wa_btn_bottom | plus: section.settings.wa_btn_size | plus: 10 }}px; right: {{ section.settings.wa_btn_right }}px; background: #fff; border-radius: 12px; padding: 10px 14px; box-shadow: 0 4px 16px rgba(0,0,0,0.12); display: flex; align-items: center; gap: 8px; font-family: 'Lato', sans-serif; font-size: 0.82rem; color: #333; white-space: nowrap; opacity: 0; transform: translateY(8px) scale(0.95); transition: opacity 0.3s, transform 0.3s; pointer-events: none; z-index: 2999; }
.frc-wa-wrapper:hover .frc-wa-tooltip { opacity: 1; transform: translateY(0) scale(1); }
.frc-wa-tooltip__dot { width: 7px; height: 7px; background: #4CAF50; border-radius: 50%; animation: frcOnlineBlink 2s infinite; flex-shrink: 0; }
.frc-wa-tooltip__text { margin: 0; }
.frc-wa-tooltip__arrow { position: absolute; bottom: -6px; right: 20px; width: 12px; height: 12px; background: #fff; transform: rotate(45deg); box-shadow: 2px 2px 4px rgba(0,0,0,0.06); }
.frc-wa-card { position: fixed; bottom: {{ section.settings.wa_btn_bottom | plus: section.settings.wa_btn_size | plus: 16 }}px; right: {{ section.settings.wa_btn_right }}px; width: 300px; border-radius: 16px; overflow: hidden; box-shadow: 0 12px 40px rgba(0,0,0,0.2); animation: frcWaCardIn 0.35s cubic-bezier(0.175,0.885,0.32,1.275) both; z-index: 3000; }
@keyframes frcWaCardIn { from{opacity:0;transform:translateY(20px) scale(0.95);} to{opacity:1;transform:translateY(0) scale(1);} }
.frc-wa-card__header { display: flex; align-items: center; gap: 12px; padding: 14px 16px; }
.frc-wa-card__avatar { width: 42px; height: 42px; border-radius: 50%; overflow: hidden; background: rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.frc-wa-card__avatar img { width: 100%; height: 100%; object-fit: cover; }
.frc-wa-card__avatar-emoji { font-size: 1.5rem; line-height: 1; }
.frc-wa-card__info { flex: 1; }
.frc-wa-card__name { font-family: 'Montserrat', sans-serif; font-size: 0.9rem; font-weight: 700; line-height: 1; }
.frc-wa-card__status { display: flex; align-items: center; gap: 5px; font-family: 'Lato', sans-serif; font-size: 0.75rem; opacity: 0.85; margin-top: 3px; }
.frc-wa-card__dot { width: 8px; height: 8px; background: #76ff03; border-radius: 50%; animation: frcBlinkDot 1.5s infinite; flex-shrink: 0; }
@keyframes frcBlinkDot { 0%,100%{opacity:1;} 50%{opacity:0.3;} }
.frc-wa-card__close { background: none; border: none; cursor: pointer; font-size: 1rem; color: rgba(255,255,255,0.7); padding: 4px; line-height: 1; transition: color 0.2s; }
.frc-wa-card__close:hover { color: #fff; }
.frc-wa-card__body { padding: 16px; }
.frc-wa-card__bubble { padding: 12px 14px; border-radius: 0 12px 12px 12px; max-width: 85%; position: relative; }
.frc-wa-card__bubble p { font-family: 'Lato', sans-serif; font-size: 0.9rem; line-height: 1.5; margin: 0 0 4px; }
.frc-wa-card__time { font-family: 'Lato', sans-serif; font-size: 0.7rem; opacity: 0.55; }
.frc-wa-card__cta { display: flex; align-items: center; justify-content: center; gap: 8px; padding: 13px; font-family: 'Montserrat', sans-serif; font-size: 0.88rem; font-weight: 700; text-decoration: none; transition: opacity 0.2s; }
.frc-wa-card__cta:hover { opacity: 0.88; }

/* ============================================================
   G. FADE-UP ANIMATIONS
   ============================================================ */
.frc-fade-up { opacity: 0; transform: translateY(28px); transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.175,0.885,0.32,1.275); }
.frc-fade-up.frc-visible { opacity: 1; transform: translateY(0); }
.frc-fade-up:nth-child(1){transition-delay:0.05s;}
.frc-fade-up:nth-child(2){transition-delay:0.12s;}
.frc-fade-up:nth-child(3){transition-delay:0.19s;}
.frc-fade-up:nth-child(4){transition-delay:0.26s;}
.frc-fade-up:nth-child(5){transition-delay:0.33s;}

/* ============================================================
   H. MAPA + TARIFAS POR ZONAS (v3.2)
   ============================================================ */
.fdr-rates-section {
  --z-bosa:     #2E7D32;
  --z-bosa-bg:  #E8F5E9;
  --z-sur-occ:  #1565C0;
  --z-sur-occ-bg: #E3F2FD;
  --z-centro-o: #7B1FA2;
  --z-centro-o-bg: #F3E5F5;
  --z-centro-e: #F4B41A;
  --z-centro-e-bg: #FFF8E1;
  --z-sur-e:    #EF6C00;
  --z-sur-e-bg: #FFF3E0;
  --z-norte:    #C62828;
  --z-norte-bg: #FFEBEE;
}
.fdr-rates-inner { max-width: 1180px; margin: 0 auto; }
.fdr-rates-header { text-align: center; margin-bottom: 36px; }
.fdr-rates-eyebrow { display: inline-block; font-family: 'Montserrat', sans-serif; font-size: 0.75rem; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; margin-bottom: 8px; }
.fdr-rates-title { font-family: 'Amatic SC', cursive; font-size: clamp(2.8rem, 6vw, 4.2rem); font-weight: 700; line-height: 1; margin: 0 0 10px; }
.fdr-rates-subtitle { font-family: 'Lato', sans-serif; font-size: 1.02rem; color: #666; max-width: 560px; margin: 0 auto; line-height: 1.6; }
.fdr-rates-layout { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 28px; align-items: start; }
.fdr-rates-map { position: relative; margin: 0; background: #f1f8e9; border-radius: 18px; padding: 14px; border: 1px solid rgba(21, 101, 41, 0.14); box-shadow: 0 8px 32px rgba(21, 101, 41, 0.1); }
.fdr-rates-map__img { width: 100%; height: auto; display: block; border-radius: 12px; padding-top: 120px; padding-bottom: 120px; }
.fdr-rates-map__badge { position: absolute; top: 24px; left: 24px; background: #156529; color: #fff; font-family: 'Montserrat', sans-serif; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.5px; text-transform: uppercase; padding: 7px 14px; border-radius: 20px; box-shadow: 0 4px 14px rgba(0,0,0,0.2); margin: 0; }
.fdr-rates-info { display: flex; flex-direction: column; gap: 16px; min-height: 0; }
.fdr-rates-toolbar { background: #fff; border-radius: 16px; padding: 18px; border: 1px solid rgba(21, 101, 41, 0.12); box-shadow: 0 4px 18px rgba(21, 101, 41, 0.06); }
.fdr-rates-search__label { display: block; font-family: 'Montserrat', sans-serif; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: #156529; margin-bottom: 8px; }
.fdr-rates-search__input { width: 100%; min-height: 48px; padding: 12px 16px; border: 1.5px solid rgba(21, 101, 41, 0.2); border-radius: 12px; font-family: 'Lato', sans-serif; font-size: 1rem; color: #333; background: #fafafa; transition: border-color 0.2s, box-shadow 0.2s; }
.fdr-rates-search__input:focus { outline: none; border-color: #156529; box-shadow: 0 0 0 3px rgba(21, 101, 41, 0.12); background: #fff; }
.fdr-rates-filters { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
.fdr-rates-filter { display: inline-flex; align-items: center; gap: 6px; min-height: 36px; padding: 6px 12px; border: 1.5px solid rgba(0,0,0,0.12); border-radius: 20px; background: #fff; font-family: 'Montserrat', sans-serif; font-size: 0.75rem; font-weight: 600; color: #444; cursor: pointer; transition: all 0.2s ease; touch-action: manipulation; -webkit-tap-highlight-color: transparent; }
.fdr-rates-filter__swatch { width: 12px; height: 12px; border-radius: 50%; flex-shrink: 0; border: 1px solid rgba(0,0,0,0.08); }
.fdr-rates-filter--bosa .fdr-rates-filter__swatch { background: var(--z-bosa); }
.fdr-rates-filter--sur-occ .fdr-rates-filter__swatch { background: var(--z-sur-occ); }
.fdr-rates-filter--centro-o .fdr-rates-filter__swatch { background: var(--z-centro-o); }
.fdr-rates-filter--centro-e .fdr-rates-filter__swatch { background: var(--z-centro-e); }
.fdr-rates-filter--sur-e .fdr-rates-filter__swatch { background: var(--z-sur-e); }
.fdr-rates-filter--norte .fdr-rates-filter__swatch { background: var(--z-norte); }
.fdr-rates-filter.is-active { transform: translateY(-1px); box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
.fdr-rates-filter--bosa.is-active { background: var(--z-bosa-bg); border-color: var(--z-bosa); color: var(--z-bosa); }
.fdr-rates-filter--sur-occ.is-active { background: var(--z-sur-occ-bg); border-color: var(--z-sur-occ); color: var(--z-sur-occ); }
.fdr-rates-filter--centro-o.is-active { background: var(--z-centro-o-bg); border-color: var(--z-centro-o); color: var(--z-centro-o); }
.fdr-rates-filter--centro-e.is-active { background: var(--z-centro-e-bg); border-color: var(--z-centro-e); color: #B8860B; }
