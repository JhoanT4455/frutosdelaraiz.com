{%- comment -%} ══════════════════════════════════════════════
   5. BANNER DE COLECCIÓN
══════════════════════════════════════════════ {%- endcomment -%}
{%- if show_banner -%}
<div class="fh-col-banner">
  {%- if collection.image -%}
    <img class="fh-col-banner__img"
      src="{{ collection.image | image_url: width: 1600 }}"
      alt="{{ collection.image.alt | escape | default: collection.title }}"
      loading="eager" fetchpriority="high"
      width="{{ collection.image.width }}" height="{{ collection.image.height }}">
  {%- elsif section.settings.fallback_image -%}
    <img class="fh-col-banner__img"
      src="{{ section.settings.fallback_image | image_url: width: 1600 }}"
      alt="{{ collection.title | escape }}"
      loading="eager" fetchpriority="high">
  {%- endif -%}
  <div class="fh-col-banner__pattern" aria-hidden="true"></div>
  <div class="fh-col-banner__overlay" aria-hidden="true"></div>
  <div class="fh-col-banner__content">
    <div>
      <p class="fh-col-banner__eyebrow" aria-hidden="true">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M17 8C8 10 5.9 16.17 3.82 19.29c-.47.64.32 1.3.91.85C6 19 6.5 19 7 20h10c0-2.67 1-5 3-6.9V10c0-1.1-.9-2-2-2z"/></svg>
        {{ section.settings.eyebrow_text | default: 'Alimentación Consciente · 100% Natural' }}
      </p>
      <h1 class="fh-col-banner__title">
        {%- if collection.handle == 'all' -%}
          {{ section.settings.all_title | default: 'Todos los Productos' }}
        {%- else -%}
          {{ collection.title }}
        {%- endif -%}
      </h1>
      {%- if show_desc -%}
        {%- assign col_desc = collection.description | strip_html | truncate: 160 -%}
        {%- if col_desc != blank -%}
          <p class="fh-col-banner__desc">{{ col_desc }}</p>
        {%- elsif collection.handle == 'all' -%}
          <p class="fh-col-banner__desc">{{ section.settings.all_desc | default: 'Productos naturales, orgánicos y artesanales. Sin aditivos, sin conservantes.' }}</p>
        {%- endif -%}
      {%- endif -%}
    </div>
    {%- if show_count -%}
    <div class="fh-col-banner__right">
      <div class="fh-col-banner__pill">
        <span class="fh-col-banner__pill-num">{{ collection.products_count }}</span>
        <span class="fh-col-banner__pill-lbl">{{ collection.products_count | pluralize: 'Producto', 'Productos' }}</span>
      </div>
    </div>
    {%- endif -%}
  </div>
</div>
{%- endif -%}

{%- comment -%} ── Breadcrumb ── {%- endcomment -%}
{%- if show_breadcrumb -%}
<nav class="fh-breadcrumb" aria-label="Ruta de navegación">
  <div class="fh-breadcrumb__inner">
    <ol class="fh-breadcrumb__list">
      <li class="fh-breadcrumb__item">
        <a href="{{ routes.root_url }}">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          Inicio
        </a>
      </li>
      <li class="fh-breadcrumb__item"><span class="fh-breadcrumb__sep">›</span></li>
      <li class="fh-breadcrumb__item"><a href="{{ routes.all_products_collection_url }}">Tienda</a></li>
      {%- unless collection.handle == 'all' -%}
        <li class="fh-breadcrumb__item"><span class="fh-breadcrumb__sep">›</span></li>
        <li class="fh-breadcrumb__item"><span class="fh-breadcrumb__current">{{ collection.title }}</span></li>
      {%- endunless -%}
    </ol>
  </div>
</nav>
{%- endif -%}

{%- comment -%} ── Stats bar ── {%- endcomment -%}
{%- if show_stats -%}
<div class="fh-stats" aria-hidden="true">
  <div class="fh-stats__inner">
    <div class="fh-stat">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      100% Natural · Sin Aditivos
    </div>
    <div class="fh-stat">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
      Envío gratis +$120k Bogotá
    </div>
    <div class="fh-stat">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
      +500 Clientes Satisfechos
    </div>
    <div class="fh-stat">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
      4.9 ⭐ en Google Reviews
    </div>
  </div>
</div>
{%- endif -%}

{%- comment -%} ── Quick filters ── {%- endcomment -%}
{%- if show_qfilters -%}
<nav class="fh-qfilters" aria-label="Filtrar por categoría">
  <div class="fh-qfilters__inner">
    <a href="{{ routes.all_products_collection_url }}"
       class="fh-qfilter{% if collection.handle == 'all' %} active{% endif %}">
      <span class="qi">🌿</span> Todos
    </a>
    {%- assign qcat_h = 'panaderia,frutos-secos,bebidas,especias,harinas-cereales-granos,toppings,aceites,aromaticas' | split: ',' -%}
    {%- assign qcat_n = 'Panadería,Frutos Secos,Bebidas,Especias,Harinas & Cereales,Toppings,Aceites,Aromáticas' | split: ',' -%}
    {%- assign qcat_i = '🍞,🥜,🧃,🌶️,🌾,✨,🫙,🍵' | split: ',' -%}
    {%- assign featured_handle = section.settings.featured_filter_handle | default: 'frutos-secos' -%}
    {%- for ch in qcat_h -%}
      <span class="fh-qfilter__sep" aria-hidden="true"></span>
      <a href="/collections/{{ ch }}"
         class="fh-qfilter{% if collection.handle == ch %} active{% endif %}"
         {% if collection.handle == ch %}aria-current="page"{% endif %}>
        <span class="qi">{{ qcat_i[forloop.index0] }}</span>
        {{ qcat_n[forloop.index0] }}
        {%- if ch == featured_handle -%}
          <span class="fh-qfilter__badge">Popular</span>
        {%- endif -%}
      </a>
    {%- endfor -%}
  </div>
</nav>
{%- endif -%}

{% javascript %}
(function() {
  /* ── Cart count on load ── */
  fetch('/cart.js').then(function(r){ return r.json(); }).then(function(c){
    document.querySelectorAll('[data-cart-count]').forEach(function(el){
      el.textContent = c.item_count;
    });
  });

  /* ── Mobile menu ── */
  var openBtn  = document.getElementById('FhMobOpen');
  var closeBtn = document.getElementById('FhMobClose');
  var backdrop = document.getElementById('FhMobBack');
  var menu     = document.getElementById('FhMobMenu');

  function openMenu()  { menu.classList.add('open'); document.body.style.overflow = 'hidden'; openBtn.setAttribute('aria-expanded','true'); }
  function closeMenu() { menu.classList.remove('open'); document.body.style.overflow = ''; openBtn.setAttribute('aria-expanded','false'); }

  if (openBtn)  openBtn.addEventListener('click', openMenu);
  if (closeBtn) closeBtn.addEventListener('click', closeMenu);
  if (backdrop) backdrop.addEventListener('click', closeMenu);

  /* Close on ESC */
  document.addEventListener('keydown', function(e){ if(e.key === 'Escape') closeMenu(); });
})();
{% endjavascript %}

