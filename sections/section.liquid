{%- comment -%} ══════════════════════════════════════════════
   3. MAIN HEADER
══════════════════════════════════════════════ {%- endcomment -%}
<header class="fh-header" role="banner" id="FrutosHeader">
  <div class="fh-header__inner">

    {%- comment -%} Hamburger mobile {%- endcomment -%}
    <button class="fh-hamburger" id="FhMobOpen" aria-label="Abrir menú" aria-expanded="false" aria-controls="FhMobMenu">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>

    {%- comment -%} Logo {%- endcomment -%}
    <a href="{{ routes.root_url }}" class="fh-logo" aria-label="Frutos de la Raíz — Inicio">
      {%- if section.settings.logo -%}
        <img
          src="{{ section.settings.logo | image_url: height: 92 }}"
          alt="{{ shop.name | escape }}"
          height="46"
          width="{{ section.settings.logo.width | times: 46 | divided_by: section.settings.logo.height }}"
          loading="eager"
        >
      {%- else -%}
        <div class="fh-logo__text">
          <span class="fh-logo__name">🌿 Frutos de la Raíz</span>
          <span class="fh-logo__tag">Alimentación Consciente</span>
        </div>
      {%- endif -%}
    </a>

    {%- comment -%} Nav desktop {%- endcomment -%}
    <nav class="fh-nav" aria-label="Navegación principal">

      <div class="fh-nav__item">
        <a href="{{ routes.root_url }}" class="fh-nav__link{% if request.page_type == 'index' %} active{% endif %}">Inicio</a>
      </div>

      {%- comment -%} Tienda con megadropdown {%- endcomment -%}
      <div class="fh-nav__item">
        <a href="{{ routes.all_products_collection_url }}"
           class="fh-nav__link{% if request.page_type == 'collection' %} active fh-nav__link--current{% endif %}"
           aria-haspopup="true" aria-expanded="false">
          Tienda
          <span class="fh-nav__chevron" aria-hidden="true">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </span>
        </a>
        <div class="fh-dropdown fh-dropdown--wide" role="menu">
          <span class="fh-dropdown__section-title">Explorar por categoría</span>
          <a href="/collections/panaderia"              class="fh-dropdown__link" role="menuitem"><span class="dd-icon">🍞</span> Panadería</a>
          <a href="/collections/frutos-secos"           class="fh-dropdown__link" role="menuitem"><span class="dd-icon">🥜</span> Frutos Secos</a>
          <a href="/collections/bebidas"                class="fh-dropdown__link" role="menuitem"><span class="dd-icon">🧃</span> Bebidas</a>
          <a href="/collections/especias"               class="fh-dropdown__link" role="menuitem"><span class="dd-icon">🌶️</span> Especias</a>
          <a href="/collections/harinas-cereales-granos" class="fh-dropdown__link" role="menuitem"><span class="dd-icon">🌾</span> Harinas & Cereales</a>
          <a href="/collections/toppings"               class="fh-dropdown__link" role="menuitem"><span class="dd-icon">✨</span> Toppings</a>
          <a href="/collections/aceites"                class="fh-dropdown__link" role="menuitem"><span class="dd-icon">🫙</span> Aceites</a>
          <a href="/collections/aromaticas"             class="fh-dropdown__link" role="menuitem"><span class="dd-icon">🍵</span> Aromáticas</a>
          <a href="{{ routes.all_products_collection_url }}" class="fh-dropdown__link fh-dropdown__link--all" role="menuitem">
            Ver todos los productos →
          </a>
        </div>
      </div>

      <div class="fh-nav__item">
        <a href="/pages/eventos" class="fh-nav__link">Eventos</a>
      </div>

      <div class="fh-nav__item">
        <a href="/blogs/recetas" class="fh-nav__link">Recetas</a>
      </div>

      <div class="fh-nav__item">
        <a href="/pages/nosotros" class="fh-nav__link">Nosotros</a>
      </div>

      <div class="fh-nav__item">
        <a href="/pages/contacto" class="fh-nav__link">Contacto</a>
      </div>

    </nav>

    {%- comment -%} Search {%- endcomment -%}
    <form action="{{ routes.search_url }}" method="get" class="fh-search-wrap" role="search">
      <input
        type="search"
        name="q"
        class="fh-search-inp"
        placeholder="¿Qué estás buscando?"
        aria-label="Buscar productos"
        autocomplete="off"
      >
      <button type="submit" class="fh-search-btn" aria-label="Buscar">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      </button>
    </form>

    {%- comment -%} Account + Cart {%- endcomment -%}
    <div class="fh-header__actions">
      <a href="{{ routes.account_url }}" class="fh-icon-btn" aria-label="Mi cuenta">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      </a>
      <a href="{{ routes.cart_url }}" class="fh-icon-btn" aria-label="Carrito" id="FhCartBtn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
        <span class="fh-cart-count" data-cart-count aria-label="Artículos en carrito">0</span>
      </a>
    </div>

  </div>
</header>

