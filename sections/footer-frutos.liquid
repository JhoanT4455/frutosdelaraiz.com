{{ 'https://fonts.googleapis.com/css2?family=Amatic+SC:wght@700&family=Lato:wght@300;400;700&family=Montserrat:wght@500;600;700&display=swap' | stylesheet_tag }}

<style>
  /* =============================================
     FOOTER FRUTOS DE LA RAÍZ - CRO v2
     ============================================= */

  /* --- NEWSLETTER --- */
  .footer-newsletter {
    background: linear-gradient(135deg, {{ section.settings.newsletter_bg_from }} 0%, {{ section.settings.newsletter_bg_to }} 100%);
    padding: {{ section.settings.newsletter_padding }}px 5%;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .footer-newsletter::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255,255,255,0.06) 1px, transparent 1px);
    background-size: 20px 20px;
    pointer-events: none;
  }

  .footer-newsletter-inner {
    position: relative;
    z-index: 1;
    max-width: 600px;
    margin: 0 auto;
  }

  .footer-newsletter-eyebrow {
    display: inline-block;
    background: rgba(255,255,255,0.15);
    border: 1px solid rgba(255,255,255,0.3);
    color: #ffffff;
    font-family: 'Montserrat', sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 5px 16px;
    border-radius: 20px;
    margin-bottom: 14px;
    display: inline-block;
  }

  .footer-newsletter h3 {
    font-family: 'Amatic SC', cursive;
    font-size: {{ section.settings.newsletter_title_size }}px;
    color: {{ section.settings.newsletter_title_color }};
    font-weight: 700;
    margin: 0 0 10px;
    line-height: 1;
  }

  .footer-newsletter p {
    font-family: 'Lato', sans-serif;
    color: rgba(255,255,255,0.88);
    font-size: {{ section.settings.newsletter_subtitle_size }}px;
    margin-bottom: 24px;
    line-height: 1.5;
  }

  .newsletter-form {
    display: flex;
    gap: 10px;
    justify-content: center;
    flex-wrap: wrap;
    max-width: 520px;
    margin: 0 auto 12px;
  }

  .newsletter-input {
    flex: 1 1 260px;
    padding: {{ section.settings.newsletter_input_padding }}px 20px;
    border: 2px solid transparent;
    border-radius: 40px;
    font-family: 'Lato', sans-serif;
    font-size: 16px;
    outline: none;
    color: #333;
    transition: border-color 0.3s;
  }

  .newsletter-input:focus {
    border-color: {{ section.settings.newsletter_btn_bg }};
  }

  .newsletter-btn {
    background: {{ section.settings.newsletter_btn_bg }};
    color: {{ section.settings.newsletter_btn_text }};
    border: none;
    padding: {{ section.settings.newsletter_input_padding }}px 28px;
    border-radius: 40px;
    font-family: 'Montserrat', sans-serif;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s ease;
    white-space: nowrap;
  }

  .newsletter-btn:hover {
    background: {{ section.settings.newsletter_btn_hover_bg }};
    color: {{ section.settings.newsletter_btn_hover_text }};
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(0,0,0,0.2);
  }

  .newsletter-disclaimer {
    font-family: 'Lato', sans-serif;
    font-size: 12px;
    color: rgba(255,255,255,0.5);
    margin-top: 4px;
  }

  /* --- FOOTER PRINCIPAL --- */
  .footer-main {
    background-color: {{ section.settings.footer_bg }};
    color: {{ section.settings.footer_text }};
    padding: {{ section.settings.footer_padding_top }}px 5% 0;
    font-family: 'Lato', sans-serif;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr repeat({{ section.settings.extra_cols }}, 1fr);
    gap: 44px;
    max-width: {{ section.settings.footer_max_width }}px;
    margin: 0 auto {{ section.settings.footer_padding_top | divided_by: 2 }}px;
  }

  /* Logo col */
  .footer-logo-text {
    font-family: 'Amatic SC', cursive;
    color: #ffffff;
    font-size: {{ section.settings.footer_logo_size }}px;
    display: block;
    line-height: 1;
    font-weight: 700;
    margin-bottom: 12px;
    letter-spacing: 1px;
  }

  .footer-tagline {
    font-family: 'Montserrat', sans-serif;
    font-size: 10px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
    margin-bottom: 14px;
    display: block;
  }

  .footer-col p {
    font-size: 14px;
    line-height: 1.7;
    color: {{ section.settings.footer_text_muted }};
    margin-bottom: 6px;
  }

  /* Columnas adicionales */
  .footer-col h4 {
    font-family: 'Amatic SC', cursive;
    color: {{ section.settings.accent_color }};
    font-size: {{ section.settings.footer_heading_size }}px;
    margin-bottom: 18px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    position: relative;
    padding-bottom: 10px;
  }

  .footer-col h4::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 32px;
    height: 2px;
    background: {{ section.settings.accent_color }};
    border-radius: 2px;
  }

  .footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-col li {
    margin-bottom: 10px;
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 14px;
    color: {{ section.settings.footer_text_muted }};
  }

  .footer-col li .footer-li-icon {
    flex-shrink: 0;
    margin-top: 2px;
    font-size: 16px;
    color: {{ section.settings.accent_color }};
  }

  .footer-col a {
    color: {{ section.settings.footer_link_color }};
    text-decoration: none;
    transition: color 0.25s;
  }

  .footer-col a:hover {
    color: {{ section.settings.accent_color }};
  }

  /* --- REDES SOCIALES --- */
  .footer-social-title {
    font-family: 'Montserrat', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: {{ section.settings.footer_text_muted }};
    margin-top: 20px;
    margin-bottom: 10px;
    display: block;
  }

  .footer-social-icons {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .footer-social-btn {
    width: {{ section.settings.social_icon_size }}px;
    height: {{ section.settings.social_icon_size }}px;
    background: {{ section.settings.social_bg }};
    border-radius: {{ section.settings.social_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: background 0.25s, transform 0.25s;
    color: {{ section.settings.social_icon_color }};
    flex-shrink: 0;
  }

  .footer-social-btn svg {
    width: {{ section.settings.social_icon_size | times: 0.48 | round }}px;
    height: {{ section.settings.social_icon_size | times: 0.48 | round }}px;
    fill: currentColor;
  }

  .footer-social-btn:hover {
    background: {{ section.settings.social_hover_bg }};
    color: {{ section.settings.social_hover_color }};
    transform: translateY(-3px);
  }

  .footer-social-btn--facebook:hover { background: #1877F2; color: #fff; }
  .footer-social-btn--instagram:hover { background: linear-gradient(45deg,#f09433,#e6683c,#dc2743,#cc2366,#bc1888); color: #fff; }
  .footer-social-btn--tiktok:hover { background: #000000; color: #ffffff; }
  .footer-social-btn--youtube:hover { background: #FF0000; color: #fff; }

  /* --- SEPARADOR Y COPYRIGHT --- */
  .footer-divider {
    max-width: {{ section.settings.footer_max_width }}px;
    margin: 0 auto;
    border: none;
    border-top: 1px solid rgba(255,255,255,0.08);
  }

  .footer-bottom {
    max-width: {{ section.settings.footer_max_width }}px;
    margin: 0 auto;
    padding: 18px 0 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 13px;
    color: {{ section.settings.footer_text_muted }};
  }

  .footer-bottom a {
    color: {{ section.settings.footer_text_muted }};
    text-decoration: none;
    margin: 0 6px;
    transition: color 0.25s;
  }

  .footer-bottom a:hover { color: {{ section.settings.accent_color }}; }

  .footer-bottom-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: rgba(255,255,255,0.07);
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 12px;
  }

  /* --- BOTÓN FLOTANTE CONFIGURABLE --- */
  .footer-float-btn {
    position: fixed;
    bottom: {{ section.settings.float_btn_bottom }}px;
    right: {{ section.settings.float_btn_right }}px;
    background: {{ section.settings.float_btn_bg }};
    color: {{ section.settings.float_btn_color }};
    width: {{ section.settings.float_btn_size }}px;
    height: {{ section.settings.float_btn_size }}px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 16px rgba(0,0,0,0.25);
    z-index: 3000;
    text-decoration: none;
    transition: transform 0.3s, box-shadow 0.3s;
  }

  .footer-float-btn svg {
    width: {{ section.settings.float_btn_size | times: 0.46 | round }}px;
    height: {{ section.settings.float_btn_size | times: 0.46 | round }}px;
    fill: currentColor;
  }

  .footer-float-btn:hover {
    transform: scale(1.12);
    box-shadow: 0 8px 28px rgba(0,0,0,0.3);
    color: {{ section.settings.float_btn_color }};
  }

  .footer-float-btn::before {
    content: '{{ section.settings.float_btn_tooltip }}';
    position: absolute;
    right: calc(100% + 10px);
    background: #222;
    color: #fff;
    padding: 5px 12px;
    border-radius: 20px;
    font-family: 'Lato', sans-serif;
    font-size: 12px;
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.3s;
    pointer-events: none;
  }

  .footer-float-btn:hover::before { opacity: 1; }

  /* --- RESPONSIVE --- */
  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .footer-col h4::after { left: 50%; transform: translateX(-50%); }
    .footer-col li { justify-content: center; }
    .footer-social-icons { justify-content: center; }
    .footer-newsletter h3 { font-size: {{ section.settings.newsletter_title_size | times: 0.72 | round }}px; }
    .footer-bottom { justify-content: center; text-align: center; }
  }
</style>

<!-- ===== NEWSLETTER ===== -->
{%- if section.settings.show_newsletter -%}
<div class="footer-newsletter">
  <div class="footer-newsletter-inner">
    {%- if section.settings.newsletter_eyebrow != blank -%}
      <span class="footer-newsletter-eyebrow">{{ section.settings.newsletter_eyebrow }}</span>
    {%- endif -%}
    <h3>{{ section.settings.newsletter_title }}</h3>
    <p>{{ section.settings.newsletter_subtitle }}</p>
    <form class="newsletter-form" action="/contact#contact_form" method="post" accept-charset="UTF-8">
      <input type="hidden" name="form_type" value="customer">
      <input type="hidden" name="utf8" value="✓">
      <input
        class="newsletter-input"
        type="email"
        name="contact[email]"
        placeholder="{{ section.settings.newsletter_placeholder }}"
        required
      >
      <button type="submit" class="newsletter-btn">{{ section.settings.newsletter_btn }}</button>
    </form>
    {%- if section.settings.newsletter_disclaimer != blank -%}
      <p class="newsletter-disclaimer">{{ section.settings.newsletter_disclaimer }}</p>
    {%- endif -%}
  </div>
</div>
{%- endif -%}

<!-- ===== FOOTER PRINCIPAL ===== -->
<footer class="footer-main">
  <div class="footer-grid">

    <!-- COL 1: MARCA -->
    <div class="footer-col">
      <span class="footer-logo-text">{{ section.settings.brand_name }}</span>
      {%- if section.settings.brand_tagline != blank -%}
        <span class="footer-tagline">{{ section.settings.brand_tagline }}</span>
      {%- endif -%}
      <p>{{ section.settings.brand_desc }}</p>

      <!-- REDES SOCIALES CON SVG -->
      <span class="footer-social-title">{{ section.settings.social_label }}</span>
      <div class="footer-social-icons">

        {%- if section.settings.facebook != blank -%}
          <a href="{{ section.settings.facebook }}" target="_blank" rel="noopener"
             class="footer-social-btn footer-social-btn--facebook" aria-label="Facebook">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
        {%- endif -%}

        {%- if section.settings.instagram != blank -%}
          <a href="{{ section.settings.instagram }}" target="_blank" rel="noopener"
             class="footer-social-btn footer-social-btn--instagram" aria-label="Instagram">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
            </svg>
          </a>
        {%- endif -%}

        {%- if section.settings.tiktok != blank -%}
          <a href="{{ section.settings.tiktok }}" target="_blank" rel="noopener"
             class="footer-social-btn footer-social-btn--tiktok" aria-label="TikTok">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.34 6.34 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.18 8.18 0 004.78 1.52V6.73a4.85 4.85 0 01-1.01-.04z"/>
            </svg>
          </a>
        {%- endif -%}

        {%- if section.settings.youtube != blank -%}
          <a href="{{ section.settings.youtube }}" target="_blank" rel="noopener"
             class="footer-social-btn footer-social-btn--youtube" aria-label="YouTube">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M23.495 6.205a3.007 3.007 0 00-2.088-2.088c-1.87-.501-9.396-.501-9.396-.501s-7.507-.01-9.396.501A3.007 3.007 0 00.527 6.205a31.247 31.247 0 00-.522 5.805 31.247 31.247 0 00.522 5.783 3.007 3.007 0 002.088 2.088c1.868.502 9.396.502 9.396.502s7.506 0 9.396-.502a3.007 3.007 0 002.088-2.088 31.247 31.247 0 00.5-5.783 31.247 31.247 0 00-.5-5.805zM9.609 15.601V8.408l6.264 3.602z"/>
            </svg>
          </a>
        {%- endif -%}

      </div>
    </div>

    <!-- COL 2: MENÚ -->
    {%- if section.settings.show_menu_col -%}
    <div class="footer-col">
      <h4>{{ section.settings.menu_col_title }}</h4>
      <ul>
        {%- for link in linklists[section.settings.footer_menu].links -%}
          <li>
            <span class="footer-li-icon">›</span>
            <a href="{{ link.url }}">{{ link.title }}</a>
          </li>
        {%- endfor -%}
      </ul>
    </div>
    {%- endif -%}

    <!-- COL 3: CONTACTO -->
    {%- if section.settings.show_contact_col -%}
    <div class="footer-col">
      <h4>{{ section.settings.contact_col_title }}</h4>
      <ul>
        {%- if section.settings.address != blank -%}
          <li>
            <span class="footer-li-icon">📍</span>
            <span>{{ section.settings.address }}</span>
          </li>
        {%- endif -%}
        {%- if section.settings.phone != blank -%}
          <li>
            <span class="footer-li-icon">📞</span>
            <a href="tel:{{ section.settings.phone | remove: ' ' }}">{{ section.settings.phone }}</a>
          </li>
        {%- endif -%}
        {%- if section.settings.email != blank -%}
          <li>
            <span class="footer-li-icon">✉️</span>
            <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
          </li>
        {%- endif -%}
        {%- if section.settings.hours != blank -%}
          <li>
            <span class="footer-li-icon">🕐</span>
            <span>{{ section.settings.hours }}</span>
          </li>
        {%- endif -%}
        {%- if section.settings.hours2 != blank -%}
          <li>
            <span class="footer-li-icon">🕐</span>
            <span>{{ section.settings.hours2 }}</span>
          </li>
        {%- endif -%}
      </ul>
    </div>
    {%- endif -%}

  </div>

  <hr class="footer-divider">

  <div class="footer-bottom">
    <span>© {{ 'now' | date: '%Y' }} {{ section.settings.brand_name }}. {{ section.settings.copyright_text }}</span>
    <div>
      {%- if section.settings.show_policy_links -%}
        <a href="/policies/privacy-policy">Privacidad</a>
        <a href="/policies/terms-of-service">Términos</a>
        <a href="/policies/shipping-policy">Envíos</a>
      {%- endif -%}
    </div>
    {%- if section.settings.show_made_with != blank -%}
      <span class="footer-bottom-badge">🌿 {{ section.settings.show_made_with }}</span>
    {%- endif -%}
  </div>
</footer>

<!-- ===== BOTÓN FLOTANTE (WhatsApp o el que quieras) ===== -->
{%- if section.settings.float_btn_link != blank -%}
  <a
    href="{{ section.settings.float_btn_link }}"
    class="footer-float-btn"
    target="_blank"
    rel="noopener"
    aria-label="{{ section.settings.float_btn_tooltip }}"
  >
    {%- if section.settings.float_btn_icon == 'whatsapp' -%}
      <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="currentColor">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
    {%- elsif section.settings.float_btn_icon == 'instagram' -%}
      <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="currentColor">
