{% comment %}
  ╔══════════════════════════════════════════════════════════════╗
  ║  FRUTOS DE LA RAÍZ — PÁGINA DE CONTACTO COMPLETA            ║
  ║  Archivo: frutos-contact-final.liquid                        ║
  ║  Uso: Añadir como sección en página de contacto             ║
  ║  Requiere: frutos-header (arriba) + footer-frutos (abajo)   ║
  ╚══════════════════════════════════════════════════════════════╝
{% endcomment %}

{%- style -%}
/* ═══════════════════════════════════════════════════════════════
   FRUTOS CONTACT — CSS COMPLETO (prefijo .frc-)
   ═══════════════════════════════════════════════════════════════ */

/* ── Variables CSS ── */
.frc-contact {
  --frc-green-dark: #1B5E20;
  --frc-green-mid:  #2E7D32;
  --frc-green-light:#4CAF50;
  --frc-green-lime: #76FF03;
  --frc-yellow:     #FFC107;
  --frc-orange:     #FF5722;
  --frc-brown:      #5D4037;
  --frc-brown-mid:  #8D6E63;
  --frc-cream:      #F5F5F0;
  --frc-cream-light:#FAFAF8;
  --frc-text:       #333333;
  --frc-text-light: #f4f4f4;
  --frc-muted:      #d7ccc8;
  --frc-border:     #DDD8CF;
  --frc-white:      #ffffff;
  --frc-shadow:     0 4px 20px rgba(27,94,32,0.12);
  --frc-shadow-lg:  0 8px 32px rgba(27,94,32,0.18);
  --frc-shadow-input: 0 0 0 4px rgba(76,175,80,0.15);
  --frc-radius-sm:  12px;
  --frc-radius-md:  16px;
  --frc-radius-lg:  50px;
  --frc-radius-full: 100px;
  --frc-font-title: 'Amatic SC', cursive;
  --frc-font-ui:    'Montserrat', sans-serif;
  --frc-font-body:  'Lato', sans-serif;
  --frc-max-width:  {{ section.settings.max_width | default: 1200 }}px;
  --frc-pt:         {{ section.settings.padding_top | default: 0 }}px;
  --frc-pb:         {{ section.settings.padding_bottom | default: 0 }}px;
  --frc-bg:         {{ section.settings.bg_color | default: '#FAFAF8' }};
}

/* ── Reset / Container ── */
.frc-contact * { box-sizing: border-box; }
.frc-contact {
  font-family: var(--frc-font-body);
  color: var(--frc-text);
  background: var(--frc-bg);
  padding-top: var(--frc-pt);
  padding-bottom: var(--frc-pb);
  line-height: 1.6;
}
.frc-contact__container {
  max-width: var(--frc-max-width);
  margin: 0 auto;
  padding: 0 24px;
}

/* ═══════════════════════════════════════════════
   HERO
   ═══════════════════════════════════════════════ */
.frc-hero {
  background: linear-gradient(135deg,
    {{ section.settings.hero_bg_from | default: '#1B5E20' }},
    {{ section.settings.hero_bg_to | default: '#2E7D32' }}
  );
  padding: 64px 24px 80px;
  text-align: center;
  position: relative;
  overflow: hidden;
}
.frc-hero::before {
  content: '';
  position: absolute;
  top: -60px; right: -60px;
  width: 220px; height: 220px;
  background: rgba(118,255,3,0.08);
  border-radius: 50%;
}
.frc-hero::after {
  content: '';
  position: absolute;
  bottom: -40px; left: -40px;
  width: 160px; height: 160px;
  background: rgba(255,193,7,0.06);
  border-radius: 50%;
}
.frc-hero__inner { position: relative; z-index: 1; }
.frc-hero__title {
  font-family: var(--frc-font-title);
  font-size: clamp(48px, 6vw, 72px);
  color: var(--frc-white);
  margin: 0 0 12px;
  text-shadow: 2px 2px 8px rgba(0,0,0,0.2);
  line-height: 1.1;
}
.frc-hero__subtitle {
  font-family: var(--frc-font-body);
  font-size: clamp(16px, 2vw, 20px);
  color: rgba(255,255,255,0.92);
  margin: 0 auto;
  max-width: 540px;
  line-height: 1.6;
}

/* ═══════════════════════════════════════════════
   LAYOUT 2 COLUMNAS (Form + Info Cards)
   ═══════════════════════════════════════════════ */
.frc-body {
  padding: 48px 0 32px;
}
.frc-body__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 48px;
  align-items: start;
}
@media (min-width: 900px) {
  .frc-body__grid {
    grid-template-columns: 1.15fr 0.85fr;
  }
}
@media (max-width: 767px) {
  .frc-body__grid {
    grid-template-columns: 1fr;
    gap: 32px;
  }
}

/* ── Formulario ── */
.frc-form__wrapper {
  background: var(--frc-white);
  border-radius: var(--frc-radius-md);
  padding: 40px;
  box-shadow: var(--frc-shadow);
}
.frc-form__title {
  font-family: var(--frc-font-title);
  font-size: 36px;
  color: var(--frc-green-dark);
  margin: 0 0 4px;
}
.frc-form__subtitle {
  font-family: var(--frc-font-body);
  font-size: 14px;
  color: var(--frc-brown-mid);
  margin: 0 0 28px;
}
.frc-form__group { margin-bottom: 20px; }
.frc-form__group:last-of-type { margin-bottom: 28px; }
.frc-form__label {
  display: block;
  font-family: var(--frc-font-ui);
  font-weight: 600;
  font-size: 13px;
  color: var(--frc-brown);
  margin-bottom: 6px;
  text-transform: uppercase;
  letter-spacing: 0.4px;
}
.frc-form__input {
  width: 100%;
  padding: 14px 22px;
  font-family: var(--frc-font-body);
  font-size: 15px;
  color: var(--frc-text);
  background: var(--frc-cream);
  border: 2px solid var(--frc-border);
  border-radius: var(--frc-radius-full);
  outline: none;
  transition: all 0.25s ease;
}
.frc-form__input::placeholder { color: #aaa; }
.frc-form__input:focus {
  border-color: var(--frc-green-light);
  box-shadow: var(--frc-shadow-input);
  background: var(--frc-white);
}
.frc-form__input--textarea {
  border-radius: var(--frc-radius-md);
  min-height: 120px;
  resize: vertical;
  padding: 16px 22px;
}
.frc-form__submit {
  display: block;
  width: 100%;
  padding: 16px 32px;
  font-family: var(--frc-font-ui);
  font-weight: 700;
  font-size: 15px;
  color: var(--frc-white);
  background: linear-gradient(135deg, var(--frc-green-dark), var(--frc-green-mid));
  border: none;
  border-radius: var(--frc-radius-lg);
  cursor: pointer;
  box-shadow: 0 4px 16px rgba(27,94,32,0.35);
  transition: all 0.3s ease;
  text-transform: uppercase;
  letter-spacing: 0.8px;
}
.frc-form__submit:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 24px rgba(27,94,32,0.45);
  background: linear-gradient(135deg, var(--frc-green-mid), var(--frc-green-dark));
}
.frc-form__submit:active { transform: translateY(0); }
.frc-form__error {
  display: none;
  color: #c62828;
  font-size: 13px;
  margin-top: 6px;
  font-family: var(--frc-font-ui);
}
.frc-form__success {
  display: none;
  background: #e8f5e9;
  border: 1px solid var(--frc-green-light);
  border-radius: var(--frc-radius-sm);
  padding: 16px;
  margin-bottom: 20px;
  color: var(--frc-green-dark);
  font-family: var(--frc-font-ui);
  font-size: 14px;
  font-weight: 600;
}

/* ── Info Cards ── */
.frc-info__header {
  margin-bottom: 20px;
}
.frc-info__pretitle {
  font-family: var(--frc-font-ui);
  font-weight: 700;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  color: var(--frc-green-mid);
  margin: 0 0 4px;
}
.frc-info__title {
  font-family: var(--frc-font-title);
  font-size: 32px;
  color: var(--frc-green-dark);
  margin: 0;
}
.frc-info__cards {
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.frc-info__card {
  background: var(--frc-white);
  border-radius: var(--frc-radius-md);
  padding: 24px;
  box-shadow: var(--frc-shadow);
  transition: all 0.3s ease;
  cursor: default;
  position: relative;
  overflow: hidden;
}
.frc-info__card::before {
  content: '';
  position: absolute;
  top: 0; left: 0;
  width: 4px; height: 100%;
  background: linear-gradient(180deg, var(--frc-green-light), var(--frc-green-dark));
  opacity: 0;
  transition: opacity 0.3s ease;
}
.frc-info__card:hover {
  transform: translateY(-4px);
  box-shadow: var(--frc-shadow-lg);
}
.frc-info__card:hover::before { opacity: 1; }
.frc-info__card-emoji {
  font-size: 28px;
  margin-bottom: 8px;
  display: block;
}
.frc-info__card-title {
  font-family: var(--frc-font-ui);
  font-weight: 700;
  font-size: 15px;
  color: var(--frc-green-dark);
  margin: 0 0 6px;
}
.frc-info__card-text {
  font-family: var(--frc-font-body);
  font-size: 14px;
  color: var(--frc-brown-mid);
  margin: 0 0 10px;
  line-height: 1.5;
}
.frc-info__card-link {
  font-family: var(--frc-font-ui);
  font-weight: 600;
  font-size: 13px;
  color: var(--frc-green-mid);
  text-decoration: none;
  transition: color 0.2s;
}
.frc-info__card-link:hover { color: var(--frc-orange); }

/* ═══════════════════════════════════════════════
   SECCIÓN MAPA / UBICACIÓN
   ═══════════════════════════════════════════════ */
.frc-location {
  background: var(--frc-cream-light);
  padding: 64px 0;
}
.frc-location__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 48px;
  align-items: center;
}
@media (max-width: 767px) {
  .frc-location__grid {
    grid-template-columns: 1fr;
    gap: 32px;
  }
}

/* ── Info lateral ── */
.frc-location__eyebrow {
  font-family: var(--frc-font-ui);
  font-weight: 700;
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  color: var(--frc-green-mid);
  margin: 0 0 8px;
  display: flex;
  align-items: center;
  gap: 8px;
}
.frc-location__eyebrow-icon { font-size: 18px; }
.frc-location__title {
  font-family: var(--frc-font-title);
  font-size: clamp(32px, 4vw, 44px);
  color: var(--frc-green-dark);
  margin: 0 0 16px;
  line-height: 1.15;
}

/* Badge abierto/cerrado */
.frc-open-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: var(--frc-white);
  border: 1.5px solid var(--frc-green-light);
  border-radius: var(--frc-radius-lg);
  padding: 8px 18px;
  font-family: var(--frc-font-ui);
  font-weight: 600;
  font-size: 13px;
  color: var(--frc-green-dark);
  margin-bottom: 16px;
  box-shadow: 0 2px 8px rgba(27,94,32,0.08);
  transition: all 0.3s ease;
}
.frc-open-badge.is-closed {
  border-color: #e0e0e0;
  color: #888;
}
.frc-open-badge__dot {
  width: 8px; height: 8px;
  border-radius: 50%;
  background: var(--frc-green-light);
  animation: frcBlink 1.5s ease-in-out infinite;
}
.frc-open-badge.is-closed .frc-open-badge__dot {
  background: #bdbdbd;
  animation: none;
}
@keyframes frcBlink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.3; }
}

/* USP Pills */
.frc-usp__list {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 24px;
}
.frc-usp__pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: linear-gradient(135deg, var(--frc-green-dark), var(--frc-green-mid));
  color: var(--frc-white);
  font-family: var(--frc-font-ui);
  font-weight: 600;
  font-size: 12px;
  padding: 7px 16px;
  border-radius: var(--frc-radius-lg);
  box-shadow: 0 2px 8px rgba(27,94,32,0.2);
}

/* Detail items */
.frc-detail {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-bottom: 24px;
}
.frc-detail__item {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  background: var(--frc-white);
  border-radius: var(--frc-radius-sm);
  padding: 14px 16px;
  border-left: 3px solid var(--frc-green-light);
  box-shadow: 0 1px 6px rgba(0,0,0,0.04);
  transition: all 0.2s ease;
}
.frc-detail__item:hover {
  box-shadow: 0 3px 12px rgba(27,94,32,0.1);
  transform: translateX(3px);
}
.frc-detail__icon { font-size: 20px; flex-shrink: 0; margin-top: 2px; }
.frc-detail__text {
  font-family: var(--frc-font-body);
  font-size: 14px;
  color: var(--frc-text);
  line-height: 1.5;
  margin: 0;
}
.frc-detail__text strong {
  font-family: var(--frc-font-ui);
  color: var(--frc-green-dark);
}

/* Botones CTA */
.frc-cta__group {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-bottom: 16px;
}
.frc-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 14px 28px;
  font-family: var(--frc-font-ui);
  font-weight: 700;
  font-size: 14px;
  text-decoration: none;
  border-radius: var(--frc-radius-lg);
  transition: all 0.3s ease;
  cursor: pointer;
  border: none;
}
.frc-btn--primary {
  background: linear-gradient(135deg, var(--frc-green-dark), var(--frc-green-mid));
  color: var(--frc-white);
  box-shadow: 0 4px 16px rgba(27,94,32,0.35);
}
.frc-btn--primary:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 24px rgba(27,94,32,0.45);
}
.frc-btn--secondary {
  background: var(--frc-white);
  color: var(--frc-green-dark);
  border: 2px solid var(--frc-green-light);
  box-shadow: 0 2px 8px rgba(0,0,0,0.06);
}
.frc-btn--secondary:hover {
  background: var(--frc-green-light);
  color: var(--frc-white);
  transform: translateY(-3px);
}
.frc-btn__emoji { font-size: 16px; }

/* Subtext */
.frc-location__subtext {
  font-family: var(--frc-font-body);
  font-size: 13px;
  color: var(--frc-brown-mid);
  font-style: italic;
  margin: 0;
}

/* ── Mapa ── */
.frc-map__wrapper {
  border-radius: var(--frc-radius-md);
  overflow: hidden;
  box-shadow: var(--frc-shadow-lg);
  height: 100%;
  min-height: 360px;
  position: relative;
}
.frc-map__wrapper iframe {
  width: 100%;
  height: 100%;
  min-height: 360px;
  border: 0;
  display: block;
  filter: saturate(0.85);
  transition: filter 0.3s ease;
}
.frc-map__wrapper:hover iframe {
  filter: saturate(1);
}

/* ═══════════════════════════════════════════════
   FAQ ACORDEÓN
   ═══════════════════════════════════════════════ */
.frc-faq {
  padding: 48px 0 64px;
}
.frc-faq__header { text-align: center; margin-bottom: 36px; }
.frc-faq__pretitle {
  font-family: var(--frc-font-ui);
  font-weight: 700;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  color: var(--frc-green-mid);
  margin: 0 0 4px;
}
.frc-faq__title {
  font-family: var(--frc-font-title);
  font-size: 40px;
  color: var(--frc-green-dark);
  margin: 0;
}
.frc-faq__list {
  max-width: 720px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.frc-faq__item {
  background: var(--frc-white);
  border-radius: var(--frc-radius-md);
  box-shadow: 0 2px 12px rgba(0,0,0,0.06);
  overflow: hidden;
  transition: box-shadow 0.3s ease;
}
.frc-faq__item:hover { box-shadow: 0 4px 20px rgba(0,0,0,0.1); }
.frc-faq__btn {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: 20px 24px;
  background: none;
  border: none;
  font-family: var(--frc-font-ui);
  font-weight: 600;
  font-size: 15px;
  color: var(--frc-green-dark);
  text-align: left;
  cursor: pointer;
  transition: background 0.2s ease;
}
.frc-faq__btn:hover { background: rgba(27,94,32,0.03); }
.frc-faq__icon {
  font-size: 20px;
  color: var(--frc-green-mid);
  transition: transform 0.3s ease;
  flex-shrink: 0;
  margin-left: 12px;
}
.frc-faq__item.is-open .frc-faq__icon { transform: rotate(180deg); }
.frc-faq__answer {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.35s ease, padding 0.35s ease;
}
.frc-faq__item.is-open .frc-faq__answer {
  max-height: 300px;
  padding: 0 24px 20px;
}
.frc-faq__text {
  font-family: var(--frc-font-body);
  font-size: 14px;
  color: var(--frc-brown-mid);
  line-height: 1.7;
  margin: 0;
}

/* ═══════════════════════════════════════════════
   RESPONSIVE UTILITIES
   ═══════════════════════════════════════════════ */
@media (max-width: 767px) {
  .frc-hero { padding: 48px 20px 56px; }
  .frc-form__wrapper { padding: 28px 20px; }
  .frc-body { padding: 32px 0 20px; }
  .frc-location { padding: 44px 0; }
  .frc-location__grid { gap: 28px; }
  .frc-map__wrapper { min-height: 280px; }
  .frc-map__wrapper iframe { min-height: 280px; }
  .frc-cta__group { flex-direction: column; }
  .frc-btn { width: 100%; }
  .frc-usp__list { justify-content: center; }
  .frc-faq { padding: 36px 0 48px; }
}
{%- endstyle -%}

{%- comment -%}
================================================================================
  HTML — ESTRUCTURA COMPLETA
================================================================================
{%- endcomment -%}

<div class="frc-contact" id="frc-contact-{{ section.id }}">

  <!-- ========== HERO ========== -->
  <div class="frc-hero">
    <div class="frc-hero__inner">
      <h1 class="frc-hero__title">{{ section.settings.hero_title | default: 'Contáctanos' }}</h1>
      <p class="frc-hero__subtitle">{{ section.settings.hero_subtitle | default: 'Estamos aquí para ayudarte. Escríbenos, visítanos en nuestro local o envíanos un mensaje por WhatsApp. Te responderemos con gusto.' }}</p>
    </div>
  </div>

  <!-- ========== BODY: FORM + INFO CARDS ========== -->
  <div class="frc-body">
    <div class="frc-contact__container">
      <div class="frc-body__grid">

        <!-- ── FORMULARIO ── -->
        <div class="frc-form__wrapper">
          <h2 class="frc-form__title">{{ section.settings.form_title | default: 'Escríbenos' }}</h2>
          <p class="frc-form__subtitle">{{ section.settings.form_subtitle | default: 'Completa el formulario y te responderemos en menos de 24 horas.' }}</p>

          <div class="frc-form__success" id="fcSuccessMsg" role="status">
            ✅ ¡Mensaje enviado con éxito! Te contactaremos pronto.
          </div>

          <form
            id="fcContactForm"
            action="/contact#contact_form"
            method="post"
            onsubmit="return window.fcValidateForm();"
            novalidate
          >
            <input type="hidden" name="form_type" value="customer">
            <input type="hidden" name="utf8" value="✓">

            <div class="frc-form__group">
              <label class="frc-form__label" for="fcName">Nombre *</label>
              <input
                type="text"
                id="fcName"
                name="contact[name]"
                class="frc-form__input"
                placeholder="Tu nombre completo"
                required
              >
              <span class="frc-form__error" id="fcNameError">Por favor ingresa tu nombre.</span>
            </div>

            <div class="frc-form__group">
              <label class="frc-form__label" for="fcEmail">Email *</label>
              <input
                type="email"
                id="fcEmail"
                name="contact[email]"
                class="frc-form__input"
                placeholder="tu@email.com"
                required
              >
              <span class="frc-form__error" id="fcEmailError">Por favor ingresa un email válido.</span>
            </div>

            {% if section.settings.show_phone_field %}
            <div class="frc-form__group">
              <label class="frc-form__label" for="fcPhone">Teléfono</label>
              <input
                type="tel"
                id="fcPhone"
                name="contact[phone]"
                class="frc-form__input"
                placeholder="300 123 4567"
              >
            </div>
            {% endif %}

            <div class="frc-form__group">
              <label class="frc-form__label" for="fcMessage">Mensaje *</label>
              <textarea
                id="fcMessage"
                name="contact[body]"
                class="frc-form__input frc-form__input--textarea"
                placeholder="¿En qué podemos ayudarte? Cuéntanos..."
                required
              ></textarea>
              <span class="frc-form__error" id="fcMsgError">Por favor escribe tu mensaje.</span>
            </div>

            <button type="submit" class="frc-form__submit">
