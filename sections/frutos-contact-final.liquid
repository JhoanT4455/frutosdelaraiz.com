================================================================================
  JAVASCRIPT — FUNCIONES GLOBALES (window.*)
================================================================================
{%- endcomment -%}
<script>
(function() {
  'use strict';

  // ── 1. Validación del formulario ──
  window.fcValidateForm = function() {
    var form = document.getElementById('fcContactForm');
    var nameEl = document.getElementById('fcName');
    var emailEl = document.getElementById('fcEmail');
    var msgEl = document.getElementById('fcMessage');
    var isValid = true;

    // Reset errores
    var errors = form.querySelectorAll('.frc-form__error');
    for (var i = 0; i < errors.length; i++) {
      errors[i].style.display = 'none';
    }
    var inputs = form.querySelectorAll('.frc-form__input');
    for (var j = 0; j < inputs.length; j++) {
      inputs[j].style.borderColor = '';
    }

    // Validar nombre
    if (!nameEl || nameEl.value.trim().length < 2) {
      if (nameEl) nameEl.style.borderColor = '#c62828';
      var nameErr = document.getElementById('fcNameError');
      if (nameErr) nameErr.style.display = 'block';
      isValid = false;
    }

    // Validar email
    var emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailEl || !emailRe.test(emailEl.value.trim())) {
      if (emailEl) emailEl.style.borderColor = '#c62828';
      var emailErr = document.getElementById('fcEmailError');
      if (emailErr) emailErr.style.display = 'block';
      isValid = false;
    }

    // Validar mensaje
    if (!msgEl || msgEl.value.trim().length < 5) {
      if (msgEl) msgEl.style.borderColor = '#c62828';
      var msgErr = document.getElementById('fcMsgError');
      if (msgErr) msgErr.style.display = 'block';
      isValid = false;
    }

    return isValid;
  };

  // ── 2. Toggle FAQ acordeón ──
  window.fcFaqToggle = function(btn) {
    var item = btn.closest('.frc-faq__item');
    if (!item) return;
    var isOpen = item.classList.contains('is-open');

    // Cerrar todos los demás (accordion behavior)
    var allItems = document.querySelectorAll('.frc-faq__item.is-open');
    for (var k = 0; k < allItems.length; k++) {
      if (allItems[k] !== item) {
        allItems[k].classList.remove('is-open');
      }
    }

    // Toggle actual
    if (isOpen) {
      item.classList.remove('is-open');
    } else {
      item.classList.add('is-open');
    }
  };

  // ── 3. Copiar número al portapapeles ──
  window.fcCopyPhone = function() {
    var phoneText = document.getElementById('fcPhoneNum');
    if (!phoneText) return;
    var clean = phoneText.textContent.replace(/\D/g, '');

    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(clean).then(function() {
        window.fcShowCopyToast('Número copiado: ' + clean);
      }).catch(function() {
        window.fcFallbackCopy(clean);
      });
    } else {
      window.fcFallbackCopy(clean);
    }
  };

  window.fcFallbackCopy = function(text) {
    var ta = document.createElement('textarea');
    ta.value = text;
    ta.style.position = 'fixed';
    ta.style.opacity = '0';
    document.body.appendChild(ta);
    ta.select();
    try {
      document.execCommand('copy');
      window.fcShowCopyToast('Número copiado: ' + text);
    } catch (err) {
      window.fcShowCopyToast('No se pudo copiar automáticamente');
    }
    document.body.removeChild(ta);
  };

  window.fcShowCopyToast = function(message) {
    var existing = document.getElementById('fcCopyToast');
    if (existing) existing.remove();

    var toast = document.createElement('div');
    toast.id = 'fcCopyToast';
    toast.textContent = message;
    toast.style.cssText = 'position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:#1B5E20;color:#fff;padding:12px 24px;border-radius:50px;font-family:Montserrat,sans-serif;font-weight:600;font-size:13px;z-index:9999;box-shadow:0 4px 16px rgba(27,94,32,0.4);animation:fcToastIn 0.3s ease;';

    var style = document.createElement('style');
    style.textContent = '@keyframes fcToastIn{from{opacity:0;transform:translateX(-50%) translateY(20px);}to{opacity:1;transform:translateX(-50%) translateY(0);}}@keyframes fcToastOut{from{opacity:1;}to{opacity:0;}}';
    document.head.appendChild(style);

    document.body.appendChild(toast);
    setTimeout(function() {
      toast.style.animation = 'fcToastOut 0.3s ease forwards';
      setTimeout(function() { toast.remove(); }, 300);
    }, 2500);
  };

  // ── 4. Detectar si está abierto ahora (badge inteligente) ──
  (function() {
    var now = new Date();
    var hour = now.getHours();
    var day = now.getDay(); // 0=domingo, 1=lunes...
    // Horario: Lun-Sáb 9:30-21:00 (9am a 9pm)
    var isOpen = (day >= 1 && day <= 6) && (hour >= 9 && hour < 21);

    var badge = document.getElementById('fcOpenBadge');
    if (badge) {
      badge.classList.toggle('is-open', isOpen);
      badge.classList.toggle('is-closed', !isOpen);
      var text = badge.querySelector('.frc-open-text');
      if (text) {
        text.textContent = isOpen
          ? '{{ section.settings.open_badge_text | default: "Abierto ahora · Visítanos hoy" }}'
          : 'Cerrado · Abrimos mañana 9:30am';
      }
    }
  })();

  // ── 5. Auto-marcar éxito si hay parámetro en URL ──
  (function() {
    var url = window.location.href;
    if (url.indexOf('?contact%5Bposted%5D=true') !== -1 || url.indexOf('?contact[posted]=true') !== -1) {
      var successMsg = document.getElementById('fcSuccessMsg');
      if (successMsg) {
        successMsg.style.display = 'block';
        // Scroll suave al mensaje
        setTimeout(function() {
          successMsg.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }, 300);
      }
      // Limpiar URL
      if (window.history && window.history.replaceState) {
        window.history.replaceState({}, document.title, window.location.pathname);
      }
    }
  })();

})();
</script>

