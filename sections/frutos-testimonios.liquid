<style>
  /* =============================================
     TESTIMONIOS GOOGLE - CRO + EDITABLE + USP
     Frutos de la Raíz — 4.9★ · 32 reseñas · Negocio local
     ============================================= */

  .test-section {
    padding: 70px 5%;
    text-align: center;
  }

  /* ---- HEADER ---- */
  .test-header {
    margin-bottom: 40px;
  }

  .test-eyebrow {
    display: inline-block;
    font-family: 'Montserrat', sans-serif;
    font-size: .82rem;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    padding: 6px 18px;
    border-radius: 30px;
    margin-bottom: 15px;
  }

  .test-title {
    font-family: 'Amatic SC', cursive;
    font-size: 4.5rem;
    font-weight: 700;
    margin-bottom: 22px;
    line-height: 1;
  }

  /* ---- GOOGLE HERO (rating grande, CRO) ---- */
  .test-google-hero {
    display: inline-flex;
    align-items: center;
    gap: 22px;
    background: white;
    padding: 18px 32px;
    border-radius: 20px;
    box-shadow: 0 8px 30px rgba(0,0,0,0.08);
    text-decoration: none;
    transition: box-shadow 0.3s, transform 0.3s;
  }

  .test-google-hero:hover {
    box-shadow: 0 14px 38px rgba(0,0,0,0.13);
    transform: translateY(-2px);
  }

  .ghero-icon {
    font-size: 1.6rem;
    color: #4285F4;
    flex-shrink: 0;
  }

  .ghero-score {
    font-family: 'Amatic SC', cursive;
    font-size: 3.1rem;
    font-weight: 700;
    line-height: 1;
    color: #1B5E20;
  }

  .ghero-details {
    text-align: left;
  }

  .ghero-stars {
    color: #FFC107;
    font-size: 1.15rem;
    letter-spacing: 2px;
    display: block;
  }

  .ghero-meta {
    font-family: 'Montserrat', sans-serif;
    font-size: .85rem;
    color: #555;
    font-weight: 600;
    margin-top: 2px;
  }

  .ghero-cta {
    font-family: 'Montserrat', sans-serif;
    font-size: .74rem;
    color: #4285F4;
    font-weight: 700;
    margin-top: 4px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  /* ---- STATS ROW (CRO: prueba social cuantificada) ---- */
  .test-stats-row {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    max-width: 900px;
    margin: 28px auto 0;
    background: white;
    border-radius: 18px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.05);
    overflow: hidden;
  }

  .test-stat {
    flex: 1 1 0;
    min-width: 150px;
    padding: 22px 14px;
    border-right: 1px solid #f0f0f0;
  }

  .test-stat:last-child { border-right: none; }

  .test-stat-emoji { font-size: 1.3rem; display: block; margin-bottom: 4px; }

  .test-stat-num {
    font-family: 'Amatic SC', cursive;
    font-size: 2.5rem;
    line-height: 1;
    color: #1B5E20;
    font-weight: 700;
    display: block;
  }

  .test-stat-label {
    font-family: 'Montserrat', sans-serif;
    font-size: .68rem;
    letter-spacing: .4px;
    text-transform: uppercase;
    color: #999;
    margin-top: 5px;
    font-weight: 700;
  }

  /* ---- TAG CLOUD (temas más mencionados) ---- */
  .test-tags-title {
    font-family: 'Montserrat', sans-serif;
    font-size: .8rem;
    color: #999;
    margin: 42px 0 16px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .test-tags-cloud {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    max-width: 820px;
    margin: 0 auto;
  }

  .test-tag-chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 16px;
    border: 1.5px solid #e6e6e6;
    border-radius: 30px;
    font-family: 'Lato', sans-serif;
    font-size: .82rem;
    color: #555;
    background: #fff;
  }

  .test-tag-chip .tag-count {
    background: #f1f8e9;
    color: #2E7D32;
    font-family: 'Montserrat', sans-serif;
    font-weight: 700;
    font-size: .66rem;
    padding: 2px 7px;
    border-radius: 10px;
  }

  /* ---- USP STRIP (CRO) ---- */
  .test-usp-strip {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
    margin: 40px auto 10px;
    max-width: 900px;
  }

  .test-usp-pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 9px 20px;
    border-radius: 30px;
    font-family: 'Montserrat', sans-serif;
    font-size: .82rem;
    font-weight: 700;
    transition: transform 0.3s;
  }

  .test-usp-pill:hover { transform: translateY(-3px); }

  .test-usp-pill .usp-emoji { font-size: 1.1rem; }

  /* ---- BANNER NEGOCIO LOCAL (elemento distintivo / sello) ---- */
  .test-local-banner {
    position: relative;
    max-width: 840px;
    margin: 46px auto 50px;
    background: linear-gradient(135deg, #1B5E20, #2E7D32);
    border-radius: 22px;
    padding: 34px 38px;
    display: flex;
    align-items: center;
    gap: 26px;
    text-align: left;
    overflow: hidden;
  }

  .test-local-banner::after {
    content: '';
    position: absolute;
    right: -40px;
    bottom: -60px;
    width: 180px;
    height: 180px;
    border-radius: 50%;
    background: rgba(255,255,255,0.05);
  }

  .test-local-stamp {
    flex-shrink: 0;
    width: 90px;
    height: 90px;
    border-radius: 50%;
    border: 3px dashed rgba(255,255,255,0.55);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.3rem;
    transform: rotate(-9deg);
    position: relative;
    z-index: 1;
  }

  .test-local-copy { position: relative; z-index: 1; }

  .test-local-copy h3 {
    font-family: 'Amatic SC', cursive;
    font-size: 2.1rem;
    color: #fff;
    margin: 0 0 6px;
    line-height: 1;
  }

  .test-local-copy p {
    font-family: 'Lato', sans-serif;
    font-size: .95rem;
    color: rgba(255,255,255,0.92);
    line-height: 1.65;
    margin: 0;
  }

  .test-local-copy .local-quote-author {
    display: block;
    margin-top: 10px;
    font-size: .8rem;
    color: rgba(255,255,255,0.7);
    font-style: italic;
  }

  /* ---- CARRUSEL DE TESTIMONIOS (con flechas) ---- */
  .test-carousel-wrapper {
    position: relative;
    max-width: 1200px;
    margin: 0 auto 26px;
    padding: 0 56px;
  }

  .test-grid {
    display: flex;
    gap: 26px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    padding: 4px 4px 14px;
    scrollbar-width: none;
  }

  .test-grid::-webkit-scrollbar { display: none; }

  .test-card {
    background: white;
    padding: 28px;
    border-radius: 16px;
    border: 1px solid #e8f5e9;
    box-shadow: 0 5px 18px rgba(0,0,0,0.05);
    display: flex;
    flex-direction: column;
    text-align: left;
    position: relative;
    flex: 0 0 calc((100% - 52px) / 3);
    scroll-snap-align: start;
    transition: transform 0.35s cubic-bezier(0.175,0.885,0.32,1.275), box-shadow 0.3s;
  }

  .test-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 14px 35px rgba(27,94,32,0.1);
  }

  /* Flechas de navegación */
  .test-carousel-arrow {
    position: absolute;
    top: 44%;
    transform: translateY(-50%);
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: white;
    box-shadow: 0 5px 16px rgba(0,0,0,0.14);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.05rem;
    color: #1B5E20;
    z-index: 5;
    transition: all 0.3s;
  }

  .test-carousel-arrow:hover {
    background: #1B5E20;
    color: #fff;
    transform: translateY(-50%) scale(1.07);
  }

  .test-carousel-arrow.is-prev { left: 0; }
  .test-carousel-arrow.is-next { right: 0; }

  .test-carousel-hint {
    text-align: center;
    font-family: 'Lato', sans-serif;
    font-size: .8rem;
    color: #aaa;
    margin: -12px 0 40px;
  }

  /* Comilla decorativa */
  .test-card::before {
    content: '\201C';
    font-family: Georgia, serif;
    font-size: 7rem;
    position: absolute;
    top: -8px;
    right: 16px;
    line-height: 1;
    pointer-events: none;
    opacity: .07;
  }

  /* Cabecera: avatar + nombre + estrellas */
  .test-card-header {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 15px;
  }

  .test-avatar {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Montserrat', sans-serif;
    font-weight: 700;
    font-size: 1.25rem;
    color: white;
    flex-shrink: 0;
  }

  .test-card-name {
    font-family: 'Montserrat', sans-serif;
    font-size: 1rem;
    font-weight: 700;
    margin: 0 0 4px;
  }

  .test-card-meta {
    font-family: 'Lato', sans-serif;
    font-size: .78rem;
    color: #aaa;
    margin-bottom: 2px;
  }

  /* Estrellas */
  .test-stars-row {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .test-star { color: #FFC107; font-size: .88rem; }
  .test-star.empty { color: #ddd; }

  /* Badge Local Guide */
  .test-guide-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: #e8f0fe;
    color: #1967D2;
    font-family: 'Montserrat', sans-serif;
    font-size: .64rem;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 8px;
    white-space: nowrap;
  }

  /* Texto de la reseña */
  .test-card-text {
    font-family: 'Lato', sans-serif;
    color: #555;
    line-height: 1.75;
    font-size: .98rem;
    flex-grow: 1;
    font-style: italic;
    margin-bottom: 18px;
  }

  /* CRO: keyword destacada en la reseña */
  .test-card-keyword {
    display: inline-block;
    background: #f1f8e9;
    color: #2E7D32;
    font-family: 'Montserrat', sans-serif;
    font-size: .72rem;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 10px;
    margin-bottom: 14px;
  }

  /* Footer: fuente */
  .test-card-footer {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    font-family: 'Lato', sans-serif;
    font-size: .8rem;
    color: #bbb;
    border-top: 1px solid #f5f5f5;
    padding-top: 14px;
    margin-top: auto;
  }

  .test-card-footer .g-dot { color: #4285F4; }
  .test-card-footer .footer-sep { color: #ddd; }

  /* ---- CTA FINAL ---- */
  .test-cta-block {
    text-align: center;
  }

  .test-cta-label {
    font-family: 'Lato', sans-serif;
    font-size: 1.05rem;
    color: #666;
    margin-bottom: 20px;
  }

  .test-cta-btn {
    display: inline-block;
    padding: 15px 45px;
    border-radius: 50px;
    font-family: 'Montserrat', sans-serif;
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.3s;
    box-shadow: 0 4px 15px rgba(0,0,0,0.15);
  }

  .test-cta-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 28px rgba(0,0,0,0.18);
  }

  /* ---- RESPONSIVE ---- */
  @media (max-width: 1024px) {
    .test-card { flex: 0 0 calc((100% - 26px) / 2); }
  }

  @media (max-width: 768px) {
    .test-title { font-size: 3.5rem; }
    .test-usp-strip { gap: 8px; }
    .test-usp-pill { font-size: .75rem; padding: 8px 14px; }
    .test-google-hero { flex-direction: column; text-align: center; padding: 22px 26px; }
    .ghero-details { text-align: center; }
    .test-stats-row { flex-direction: column; }
    .test-stat { border-right: none; border-bottom: 1px solid #f0f0f0; }
    .test-stat:last-child { border-bottom: none; }
    .test-local-banner { flex-direction: column; text-align: center; padding: 30px 26px; }
    .test-local-copy { text-align: center; }
    .test-card { flex: 0 0 88%; }
    .test-carousel-wrapper { padding: 0 6px; }
    .test-carousel-arrow { width: 38px; height: 38px; font-size: .9rem; top: 40%; }
    .test-carousel-arrow.is-prev { left: -4px; }
    .test-carousel-arrow.is-next { right: -4px; }
  }
</style>

<div class="test-section" style="background-color: {{ section.settings.bg_color }};">

  <!-- HEADER -->
  <div class="test-header">

    {% if section.settings.eyebrow != blank %}
      <span class="test-eyebrow" style="background: {{ section.settings.eyebrow_bg }}; color: {{ section.settings.eyebrow_color }};">
        {{ section.settings.eyebrow }}
      </span>
    {% endif %}

    {% if section.settings.title != blank %}
      <h2 class="test-title" style="color: {{ section.settings.title_color }};">
        {{ section.settings.title }}
      </h2>
    {% endif %}

    <!-- Google rating hero (CRO: prueba social #1) -->
    {% if section.settings.google_link != blank %}
      <a href="{{ section.settings.google_link }}" target="_blank" rel="noopener nofollow" class="test-google-hero">
        <i class="fab fa-google ghero-icon"></i>
        <span class="ghero-score">{{ section.settings.google_score }}</span>
        <span class="ghero-details">
          <span class="ghero-stars">★★★★★</span>
          <span class="ghero-meta">{{ section.settings.google_reviews }} reseñas verificadas en Google</span>
          <span class="ghero-cta">{{ section.settings.google_cta_text | default: 'Ver todas las reseñas' }} →</span>
        </span>
      </a>
    {% endif %}

    <!-- Stats row: prueba social cuantificada -->
    {% if section.settings.show_stats %}
      <div class="test-stats-row">
        <div class="test-stat">
          <span class="test-stat-emoji">⭐</span>
          <span class="test-stat-num">{{ section.settings.google_score }}</span>
          <span class="test-stat-label">Calificación promedio</span>
        </div>
        <div class="test-stat">
          <span class="test-stat-emoji">💬</span>
          <span class="test-stat-num">{{ section.settings.google_reviews }}+</span>
          <span class="test-stat-label">Reseñas verificadas</span>
        </div>
        <div class="test-stat">
          <span class="test-stat-emoji">{{ section.settings.stat3_emoji }}</span>
          <span class="test-stat-num">{{ section.settings.stat3_number }}</span>
          <span class="test-stat-label">{{ section.settings.stat3_label }}</span>
        </div>
        <div class="test-stat">
          <span class="test-stat-emoji">{{ section.settings.stat4_emoji }}</span>
          <span class="test-stat-num">{{ section.settings.stat4_number }}</span>
          <span class="test-stat-label">{{ section.settings.stat4_label }}</span>
        </div>
      </div>
    {% endif %}

    <!-- Tag cloud: temas más mencionados por los clientes -->
    {% if section.settings.show_tags %}
      {% assign tags = section.blocks | where: "type", "tag" %}
      {% if tags.size > 0 %}
        {% if section.settings.tags_title != blank %}
          <p class="test-tags-title">{{ section.settings.tags_title }}</p>
        {% endif %}
        <div class="test-tags-cloud">
          {% for block in tags %}
            <span class="test-tag-chip" {{ block.shopify_attributes }}>
              {{ block.settings.emoji }} {{ block.settings.text }}
              {% if block.settings.count != blank %}
                <span class="tag-count">{{ block.settings.count }}</span>
              {% endif %}
            </span>
          {% endfor %}
        </div>
      {% endif %}
    {% endif %}

  </div>

  <!-- USP STRIP: PUNTOS CLAVE CON EMOJIS -->
  {% if section.settings.show_usp %}
    <div class="test-usp-strip">
      {% for block in section.blocks %}
        {% if block.type == 'usp' %}
          <span
            class="test-usp-pill"
            style="background: {{ block.settings.pill_bg }}; color: {{ block.settings.pill_color }};"
            {{ block.shopify_attributes }}
          >
            <span class="usp-emoji">{{ block.settings.emoji }}</span>
            {{ block.settings.text }}
          </span>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}

  <!-- BANNER NEGOCIO LOCAL (elemento distintivo, refuerza compra por comunidad) -->
  {% if section.settings.show_local_banner %}
    <div class="test-local-banner">
      <div class="test-local-stamp">{{ section.settings.local_banner_emoji | default: '🏘️' }}</div>
      <div class="test-local-copy">
        <h3>{{ section.settings.local_banner_title }}</h3>
        <p>{{ section.settings.local_banner_text }}</p>
        {% if section.settings.local_banner_author != blank %}
          <span class="local-quote-author">{{ section.settings.local_banner_author }}</span>
        {% endif %}
      </div>
    </div>
  {% endif %}

  <!-- CARRUSEL DE TESTIMONIOS -->
  {% assign testimonios = section.blocks | where: "type", "testimonio" %}
  {% assign total_testimonios = testimonios.size %}

  <div class="test-carousel-wrapper">

    {% if total_testimonios > 1 %}
      <button type="button" class="test-carousel-arrow is-prev" id="test-prev-{{ section.id }}" aria-label="Reseña anterior">
        <i class="fas fa-chevron-left"></i>
      </button>
    {% endif %}

    <div class="test-grid" id="test-grid-{{ section.id }}">
      {% for block in testimonios %}
        <div
          class="test-card"
          {{ block.shopify_attributes }}
          style="border-top: 4px solid {{ block.settings.accent_color }};"
        >

        <!-- Cabecera -->
        <div class="test-card-header">
          <div class="test-avatar" style="background: linear-gradient(135deg, {{ block.settings.accent_color }}, {{ block.settings.accent_color }}99);">
            {{ block.settings.name | slice: 0 | upcase }}
          </div>
          <div>
            <div class="test-card-name" style="color: {{ block.settings.name_color }};">{{ block.settings.name }}</div>
            {% if block.settings.location != blank %}
              <div class="test-card-meta">📍 {{ block.settings.location }}</div>
            {% endif %}
            <!-- Estrellas dinámicas -->
            <div class="test-stars-row">
              {% assign rating = block.settings.rating | plus: 0 %}
              {% for i in (1..5) %}
                {% if i <= rating %}
                  <i class="fas fa-star test-star"></i>
                {% else %}
                  <i class="fas fa-star test-star empty"></i>
                {% endif %}
              {% endfor %}
              {% if block.settings.is_local_guide %}
                <span class="test-guide-badge">✔️ {{ block.settings.guide_label | default: 'Local Guide' }}</span>
              {% endif %}
            </div>
          </div>
        </div>

        <!-- Keyword destacada CRO -->
        {% if block.settings.keyword != blank %}
          <span class="test-card-keyword">{{ block.settings.keyword }}</span>
        {% endif %}

        <!-- Texto -->
        <p class="test-card-text">"{{ block.settings.text }}"</p>

        <!-- Footer -->
        <div class="test-card-footer">
          <i class="fab fa-google g-dot"></i>
          <span>{{ block.settings.source_label | default: 'Reseña verificada en Google' }}</span>
          {% if block.settings.date_label != blank %}
            <span class="footer-sep">·</span>
            <span>{{ block.settings.date_label }}</span>
          {% endif %}
        </div>

      </div>
    {% endfor %}
    </div>

    {% if total_testimonios > 1 %}
      <button type="button" class="test-carousel-arrow is-next" id="test-next-{{ section.id }}" aria-label="Siguiente reseña">
        <i class="fas fa-chevron-right"></i>
      </button>
    {% endif %}

  </div>

  {% if section.settings.show_carousel_hint and total_testimonios > 1 %}
    <p class="test-carousel-hint">{{ section.settings.carousel_hint_text | default: 'Usa las flechas o desliza para leer todas las reseñas →' }}</p>
  {% endif %}

  <!-- CTA FINAL -->
  {% if section.settings.show_cta %}
    <div class="test-cta-block">
      {% if section.settings.cta_label != blank %}
        <p class="test-cta-label">{{ section.settings.cta_label }}</p>
      {% endif %}
      <a
        href="{{ section.settings.cta_link | default: '/collections/all' }}"
        class="test-cta-btn"
        style="background: {{ section.settings.cta_bg }}; color: {{ section.settings.cta_color }};"
      >
        {{ section.settings.cta_text }}
      </a>
    </div>
  {% endif %}

</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    (function () {
      var grid = document.getElementById('test-grid-{{ section.id }}');
      var prevBtn = document.getElementById('test-prev-{{ section.id }}');
      var nextBtn = document.getElementById('test-next-{{ section.id }}');
      if (!grid) return;

      function cardStep() {
        var card = grid.querySelector('.test-card');
        if (!card) return 320;
        var computed = window.getComputedStyle(grid);
        var gap = parseInt(computed.gap || computed.columnGap || '26', 10) || 26;
        return card.getBoundingClientRect().width + gap;
      }

      function updateArrows() {
        if (!prevBtn || !nextBtn) return;
        var maxScroll = grid.scrollWidth - grid.clientWidth;
        var atStart = grid.scrollLeft <= 1;
        var atEnd = grid.scrollLeft >= maxScroll - 1;
        prevBtn.style.opacity = atStart ? '0.35' : '1';
        prevBtn.style.pointerEvents = atStart ? 'none' : 'auto';
        nextBtn.style.opacity = atEnd ? '0.35' : '1';
        nextBtn.style.pointerEvents = atEnd ? 'none' : 'auto';
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', function () {
          grid.scrollBy({ left: -cardStep(), behavior: 'smooth' });
        });
      }
      if (nextBtn) {
        nextBtn.addEventListener('click', function () {
          grid.scrollBy({ left: cardStep(), behavior: 'smooth' });
        });
      }

