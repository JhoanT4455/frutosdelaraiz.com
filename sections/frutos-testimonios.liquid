<style>
  /* =============================================
     TESTIMONIOS GOOGLE - CRO + EDITABLE + USP
     ============================================= */

  .test-section {
    padding: 70px 5%;
    text-align: center;
  }

  /* ---- HEADER ---- */
  .test-header {
    margin-bottom: 50px;
  }

  .test-eyebrow {
    display: inline-block;
    font-family: 'Montserrat', sans-serif;
    font-size: .82rem;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    padding: 6px 18px;
    border-radius: 30px;
    margin-bottom: 15px;
  }

  .test-title {
    font-family: 'Amatic SC', cursive;
    font-size: 4.5rem;
    font-weight: 700;
    margin-bottom: 15px;
    line-height: 1;
  }

  /* Badge Google */
  .test-google-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: white;
    padding: 10px 22px;
    border-radius: 30px;
    box-shadow: 0 3px 14px rgba(0,0,0,0.08);
    font-family: 'Montserrat', sans-serif;
    font-size: .95rem;
    color: #333;
    font-weight: 700;
    text-decoration: none;
    transition: box-shadow 0.3s, transform 0.3s;
  }

  .test-google-badge:hover {
    box-shadow: 0 8px 24px rgba(0,0,0,0.13);
    transform: translateY(-2px);
  }

  .test-google-badge .g-icon  { color: #4285F4; font-size: 1.1rem; }
  .test-google-badge .g-stars { color: #FFC107; letter-spacing: 1px; }

  /* ---- USP STRIP (CRO) ---- */
  .test-usp-strip {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
    margin: 30px auto 50px;
    max-width: 900px;
  }

  .test-usp-pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 9px 20px;
    border-radius: 30px;
    font-family: 'Montserrat', sans-serif;
    font-size: .82rem;
    font-weight: 700;
    transition: transform 0.3s;
  }

  .test-usp-pill:hover { transform: translateY(-3px); }

  .test-usp-pill .usp-emoji { font-size: 1.1rem; }

  /* ---- GRID DE TESTIMONIOS ---- */
  .test-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 26px;
    max-width: 1200px;
    margin: 0 auto 50px;
  }

  .test-card {
    background: white;
    padding: 28px;
    border-radius: 16px;
    border: 1px solid #e8f5e9;
    box-shadow: 0 5px 18px rgba(0,0,0,0.05);
    display: flex;
    flex-direction: column;
    text-align: left;
    position: relative;
    transition: transform 0.35s cubic-bezier(0.175,0.885,0.32,1.275), box-shadow 0.3s;
  }

  .test-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 14px 35px rgba(27,94,32,0.1);
  }

  /* Comilla decorativa */
  .test-card::before {
    content: '\201C';
    font-family: Georgia, serif;
    font-size: 7rem;
    position: absolute;
    top: -8px;
    right: 16px;
    line-height: 1;
    pointer-events: none;
    opacity: .07;
  }

  /* Cabecera: avatar + nombre + estrellas */
  .test-card-header {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 15px;
  }

  .test-avatar {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Montserrat', sans-serif;
    font-weight: 700;
    font-size: 1.25rem;
    color: white;
    flex-shrink: 0;
  }

  .test-card-name {
    font-family: 'Montserrat', sans-serif;
    font-size: 1rem;
    font-weight: 700;
    margin: 0 0 4px;
  }

  .test-card-meta {
    font-family: 'Lato', sans-serif;
    font-size: .78rem;
    color: #aaa;
    margin-bottom: 2px;
  }

  /* Estrellas */
  .test-stars-row {
    display: flex;
    gap: 2px;
  }

  .test-star { color: #FFC107; font-size: .88rem; }
  .test-star.empty { color: #ddd; }

  /* Texto de la reseña */
  .test-card-text {
    font-family: 'Lato', sans-serif;
    color: #555;
    line-height: 1.75;
    font-size: .98rem;
    flex-grow: 1;
    font-style: italic;
    margin-bottom: 18px;
  }

  /* CRO: keyword destacada en la reseña */
  .test-card-keyword {
    display: inline-block;
    background: #f1f8e9;
    color: #2E7D32;
    font-family: 'Montserrat', sans-serif;
    font-size: .72rem;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 10px;
    margin-bottom: 14px;
  }

  /* Footer: fuente */
  .test-card-footer {
    display: flex;
    align-items: center;
    gap: 7px;
    font-family: 'Lato', sans-serif;
    font-size: .8rem;
    color: #bbb;
    border-top: 1px solid #f5f5f5;
    padding-top: 14px;
    margin-top: auto;
  }

  .test-card-footer .g-dot { color: #4285F4; }

  /* ---- CTA FINAL ---- */
  .test-cta-block {
    text-align: center;
  }

  .test-cta-label {
    font-family: 'Lato', sans-serif;
    font-size: 1.05rem;
    color: #666;
    margin-bottom: 20px;
  }

  .test-cta-btn {
    display: inline-block;
    padding: 15px 45px;
    border-radius: 50px;
    font-family: 'Montserrat', sans-serif;
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.3s;
    box-shadow: 0 4px 15px rgba(0,0,0,0.15);
  }

  .test-cta-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 28px rgba(0,0,0,0.18);
  }

  /* ---- RESPONSIVE ---- */
  @media (max-width: 768px) {
    .test-title { font-size: 3.5rem; }
    .test-grid { grid-template-columns: 1fr; }
    .test-usp-strip { gap: 8px; }
    .test-usp-pill { font-size: .75rem; padding: 8px 14px; }
  }
</style>

<div class="test-section" style="background-color: {{ section.settings.bg_color }};">

  <!-- HEADER -->
  <div class="test-header">

    {% if section.settings.eyebrow != blank %}
      <span class="test-eyebrow" style="background: {{ section.settings.eyebrow_bg }}; color: {{ section.settings.eyebrow_color }};">
        {{ section.settings.eyebrow }}
      </span>
    {% endif %}

    {% if section.settings.title != blank %}
      <h2 class="test-title" style="color: {{ section.settings.title_color }};">
        {{ section.settings.title }}
      </h2>
    {% endif %}

    <!-- Badge de Google editable -->
    {% if section.settings.google_link != blank %}
      <a href="{{ section.settings.google_link }}" target="_blank" rel="noopener" class="test-google-badge">
        <i class="fab fa-google g-icon"></i>
        <span class="g-stars">★★★★★</span>
        {{ section.settings.google_score }} de 5 &nbsp;·&nbsp; {{ section.settings.google_reviews }} reseñas en Google
      </a>
    {% endif %}

  </div>

  <!-- USP STRIP: PUNTOS CLAVE CON EMOJIS -->
  {% if section.settings.show_usp %}
    <div class="test-usp-strip">
      {% for block in section.blocks %}
        {% if block.type == 'usp' %}
          <span
            class="test-usp-pill"
            style="background: {{ block.settings.pill_bg }}; color: {{ block.settings.pill_color }};"
            {{ block.shopify_attributes }}
          >
            <span class="usp-emoji">{{ block.settings.emoji }}</span>
            {{ block.settings.text }}
          </span>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}

  <!-- GRID DE TESTIMONIOS -->
  <div class="test-grid">
    {% for block in section.blocks %}
      {% if block.type == 'testimonio' %}
        <div class="test-card" {{ block.shopify_attributes }} style="border-top: 4px solid {{ block.settings.accent_color }};">

          <!-- Cabecera -->
          <div class="test-card-header">
            <div class="test-avatar" style="background: linear-gradient(135deg, {{ block.settings.accent_color }}, {{ block.settings.accent_color }}99);">
              {{ block.settings.name | slice: 0 | upcase }}
            </div>
            <div>
              <div class="test-card-name" style="color: {{ block.settings.name_color }};">{{ block.settings.name }}</div>
              {% if block.settings.location != blank %}
                <div class="test-card-meta">📍 {{ block.settings.location }}</div>
              {% endif %}
              <!-- Estrellas dinámicas -->
              <div class="test-stars-row">
                {% assign rating = block.settings.rating | plus: 0 %}
                {% for i in (1..5) %}
                  {% if i <= rating %}
                    <i class="fas fa-star test-star"></i>
                  {% else %}
                    <i class="fas fa-star test-star empty"></i>
                  {% endif %}
                {% endfor %}
              </div>
            </div>
          </div>

          <!-- Keyword destacada CRO -->
          {% if block.settings.keyword != blank %}
            <span class="test-card-keyword">{{ block.settings.keyword }}</span>
          {% endif %}

          <!-- Texto -->
          <p class="test-card-text">"{{ block.settings.text }}"</p>

          <!-- Footer -->
          <div class="test-card-footer">
            <i class="fab fa-google g-dot"></i>
            {{ block.settings.source_label | default: 'Reseña verificada en Google' }}
          </div>

        </div>
      {% endif %}
    {% endfor %}
  </div>

  <!-- CTA FINAL -->
  {% if section.settings.show_cta %}
    <div class="test-cta-block">
      {% if section.settings.cta_label != blank %}
        <p class="test-cta-label">{{ section.settings.cta_label }}</p>
      {% endif %}
      <a
        href="{{ section.settings.cta_link | default: '/collections/all' }}"
        class="test-cta-btn"
        style="background: {{ section.settings.cta_bg }}; color: {{ section.settings.cta_color }};"
      >
        {{ section.settings.cta_text }}
      </a>
    </div>
  {% endif %}

</div>

{% schema %}
