{%- style -%}
.frc-article {
  --frc-green: {{ section.settings.accent_color | default: '#1B5E20' }};
  --frc-lime: #76FF03;
  --frc-yellow: #FFC107;
  --frc-cream: {{ section.settings.bg_color | default: '#F1F8E9' }};
  --frc-max: {{ section.settings.max_width | default: 800 }}px;
  font-family: 'Lato', sans-serif;
  color: #333;
  background: var(--frc-cream);
  line-height: 1.75;
}
.frc-article * { box-sizing: border-box; }

.frc-article__hero {
  background: linear-gradient(135deg, {{ section.settings.hero_from | default: '#1B5E20' }}, {{ section.settings.hero_to | default: '#2E7D32' }});
  padding: clamp(40px, 6vw, 56px) 24px 0;
}
.frc-article__hero-inner {
  max-width: var(--frc-max);
  margin: 0 auto;
  text-align: center;
}
.frc-article__back {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: rgba(255,255,255,0.85);
  text-decoration: none;
  font-family: 'Montserrat', sans-serif;
  font-size: 0.85rem;
  font-weight: 600;
  margin-bottom: 20px;
}
.frc-article__back:hover { color: var(--frc-lime); }
.frc-article__tag {
  display: inline-block;
  background: var(--frc-yellow);
  color: #5d4037;
  font-family: 'Montserrat', sans-serif;
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  padding: 5px 12px;
  border-radius: 20px;
  margin-bottom: 14px;
}
.frc-article__title {
  font-family: 'Amatic SC', cursive;
  font-size: clamp(40px, 6vw, 64px);
  color: #fff;
  margin: 0 0 12px;
  font-weight: 700;
  line-height: 1.05;
}
.frc-article__meta {
  color: rgba(255,255,255,0.8);
  font-size: 0.9rem;
  margin-bottom: 28px;
}
.frc-article__featured {
  max-width: min(var(--frc-max), 1000px);
  margin: 0 auto;
  border-radius: 16px 16px 0 0;
  overflow: hidden;
  box-shadow: 0 -4px 24px rgba(0,0,0,0.08);
}
.frc-article__featured img {
  width: 100%;
  height: auto;
  display: block;
  max-height: 420px;
  object-fit: cover;
}

.frc-article__body {
  max-width: var(--frc-max);
  margin: 0 auto;
  padding: 40px 24px 56px;
  background: #fff;
  border-radius: 0 0 16px 16px;
  box-shadow: 0 8px 32px rgba(27,94,32,0.08);
}
.frc-article__content {
  font-size: 1.08rem;
}
.frc-article__content h2,
.frc-article__content h3 {
  font-family: 'Montserrat', sans-serif;
  color: var(--frc-green);
  margin: 1.6em 0 0.6em;
}
.frc-article__content p { margin: 0 0 1.2em; }
.frc-article__content img {
  max-width: 100%;
  height: auto;
  border-radius: 12px;
  margin: 1.5em 0;
}
.frc-article__content a {
  color: var(--frc-green);
  font-weight: 700;
}
.frc-article__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 32px;
  padding-top: 24px;
  border-top: 1px dashed rgba(27,94,32,0.2);
}
.frc-article__tag-pill {
  padding: 6px 14px;
  border-radius: 20px;
  background: var(--frc-cream);
  color: var(--frc-green);
  font-size: 0.8rem;
  font-weight: 600;
  text-decoration: none;
  border: 1px solid rgba(27,94,32,0.2);
}
.frc-article__tag-pill:hover { background: var(--frc-green); color: #fff; }

.frc-article__related {
  max-width: var(--frc-max);
  margin: 0 auto;
  padding: 48px 24px 64px;
}
.frc-article__related-title {
  font-family: 'Amatic SC', cursive;
  font-size: 2.5rem;
  color: var(--frc-green);
  text-align: center;
  margin: 0 0 28px;
  font-weight: 700;
}
.frc-article__related-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}
.frc-article__related-card {
  background: #fff;
  border-radius: 14px;
  overflow: hidden;
  text-decoration: none;
  color: inherit;
  border: 1px dashed rgba(93,64,55,0.25);
  transition: transform 0.2s;
}
.frc-article__related-card:hover { transform: translateY(-4px); }
.frc-article__related-img {
  height: 140px;
  background: #e8f5e9;
  overflow: hidden;
}
.frc-article__related-img img { width: 100%; height: 100%; object-fit: cover; }
.frc-article__related-body { padding: 16px; }
.frc-article__related-name {
  font-family: 'Montserrat', sans-serif;
  font-size: 0.95rem;
  font-weight: 700;
  color: var(--frc-green);
  margin: 0;
  line-height: 1.35;
}

.frc-article__cta-wrap {
  text-align: center;
  padding: 0 24px 56px;
}
.frc-article__cta {
  display: inline-block;
  padding: 16px 36px;
  background: var(--frc-lime);
  color: #1b3600;
  font-family: 'Montserrat', sans-serif;
  font-weight: 700;
  text-decoration: none;
  border-radius: 50px;
  transition: background 0.2s;
}
.frc-article__cta:hover { background: var(--frc-yellow); }

  .frc-article__comment-section {
    max-width: var(--frc-max);
    margin: 0 auto;
    padding: 48px 24px 64px;
  }
  .frc-article__comment-count {
    font-family: 'Amatic SC', cursive;
    font-size: 2.2rem;
    color: var(--frc-green);
    margin: 0 0 28px;
    font-weight: 700;
  }
  .frc-article__comment-count span { color: #9E9E9E; font-size: 1.4rem; }

  /* ── Lista de comentarios ── */
  .frc-article__comment-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 40px;
  }
  .frc-article__comment-item {
    background: #fff;
    border-radius: 16px;
    padding: 24px 28px;
    border: 1px dashed rgba(27,94,32,0.2);
    box-shadow: 0 2px 8px rgba(27,94,32,0.04);
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .frc-article__comment-item:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(27,94,32,0.08);
  }
  .frc-article__comment-item--new {
    border: 2px solid var(--frc-green);
    background: #f0f9f0;
    animation: frc-comment-pop 0.5s ease;
  }
  .frc-article__comment-item--pending {
    opacity: 0.7;
    border-style: dotted;
  }
  .frc-article__comment-item--pending::before {
    content: '🕒 En revisión';
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--frc-green);
    background: var(--frc-cream);
    padding: 3px 10px;
    border-radius: 20px;
    margin-bottom: 8px;
  }
  @keyframes frc-comment-pop {
    0% { transform: scale(0.95); opacity: 0; }
    50% { transform: scale(1.02); }
    100% { transform: scale(1); opacity: 1; }
  }
  .frc-article__comment-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }
  .frc-article__comment-avatar {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--frc-green), var(--frc-lime));
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Montserrat', sans-serif;
    font-weight: 700;
    font-size: 1.1rem;
    flex-shrink: 0;
  }
  .frc-article__comment-meta {
    flex: 1;
  }
  .frc-article__comment-author {
    font-family: 'Montserrat', sans-serif;
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--frc-green);
    margin: 0;
  }
  .frc-article__comment-date {
    font-size: 0.8rem;
    color: #9E9E9E;
    margin: 2px 0 0;
  }
  .frc-article__comment-body {
    font-size: 1rem;
    line-height: 1.7;
    color: #444;
    margin: 0;
    padding-left: 54px;
  }
  .frc-article__comment-body a { color: var(--frc-green); font-weight: 700; }

  /* ── Formulario de comentarios ── */
  .frc-article__comment-form-wrap {
    background: #fff;
    border-radius: 20px;
    padding: 36px 32px;
    border: 1px dashed rgba(27,94,32,0.2);
    box-shadow: 0 4px 20px rgba(27,94,32,0.06);
  }
  .frc-article__comment-form-title {
    font-family: 'Amatic SC', cursive;
    font-size: 2rem;
    color: var(--frc-green);
    margin: 0 0 8px;
    font-weight: 700;
  }
  .frc-article__comment-form-subtitle {
    font-size: 0.95rem;
    color: #888;
    margin: 0 0 24px;
  }
  .frc-article__comment-form {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .frc-article__comment-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .frc-article__comment-field label {
    font-family: 'Montserrat', sans-serif;
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--frc-green);
    text-transform: uppercase;
    letter-spacing: 0.4px;
  }
  .frc-article__comment-field input,
  .frc-article__comment-field textarea {
    font-family: 'Lato', sans-serif;
    font-size: 1rem;
    padding: 14px 18px;
    border: 2px solid #e0e0e0;
    border-radius: 12px;
    background: #fafafa;
    color: #333;
    transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
    outline: none;
  }
  .frc-article__comment-field input:focus,
  .frc-article__comment-field textarea:focus {
    border-color: var(--frc-green);
    background: #fff;
    box-shadow: 0 0 0 4px rgba(27,94,32,0.08);
  }
  .frc-article__comment-field textarea {
    min-height: 120px;
    resize: vertical;
    line-height: 1.6;
  }
  .frc-article__comment-field--error input,
  .frc-article__comment-field--error textarea {
    border-color: #E53935;
    background: #fff5f5;
  }
  .frc-article__comment-field--error .frc-article__comment-error {
    display: block;
  }
  .frc-article__comment-error {
    display: none;
    color: #E53935;
    font-size: 0.85rem;
    font-weight: 600;
  }
  .frc-article__comment-submit {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 16px 36px;
    background: var(--frc-green);
    color: #fff;
    font-family: 'Montserrat', sans-serif;
    font-weight: 700;
    font-size: 1rem;
    border: none;
    border-radius: 50px;
    cursor: pointer;
    transition: background 0.2s, transform 0.1s, box-shadow 0.2s;
    box-shadow: 0 4px 16px rgba(27,94,32,0.3);
  }
  .frc-article__comment-submit:hover {
    background: #2E7D32;
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(27,94,32,0.4);
  }
  .frc-article__comment-submit:active {
    transform: translateY(0);
  }
  .frc-article__comment-success {
    background: #e8f5e9;
    border: 2px solid #4CAF50;
    border-radius: 16px;
    padding: 20px 24px;
    color: #1B5E20;
    font-weight: 600;
    font-size: 1rem;
    margin-bottom: 24px;
    animation: frc-comment-pop 0.4s ease;
  }
  .frc-article__comment-success strong {
    display: block;
    font-family: 'Montserrat', sans-serif;
    font-size: 1.1rem;
    margin-bottom: 4px;
  }
  .frc-article__comment-form-errors {
    background: #FDEDEC;
    border: 2px solid #E53935;
    border-radius: 16px;
    padding: 16px 20px;
    color: #C62828;
    font-size: 0.95rem;
    font-weight: 600;
    margin-bottom: 20px;
  }
  .frc-article__comment-form-errors ul {
    margin: 8px 0 0 18px;
    padding: 0;
  }
  .frc-article__comment-form-errors li { margin-bottom: 4px; }

  @media (max-width: 768px) {
    .frc-article__comment-section { padding: 32px 16px 48px; }
    .frc-article__comment-form-wrap { padding: 28px 20px; }
    .frc-article__comment-body { padding-left: 0; }
    .frc-article__comment-item { padding: 20px; }
  }

@media (max-width: 768px) {
  .frc-article__related-grid { grid-template-columns: 1fr; }
}
{%- endstyle -%}

<article class="frc-article">
  <header class="frc-article__hero">
    <div class="frc-article__hero-inner">
      <a href="{{ blog.url }}" class="frc-article__back">← Volver al blog</a>
      {%- if article.tags.size > 0 -%}
        <span class="frc-article__tag">{{ article.tags.first }}</span>
      {%- endif -%}
      <h1 class="frc-article__title">{{ article.title }}</h1>
      <p class="frc-article__meta">{{ article.published_at | date: '%d de %B, %Y' }}</p>
    </div>
    {%- if article.image -%}
      <div class="frc-article__featured">
        {{ article.image | image_url: width: 1200 | image_tag: loading: 'eager', alt: article.title }}
      </div>
    {%- endif -%}
  </header>

  <div class="frc-article__body">
    <div class="frc-article__content rte">
      {{ article.content }}
    </div>
    {%- if article.tags.size > 0 -%}
      <div class="frc-article__tags">
        {%- for tag in article.tags -%}
          <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="frc-article__tag-pill">{{ tag }}</a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  {%- if section.settings.show_related -%}
    {%- assign related_count = 0 -%}
    <section class="frc-article__related" aria-labelledby="related-posts-title">
      <h2 id="related-posts-title" class="frc-article__related-title">{{ section.settings.related_title | default: 'Más artículos' }}</h2>
      <div class="frc-article__related-grid">
        {%- for related in blog.articles -%}
          {%- if related.id != article.id and related_count < 3 -%}
            <a href="{{ related.url }}" class="frc-article__related-card">
              <div class="frc-article__related-img">
                {%- if related.image -%}
                  {{ related.image | image_url: width: 400 | image_tag: loading: 'lazy', alt: related.title }}
                {%- endif -%}
              </div>
              <div class="frc-article__related-body">
                <p class="frc-article__related-name">{{ related.title }}</p>
              </div>
            </a>
            {%- assign related_count = related_count | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}

  {%- if section.settings.cta_text != blank -%}
    <div class="frc-article__cta-wrap">
      <a href="{{ section.settings.cta_link | default: routes.collections_url }}" class="frc-article__cta">{{ section.settings.cta_text }}</a>
    </div>
  {%- endif -%}
  {%- if section.settings.show_comments and blog.comments_enabled? -%}
    <section class="frc-article__comment-section" id="comments">
      <h2 class="frc-article__comment-count">
        💬 Comentarios
        {%- if article.comments_count > 0 -%}
          <span>({{ article.comments_count }})</span>
        {%- endif -%}
      </h2>

      {%- comment -%} === Lista de comentarios === {%- endcomment -%}
      {%- if article.comments_count > 0 -%}
        <div class="frc-article__comment-list">
          {%- for comment in article.comments -%}
            {%- assign is_new = false -%}
            {%- if comment.id == new_comment.id -%}{%- assign is_new = true -%}{%- endif -%}
            <div class="frc-article__comment-item {%- if is_new %} frc-article__comment-item--new{% endif -%} {%- if comment.status == 'pending' %} frc-article__comment-item--pending{% endif -%}" id="comment-{{ comment.id }}">
              <div class="frc-article__comment-header">
                <div class="frc-article__comment-avatar">
                  {{ comment.author | slice: 0, 1 | upcase }}
                </div>
                <div class="frc-article__comment-meta">
                  <p class="frc-article__comment-author">{{ comment.author }}</p>
                  <p class="frc-article__comment-date">{{ comment.created_at | date: '%d de %B de %Y, %H:%M' }}</p>
                </div>
              </div>
              <p class="frc-article__comment-body">{{ comment.content }}</p>
            </div>
          {%- endfor -%}
        </div>
      {%- else -%}
        <p style="color:#888; font-size:1rem; margin-bottom:32px;">Sé el primero en dejar un comentario 🌿</p>
      {%- endif -%}

      {%- comment -%} === Formulario de comentarios === {%- endcomment -%}
      <div class="frc-article__comment-form-wrap" id="comment-form">
        <h3 class="frc-article__comment-form-title">Dejar un comentario</h3>
        <p class="frc-article__comment-form-subtitle">Tu opinión nos ayuda a crecer. ¡Comparte tus ideas!</p>

        {%- if form.posted_successfully? -%}
          <div class="frc-article__comment-success">
            <strong>✅ ¡Gracias por tu comentario!</strong>
            {%- if blog.moderated? -%}
              Tu mensaje está en revisión y aparecerá pronto.
            {%- else -%}
              Tu mensaje ya está publicado.
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- form 'new_comment', article -%}
          {%- if form.errors -%}
            <div class="frc-article__comment-form-errors">
              ⚠️ Hubo un error al enviar tu comentario:
              <ul>
                {%- for field in form.errors -%}
                  <li>{{ field | capitalize }} — {{ form.errors.messages[field] }}</li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          <div class="frc-article__comment-form">
            <div class="frc-article__comment-field {%- if form.errors contains 'author' %} frc-article__comment-field--error{% endif -%}">
              <label for="comment-author">Nombre</label>
              <input
                type="text"
                id="comment-author"
                name="comment[author]"
                placeholder="Tu nombre"
                value="{{ form.author }}"
                required
                autocomplete="name"
              >
              <span class="frc-article__comment-error">Por favor, ingresa tu nombre.</span>
            </div>

            <div class="frc-article__comment-field {%- if form.errors contains 'email' %} frc-article__comment-field--error{% endif -%}">
              <label for="comment-email">Correo electrónico</label>
              <input
                type="email"
                id="comment-email"
                name="comment[email]"
                placeholder="tu@email.com"
                value="{{ form.email }}"
                required
                autocomplete="email"
              >
              <span class="frc-article__comment-error">Por favor, ingresa un correo válido.</span>
            </div>

            <div class="frc-article__comment-field {%- if form.errors contains 'body' %} frc-article__comment-field--error{% endif -%}">
              <label for="comment-body">Comentario</label>
              <textarea
                id="comment-body"
                name="comment[body]"
                placeholder="¿Qué te pareció este artículo? Comparte tu experiencia..."
                required
              >{{ form.body }}</textarea>
              <span class="frc-article__comment-error">Por favor, escribe un comentario.</span>
            </div>

            <button type="submit" class="frc-article__comment-submit">
              🚀 Enviar comentario
            </button>
          </div>
        {%- endform -%}
      </div>
    </section>
  {%- endif -%}

</article>

{% schema %}
{
  "name": "Artículo Blog Frutos",
  "tag": "section",
  "class": "frc-article-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_comments",
      "label": "Mostrar sección de comentarios",
      "default": true,
      "info": "Requiere que los comentarios estén activados en el blog de Shopify."
    },
    {
      "type": "paragraph",
      "content": "Muestra el artículo actual del blog de Shopify (objeto article)."
    },
    {
      "type": "checkbox",
      "id": "show_related",
      "label": "Mostrar artículos relacionados",
      "default": true
    },
    {
      "type": "text",
      "id": "related_title",
      "label": "Título sección relacionados",
      "default": "Sigue leyendo"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Texto CTA",
      "default": "🛒 Ver productos naturales"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Link CTA"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Color acento",
      "default": "#1B5E20"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Fondo página",
      "default": "#F1F8E9"
    },
    {
      "type": "color",
      "id": "hero_from",
      "label": "Hero gradiente inicio",
      "default": "#1B5E20"
    },
    {
      "type": "color",
      "id": "hero_to",
      "label": "Hero gradiente fin",
      "default": "#2E7D32"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Ancho máximo contenido",
      "min": 640,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "default": 800
    }
  ],
  "presets": [
    {
      "name": "Artículo Blog Frutos"
    }
  ]
}
{% endschema %}
