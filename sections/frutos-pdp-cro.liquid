{%- javascript -%}
/* ═══════════════════════════════════════════
   FRC PDP FINAL — JavaScript
   TODAS las funciones con onclick inline
   estan en scope GLOBAL (fuera del IIFE)
   para garantizar que siempre existan.
   ═══════════════════════════════════════════ */

/* ====== FUNCIONES GLOBALES (scope window) ======
   Se llaman desde onclick="..." inline en el HTML.
   DEBEN existir siempre, sin depender del IIFE. */

/* ── Helpers ── */
window.frcFormatMoney = function(cents) {
  var val = (cents / 100).toFixed(0);
  return '$' + parseInt(val).toLocaleString('es-CO');
};

/* ── Encontrar el container .frc-pdp-final activo ── */
window.frcGetContainer = function(fromEl) {
  if (fromEl) {
    var c = fromEl.closest('.frc-pdp-final');
    if (c) return c;
  }
  return document.querySelector('.frc-pdp-final');
};

/* ── 1. fcToast ── */
window.fcToast = function(msg, isError) {
  var toast = document.getElementById('frc-toast');
  if (!toast) return;
  toast.textContent = msg;
  toast.className = 'frc-toast frc-toast--' + (isError ? 'error' : 'success');
  requestAnimationFrame(function() {
    toast.classList.add('is-visible');
  });
  setTimeout(function() {
    toast.classList.remove('is-visible');
  }, 3200);
};

/* ── 2. fcAddCart ── */
window.fcAddCart = function(variantId, qty) {
  qty = parseInt(qty) || 1;
  variantId = parseInt(variantId) || 0;
  if (!variantId) {
    window.fcToast('Selecciona una variante', true);
    return;
  }
  var btn = document.querySelector('[data-frc-add]');
  if (btn) {
    btn.classList.add('is-loading');
    btn.disabled = true;
  }

  fetch('/cart/add.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    credentials: 'same-origin',
    body: JSON.stringify({ id: variantId, quantity: qty })
  })
  .then(function(r) {
    if (!r.ok) {
      return r.json().then(function(err) {
        throw new Error(err.description || err.message || 'Error al anadir');
      });
    }
    return r.json();
  })
  .then(function() {
    if (btn) {
      btn.classList.remove('is-loading');
      btn.classList.add('is-success');
      setTimeout(function() {
        btn.classList.remove('is-success');
        btn.disabled = false;
      }, 1800);
    }
    window.fcToast('Producto anadido al carrito');
    document.dispatchEvent(new CustomEvent('cart:refresh'));
    window.location.href = '/cart';
  })
  .catch(function(err) {
    if (btn) {
      btn.classList.remove('is-loading');
      btn.disabled = false;
    }
    window.fcToast(err.message || 'Error al anadir al carrito', true);
    console.error('[FRC PDP] Add to cart error:', err);
  });
};

/* ── 3. fcQty ── */
window.fcQty = function(action) {
  var input = document.querySelector('[data-frc-qty]');
  if (!input) return;
  var val = parseInt(input.value) || 1;
  if (action === 'plus') {
    val++;
  } else if (action === 'minus' && val > 1) {
    val--;
  }
  input.value = val;
};

/* ── 4. fcTabs ── */
window.fcTabs = function(tabId) {
  var container = window.frcGetContainer();
  if (!container) return;
  container.querySelectorAll('.frc-tabs__btn').forEach(function(btn) {
    var isActive = btn.dataset.tab === tabId;
    btn.classList.toggle('is-active', isActive);
    btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
  });
  container.querySelectorAll('.frc-tabs__panel').forEach(function(panel) {
    panel.classList.toggle('is-active', panel.id === 'tab-' + tabId);
  });
};

/* ── 5. fcFaq ── */
window.fcFaq = function(btn) {
  var item = btn.closest('[data-faq-item]');
  if (!item) return;
  var isOpen = item.classList.contains('is-open');
  document.querySelectorAll('[data-faq-item]').forEach(function(i) {
    i.classList.remove('is-open');
  });
  if (!isOpen) item.classList.add('is-open');
};

/* ── 6. fcGallery ── */
window.fcGallery = function(direction, index) {
  var container = window.frcGetContainer();
  if (!container) return;
  var imgs = container.querySelectorAll('[data-gallery-img]');
  var total = imgs.length;
  if (total <= 1) return;

  var state = container.dataset;
  var current = parseInt(state.imgIndex) || 0;

  if (direction === 'go') current = index;
  else if (direction === 'next') current = (current + 1) % total;
  else if (direction === 'prev') current = (current - 1 + total) % total;

  state.imgIndex = current;

  imgs.forEach(function(img, idx) {
    img.classList.toggle('is-active', idx === current);
  });
  container.querySelectorAll('[data-gallery-thumbs] .frc-gallery__thumb').forEach(function(t, idx) {
    t.classList.toggle('is-active', idx === current);
  });
  container.querySelectorAll('[data-gallery-dots] .frc-gallery__dot').forEach(function(d, idx) {
    d.classList.toggle('is-active', idx === current);
  });
  var prevBtn = container.querySelector('.frc-gallery__arrow--prev');
  var nextBtn = container.querySelector('.frc-gallery__arrow--next');
  if (prevBtn) prevBtn.disabled = current === 0;
  if (nextBtn) nextBtn.disabled = current === total - 1;
};

/* ── 7. fcZoom ── */
window.fcZoom = function() {
  var container = window.frcGetContainer();
  if (!container) return;
  var overlay = container.querySelector('[data-zoom-overlay]');
  var activeImg = container.querySelector('[data-gallery-img].is-active');
  if (!overlay) return;
  var isOpen = overlay.classList.contains('is-open');
  if (isOpen) {
    overlay.classList.remove('is-open');
    document.body.style.overflow = '';
  } else {
    var zoomImg = overlay.querySelector('[data-zoom-img]');
    if (zoomImg && activeImg) zoomImg.src = activeImg.src;
    overlay.classList.add('is-open');
    document.body.style.overflow = 'hidden';
  }
};

/* ── 8. fcSelectVariant ── */
window.fcSelectVariant = function(variantId) {
  variantId = parseInt(variantId);
  if (!variantId) return;
  var container = window.frcGetContainer();
  if (!container) return;

  var variantBtn = container.querySelector('.frc-variant__btn[data-variant-id="' + variantId + '"]');
  var variantData = variantBtn ? variantBtn.dataset : null;

  if (!variantData) {
    var opt = container.querySelector('.frc-variant__select option[value="' + variantId + '"]');
    if (opt) {
      variantData = opt.dataset;
      var sel = container.querySelector('[data-variant-select]');
      if (sel) sel.value = variantId;
    }
  }
  if (!variantData) return;

  // Botones visuales
  container.querySelectorAll('.frc-variant__btn').forEach(function(b) {
    b.classList.toggle('is-selected', parseInt(b.dataset.variantId) === variantId);
  });

  // Precios
  var price = parseInt(variantData.variantPrice);
  var compare = parseInt(variantData.variantCompare) || 0;
  var available = variantData.variantAvailable === 'true';
  var imageUrl = variantData.variantImage || '';

  container.querySelectorAll('[data-frc-price], [data-frc-price-mobile]').forEach(function(el) {
    el.textContent = window.frcFormatMoney(price);
  });

  var compareEl = container.querySelector('[data-frc-compare]');
  if (compareEl) {
    if (compare > price) {
      compareEl.textContent = window.frcFormatMoney(compare);
      compareEl.style.display = '';
    } else {
      compareEl.style.display = 'none';
    }
  }

  // Boton add-to-cart
  var addBtn = container.querySelector('[data-frc-add]');
  if (addBtn) {
    if (available) {
      addBtn.disabled = false;
      addBtn.style.opacity = '';
      addBtn.style.cursor = '';
      var svgCart = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>';
      addBtn.querySelector('.frc-btn__text').innerHTML = svgCart + ' Anadir al carrito';
      addBtn.dataset.variantId = variantId;
    } else {
      addBtn.disabled = true;
      addBtn.style.opacity = '0.5';
      addBtn.style.cursor = 'not-allowed';
      addBtn.querySelector('.frc-btn__text').textContent = 'Agotado';
    }
  }

  // Imagen si aplica
  if (imageUrl) {
    container.querySelectorAll('[data-gallery-img]').forEach(function(img, idx) {
      if (img.src === imageUrl || img.src.indexOf(imageUrl.split('?')[0]) !== -1) {
        window.fcGallery('go', idx);
      }
    });
  }
};

/* ====== IIFE: Solo inicializacion ====== */
(function() {
  'use strict';

  var container = document.querySelector('.frc-pdp-final');
  if (!container) return;

  // Estado de galeria guardado en data attributes
  container.dataset.imgIndex = '0';

  var productImages = container.querySelectorAll('[data-gallery-img]');
  var totalImages = productImages.length;

  // Inicializar primera imagen como activa
  if (productImages.length > 0) {
    productImages[0].classList.add('is-active');
  }

  /* ── Sticky bar movil ── */
  function initMobileBar() {
    var mobileBar = container.querySelector('[data-mobile-bar]');
    if (!mobileBar) return;
    var mainEl = container.querySelector('.frc-pdp-final__main');
    if (!mainEl) return;

    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        mobileBar.classList.toggle('is-visible', !entry.isIntersecting);
      });
    }, { threshold: 0, rootMargin: '-100px 0px 0px 0px' });

    observer.observe(mainEl);
  }

  /* ── Teclado para galeria (Escape cierra zoom) ── */
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      var overlay = document.querySelector('[data-zoom-overlay].is-open');
      if (overlay) window.fcZoom();
    }
  });

  /* ── Touch swipe para galeria mobile ── */
  var stage = container.querySelector('[data-gallery-stage]');
  if (stage && totalImages > 1) {
    var startX = 0;
    stage.addEventListener('touchstart', function(e) {
      startX = e.touches[0].clientX;
    }, { passive: true });
    stage.addEventListener('touchend', function(e) {
      var diff = startX - e.changedTouches[0].clientX;
      if (Math.abs(diff) > 50) {
        window.fcGallery(diff > 0 ? 'next' : 'prev');
      }
    }, { passive: true });
  }

  /* ── Inicializar barra movil ── */
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMobileBar);
  } else {
    initMobileBar();
  }

})();
{%- endjavascript -%}

