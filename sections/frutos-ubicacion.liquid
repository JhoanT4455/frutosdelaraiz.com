      "default": "Lunes a Sábado: 9:00 am - 7:00 pm"
    },
    {
      "type": "text",
      "id": "hours2",
      "label": "Horario adicional (vacío para ocultar)"
    },
    {
      "type": "text",
      "id": "phone_emoji",
      "label": "Emoji teléfono",
      "default": "📱"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Teléfono / WhatsApp",
      "default": "3027045952"
    },
    {
      "type": "text",
      "id": "extra_emoji",
      "label": "Emoji detalle extra",
      "default": "🏪"
    },
    {
      "type": "text",
      "id": "extra_detail",
      "label": "Detalle extra (vacío para ocultar)"
    },
    {
      "type": "header",
      "content": "🔘 Botones CTA"
    },
    {
      "type": "text",
      "id": "btn_emoji",
