    },
    {
      "type": "color",
      "id": "btn_bg",
      "label": "Fondo botón principal",
      "default": "#1B5E20"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Texto botón principal",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "btn_hover_bg",
      "label": "Fondo hover botón principal",
      "default": "#145214"
    },
    {
      "type": "color",
      "id": "btn_hover_text",
      "label": "Texto hover botón principal",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "btn2_emoji",
      "label": "Emoji botón secundario",
      "default": "💬"
    },
    {
      "type": "text",
      "id": "btn2_text",
      "label": "Texto botón secundario (vacío para ocultar)",
      "default": "Escribir por WhatsApp"
    },
    {
      "type": "text",
      "id": "btn2_link",
      "label": "Enlace botón secundario",
      "default": "https://wa.me/573027045952"
    },
    {
      "type": "color",
      "id": "btn_secondary_border",
      "label": "Borde botón secundario",
      "default": "#1B5E20"
    },
    {
      "type": "color",
      "id": "btn_secondary_text",
      "label": "Texto botón secundario",
      "default": "#1B5E20"
    },
    {
      "type": "range",
      "id": "btn_padding_y",
      "label": "Padding vertical botones",
      "min": 8,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "btn_padding_x",
      "label": "Padding horizontal botones",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "btn_font_size",
      "label": "Tamaño de fuente botones",
      "min": 0.8,
      "max": 1.2,
      "step": 0.1,
      "unit": "rem",
      "default": 1.0
    },
    {
      "type": "header",
      "content": "🗺️ Mapa Embebido (solo layout Split)"
    },
    {
      "type": "html",
      "id": "map_embed",
      "label": "Código iframe del mapa",
      "info": "Pega el iframe de Google Maps. Solo visible en layout Split."
    },
    {
      "type": "header",
      "content": "📝 Texto Secundario"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Texto debajo de los botones",
      "default": "Compra online o visítanos en el local · Te esperamos con una sonrisa 🌱"
    },
