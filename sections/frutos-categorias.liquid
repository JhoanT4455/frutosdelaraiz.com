<div class="cat-section-wrapper">

  <div class="cat-header">
    {%- if section.settings.eyebrow != blank -%}
      <span class="cat-eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    {%- if section.settings.show_title -%}
      <h2 class="cat-main-title">{{ section.settings.title }}</h2>
    {%- endif -%}
    {%- if section.settings.subtitle != blank -%}
      <p class="cat-main-subtitle">{{ section.settings.subtitle }}</p>
    {%- endif -%}
  </div>

  <div class="cat-grid-container">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link | default: '/collections/all' }}" class="cat-item-link" {{ block.shopify_attributes }}>

        {%- if block.settings.show_new_dot -%}
          <span class="cat-new-dot" title="Nuevo"></span>
        {%- endif -%}

        <div class="cat-icon-circle">
          {%- if block.settings.image -%}
            <img src="{{ block.settings.image | image_url: width: 300 }}" alt="{{ block.settings.label }}" loading="lazy">
          {%- elsif block.settings.emoji != blank -%}
            <span class="cat-icon-emoji">{{ block.settings.emoji }}</span>
          {%- else -%}
            <span class="cat-icon-svg">
              {%- case block.settings.icon -%}
                {%- when 'tea' -%}{{ svg_tea }}
                {%- when 'seed' -%}{{ svg_seed }}
                {%- when 'nut' -%}{{ svg_nut }}
                {%- when 'spice' -%}{{ svg_spice }}
                {%- when 'gift' -%}{{ svg_gift }}
                {%- when 'oil' -%}{{ svg_oil }}
                {%- when 'leaf' -%}{{ svg_leaf }}
                {%- when 'grain' -%}{{ svg_grain }}
                {%- when 'shop' -%}{{ svg_shop }}
                {%- else -%}{{ svg_star }}
              {%- endcase -%}
            </span>
          {%- endif -%}
        </div>

        <div class="cat-title-text">{{ block.settings.label }}</div>
        {%- if block.settings.badge != blank -%}
          <span class="cat-badge">{{ block.settings.badge }}</span>
        {%- endif -%}

      </a>
    {%- endfor -%}
  </div>

  {%- if section.settings.show_view_all -%}
    <div class="cat-view-all">
      <a href="{{ section.settings.view_all_link | default: '/collections/all' }}" class="cat-view-all-btn">
        {{ section.settings.view_all_text }}
        <span class="btn-arrow">→</span>
      </a>
    </div>
  {%- endif -%}

</div>

{% schema %}
{
  "name": "Categorías SVG CRO",
  "settings": [
    { "type": "header", "content": "📐 Layout" },
    { "type": "color", "id": "bg_color", "label": "Fondo de sección", "default": "#fafaf8" },
    { "type": "range", "id": "padding_top", "label": "Espaciado superior", "min": 20, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Espaciado inferior", "min": 20, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "grid_gap", "label": "Espacio entre items", "min": 10, "max": 50, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "grid_max_width", "label": "Ancho máximo del grid", "min": 600, "max": 1400, "step": 50, "unit": "px", "default": 1100 },
    { "type": "range", "id": "item_width", "label": "Ancho de cada item", "min": 80, "max": 220, "step": 5, "unit": "px", "default": 155 },
    { "type": "header", "content": "✍️ Encabezado" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "🌿 Todo para tu bienestar" },
    { "type": "checkbox", "id": "show_title", "label": "Mostrar título", "default": true },
    { "type": "text", "id": "title", "label": "Título", "default": "Explora por Categorías" },
    { "type": "color", "id": "title_color", "label": "Color del título", "default": "#1B5E20" },
    { "type": "range", "id": "title_size", "label": "Tamaño del título (px)", "min": 24, "max": 80, "step": 2, "unit": "px", "default": 72 },
    { "type": "text", "id": "subtitle", "label": "Subtítulo" },
    { "type": "color", "id": "subtitle_color", "label": "Color subtítulo", "default": "#888888" },
    { "type": "range", "id": "subtitle_size", "label": "Tamaño subtítulo (px)", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 16 },
    { "type": "color", "id": "accent_color", "label": "Color de acento", "default": "#1B5E20" },
    { "type": "header", "content": "⭕ Círculos" },
    { "type": "range", "id": "circle_size", "label": "Tamaño del círculo", "min": 70, "max": 160, "step": 5, "unit": "px", "default": 120 },
    { "type": "color", "id": "circle_bg", "label": "Fondo del círculo", "default": "#ffffff" },
    { "type": "color", "id": "circle_border", "label": "Borde / color del ícono", "default": "#1B5E20" },
    { "type": "color", "id": "circle_hover_bg", "label": "Fondo hover del círculo", "default": "#1B5E20" },
    { "type": "range", "id": "icon_size", "label": "Tamaño del ícono / emoji (px)", "min": 16, "max": 64, "step": 2, "unit": "px", "default": 40 },
    { "type": "header", "content": "🏷️ Etiquetas y Badge" },
    { "type": "color", "id": "label_color", "label": "Color del label", "default": "#5D4037" },
    { "type": "range", "id": "label_size", "label": "Tamaño del label (px)", "min": 16, "max": 40, "step": 1, "unit": "px", "default": 32 },
    { "type": "color", "id": "badge_bg", "label": "Fondo del badge", "default": "#e8f5e9" },
    { "type": "color", "id": "badge_text", "label": "Texto del badge", "default": "#1B5E20" },
    { "type": "header", "content": "🔘 Botón Ver Todo" },
    { "type": "checkbox", "id": "show_view_all", "label": "Mostrar botón ver todo", "default": true },
    { "type": "text", "id": "view_all_text", "label": "Texto del botón", "default": "Ver todo el catálogo" },
    { "type": "url", "id": "view_all_link", "label": "Enlace del botón" }
  ],
  "blocks": [
    {
      "type": "categoria",
      "name": "Categoría",
      "limit": 12,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen (prioridad sobre emoji/ícono)" },
        { "type": "text", "id": "emoji", "label": "Emoji (si no hay imagen)", "info": "Ej: 🍵 — Si está vacío usa el ícono SVG" },
        {
          "type": "select", "id": "icon", "label": "Ícono SVG (si no hay emoji ni imagen)",
          "options": [
            { "value": "tea", "label": "☕ Infusiones / Té" },
            { "value": "seed", "label": "🌱 Semillas / Plantas" },
            { "value": "nut", "label": "🥜 Frutos Secos" },
            { "value": "spice", "label": "🫙 Especias / Condimentos" },
            { "value": "gift", "label": "🎁 Combos / Regalos" },
            { "value": "oil", "label": "🫒 Aceites" },
            { "value": "leaf", "label": "🍃 Aromáticas" },
            { "value": "grain", "label": "🌾 Granos / Cereales" },
            { "value": "shop", "label": "🛒 Tienda General" },
            { "value": "star", "label": "⭐ Destacados" }
          ],
          "default": "leaf"
        },
        { "type": "text", "id": "label", "label": "Nombre de la categoría", "default": "Infusiones" },
        { "type": "url", "id": "link", "label": "Enlace de la categoría" },
        { "type": "text", "id": "badge", "label": "Badge (vacío para ocultar)", "default": "Popular" },
        { "type": "checkbox", "id": "show_new_dot", "label": "Mostrar punto Nuevo", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Categorías SVG CRO",
      "category": "Custom",
      "blocks": [
        { "type": "categoria", "settings": { "emoji": "🍵", "label": "Infusiones", "badge": "Popular" } },
        { "type": "categoria", "settings": { "emoji": "🌱", "label": "Semillas", "badge": "Natural" } },
        { "type": "categoria", "settings": { "emoji": "🥜", "label": "Frutos Secos", "badge": "Energía" } },
        { "type": "categoria", "settings": { "emoji": "🫙", "label": "Especias", "badge": "Sabor" } },
        { "type": "categoria", "settings": { "emoji": "🎁", "label": "Combos", "badge": "Ahorra", "show_new_dot": true } },
        { "type": "categoria", "settings": { "emoji": "🫒", "label": "Aceites", "badge": "Premium" } }
      ]
    }
  ]
}
{% endschema %}


