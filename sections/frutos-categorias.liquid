{{ 'https://fonts.googleapis.com/css2?family=Amatic+SC:wght@700&family=Lato:wght@400;700&family=Montserrat:wght@500;600;700&display=swap' | stylesheet_tag }}

<style>
  .cat-section-wrapper {
    padding: {{ section.settings.padding_top }}px 5% {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.bg_color }};
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .cat-section-wrapper::before {
    content: '';
    position: absolute;
    top: -60px; left: -60px;
    width: 220px; height: 220px;
    background: radial-gradient(circle, rgba(118,255,3,0.08) 0%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
  }

  .cat-section-wrapper::after {
    content: '';
    position: absolute;
    bottom: -60px; right: -60px;
    width: 220px; height: 220px;
    background: radial-gradient(circle, rgba(27,94,32,0.07) 0%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
  }

  .cat-eyebrow {
    display: inline-block;
    font-family: 'Montserrat', sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
    margin-bottom: 8px;
  }

  .cat-header { margin-bottom: 50px; position: relative; z-index: 1; }

  .cat-main-title {
    font-family: 'Amatic SC', cursive;
    font-size: {{ section.settings.title_size }}px;
    color: {{ section.settings.title_color }};
    margin-bottom: 10px;
    font-weight: 700;
    line-height: 1;
  }

  .cat-main-subtitle {
    font-family: 'Lato', sans-serif;
    color: {{ section.settings.subtitle_color }};
    font-size: {{ section.settings.subtitle_size }}px;
  }

  .cat-grid-container {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: {{ section.settings.grid_gap }}px;
    max-width: {{ section.settings.grid_max_width }}px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .cat-item-link {
    width: {{ section.settings.item_width }}px;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: transform 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    position: relative;
  }

  .cat-item-link:hover { transform: translateY(-10px); }

  .cat-icon-circle {
    width: {{ section.settings.circle_size }}px;
    height: {{ section.settings.circle_size }}px;
    border-radius: 50%;
    background-color: {{ section.settings.circle_bg }};
    border: 2px solid {{ section.settings.circle_border }};
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 14px;
    font-size: {{ section.settings.icon_size }}px;
    box-shadow: 0 6px 18px rgba(27,94,32,0.1);
    transition: all 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    position: relative;
    overflow: hidden;
  }

  .cat-icon-circle::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: {{ section.settings.circle_hover_bg }};
    transform: scale(0);
    transition: transform 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    z-index: 0;
  }

  .cat-icon-svg {
    position: relative;
    z-index: 1;
    transition: transform 0.35s;
    display: flex;
    align-items: center;
    justify-content: center;
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    color: {{ section.settings.circle_border }};
  }

  .cat-icon-svg svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
    transition: color 0.3s, transform 0.35s;
  }

  .cat-icon-emoji {
    font-size: {{ section.settings.icon_size }}px;
    line-height: 1;
    position: relative;
    z-index: 1;
    transition: transform 0.35s;
  }

  .cat-icon-circle img {
    width: 100%; height: 100%;
    object-fit: cover;
    border-radius: 50%;
    position: relative;
    z-index: 1;
    transition: transform 0.35s;
  }

  .cat-item-link:hover .cat-icon-circle { border-color: {{ section.settings.accent_color }}; box-shadow: 0 10px 28px rgba(27,94,32,0.25); }
  .cat-item-link:hover .cat-icon-circle::before { transform: scale(1); }
  .cat-item-link:hover .cat-icon-svg { color: #ffffff; transform: scale(1.15) rotate(-5deg); }
  .cat-item-link:hover .cat-icon-emoji { transform: scale(1.2) rotate(-5deg); }
  .cat-item-link:hover .cat-icon-circle img { transform: scale(1.08); }

  .cat-title-text {
    font-family: 'Amatic SC', cursive;
    font-weight: 700;
    font-size: {{ section.settings.label_size }}px;
    color: {{ section.settings.label_color }};
    line-height: 1.1;
    text-transform: uppercase;
    transition: color 0.3s;
    margin-bottom: 4px;
  }

  .cat-item-link:hover .cat-title-text { color: {{ section.settings.accent_color }}; }

  .cat-badge {
    display: inline-block;
    background: {{ section.settings.badge_bg }};
    color: {{ section.settings.badge_text }};
    font-family: 'Montserrat', sans-serif;
    font-size: 11px;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 12px;
    transition: background 0.3s, color 0.3s;
  }

  .cat-item-link:hover .cat-badge { background: {{ section.settings.accent_color }}; color: #000; }

  .cat-new-dot {
    position: absolute;
    top: 4px; right: 12px;
    width: 12px; height: 12px;
    background: #FF5722;
    border-radius: 50%;
    border: 2px solid {{ section.settings.bg_color }};
    animation: pulse-dot 2s infinite;
    z-index: 3;
  }

  @keyframes pulse-dot {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.3); opacity: 0.7; }
  }

  .cat-view-all { margin-top: 45px; position: relative; z-index: 1; }

  .cat-view-all-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 2px solid {{ section.settings.accent_color }};
    color: {{ section.settings.accent_color }};
    padding: 12px 32px;
    border-radius: 40px;
    font-family: 'Montserrat', sans-serif;
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.3s;
  }

  .cat-view-all-btn:hover {
    background: {{ section.settings.accent_color }};
    color: #76ff03;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(27,94,32,0.2);
  }

  .cat-view-all-btn .btn-arrow { transition: transform 0.3s; display: inline-block; }
  .cat-view-all-btn:hover .btn-arrow { transform: translateX(5px); }

  @media (max-width: 900px) {
    .cat-grid-container { gap: {{ section.settings.grid_gap | minus: 6 }}px; }
    .cat-item-link { width: {{ section.settings.item_width | times: 0.85 | round }}px; }
    .cat-icon-circle { width: {{ section.settings.circle_size | times: 0.88 | round }}px; height: {{ section.settings.circle_size | times: 0.88 | round }}px; }
  }

  @media (max-width: 600px) {
    .cat-section-wrapper { padding: 50px 5%; }
    .cat-main-title { font-size: {{ section.settings.title_size | times: 0.78 | round }}px; }
    .cat-grid-container { gap: 14px; }
    .cat-item-link { width: calc(33% - 14px); min-width: 90px; }
    .cat-icon-circle { width: 85px; height: 85px; }
    .cat-title-text { font-size: 24px; }
    .cat-badge { display: none; }
  }

  @media (max-width: 380px) {
    .cat-item-link { width: calc(50% - 14px); }
  }
</style>

{%- comment -%} SVG library — cada bloque elige su ícono por ID {%- endcomment -%}
