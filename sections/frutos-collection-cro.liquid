    {"type":"range","id":"products_per_page","label":"Productos por pagina","min":8,"max":48,"step":4,"default":24},
    {"type":"text","id":"whatsapp_number","label":"Numero WhatsApp","default":"573027045952"}
  ],
  "presets": [{"name":"Collection CRO Frutos","category":"Frutos de la Raiz"}]
}
