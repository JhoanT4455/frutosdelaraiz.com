<div class="fc-toast" id="fcToast"></div>

{%- endpaginate -%}

{% comment %} ═══════════════════════════════════════════════════════════
   JAVASCRIPT — Frutos Collection v4
   ═══════════════════════════════════════════════════════════ {% endcomment %}
<script>
(function() {
  'use strict';

  const FC = window.FC = window.FC || {};

  /* ── Toast Notification ── */
  FC.toastEl = document.getElementById('fcToast');
  FC.toastTimer = null;

  window.fcToast = function(msg, isError) {
    const el = FC.toastEl;
    if (!el) return;
    el.textContent = msg;
    el.className = 'fc-toast' + (isError ? ' fc-toast--error' : ' fc-toast--success');
    clearTimeout(FC.toastTimer);
    // force reflow
    void el.offsetWidth;
    el.classList.add('is-visible');
    FC.toastTimer = setTimeout(() => el.classList.remove('is-visible'), 3200);
  };

  /* ── Add to Cart AJAX ── */
  window.fcAdd = function(btn) {
    if (btn.classList.contains('is-loading') || btn.classList.contains('is-success')) return;
    if (btn.dataset.available !== 'true') {
      fcToast('Este producto está agotado', true);
      return;
    }

    const vid = btn.dataset.vid;
    if (!vid) { fcToast('Selecciona una variante', true); return; }

    btn.classList.add('is-loading');

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify({ id: parseInt(vid), quantity: 1 })
    })
    .then(r => {
      if (!r.ok) {
        return r.json().then(err => {
          throw new Error(err.description || err.message || 'Error al añadir');
        });
      }
      return r.json();
    })
    .then(() => {
      btn.classList.remove('is-loading');
      btn.classList.add('is-success');
      fcToast('¡Producto añadido al carrito!');
      fcUpdateCartCount();
      setTimeout(() => btn.classList.remove('is-success'), 2200);
      // Redirigir al carrito para completar la compra
     // window.location.href = '/cart';
    })
    .catch(err => {
      btn.classList.remove('is-loading');
      fcToast(err.message || 'No se pudo añadir', true);
      console.error('[FRC] Add to cart error:', err);
    });
  };

  /* ── Update cart counter ── */
  function fcUpdateCartCount() {
    fetch('/cart.js')
      .then(r => r.json())
      .then(cart => {
        document.querySelectorAll('[data-cart-count]').forEach(el => {
          el.textContent = cart.item_count;
        });
      })
      .catch(() => {});
  }
  FC.updateCartCount = fcUpdateCartCount;

  /* ── Variant Switcher ── */
  window.fcV = function(select) {
    const opt = select.options[select.selectedIndex];
    const pid = select.dataset.productId;
    if (!opt || !pid) return;

    const price = opt.dataset.price;
    const compare = opt.dataset.compare;
    const available = opt.dataset.available === 'true';

    const curPriceEl = document.getElementById('fcCurPrice-' + pid);
    const compPriceEl = document.getElementById('fcCompPrice-' + pid);
    const saveEl = document.getElementById('fcSave-' + pid);

    if (curPriceEl && price) curPriceEl.textContent = price;
    if (compPriceEl) compPriceEl.style.display = compare ? '' : 'none';
    if (compPriceEl && compare) compPriceEl.textContent = compare;
    if (saveEl) {
      if (compare && price) {
        const pNum = parseInt(opt.dataset.price) || 0;
        const cNum = parseInt(opt.dataset.compare) || 0;
        if (cNum > pNum) {
          const pct = Math.round((cNum - pNum) * 100 / cNum);
          saveEl.textContent = 'Ahorra ' + pct + '%';
          saveEl.style.display = '';
        } else {
          saveEl.style.display = 'none';
        }
      } else {
        saveEl.style.display = 'none';
      }
    }

    // Update add button variant ID and availability
    const card = select.closest('.fc-card');
    if (card) {
      const addBtn = card.querySelector('.fc-add-btn');
      if (addBtn) {
        addBtn.dataset.vid = opt.value;
        addBtn.dataset.available = available ? 'true' : 'false';
        if (!available) {
          addBtn.disabled = true;
          addBtn.style.opacity = '0.5';
          addBtn.style.cursor = 'not-allowed';
        } else {
          addBtn.disabled = false;
          addBtn.style.opacity = '';
          addBtn.style.cursor = '';
        }
      }

      if (opt.dataset.priceRaw && window.fcUpdateCardPrice) {
        window.fcUpdateCardPrice(card, opt.dataset.priceRaw);
      }
    }
  };

  /* ── Category Filter ── */
  window.fcFilterCat = function(catHandle) {
    // Marcar activo visualmente
    document.querySelectorAll('.fc-cat-item').forEach(function(item) {
      item.classList.toggle('is-active', item.dataset.cat === catHandle);
    });
    // Navegar a la coleccion
    if (catHandle === 'all') {
      window.location.href = '{{ routes.all_products_collection_url }}';
    } else {
      window.location.href = '/collections/' + catHandle;
    }
  };

  /* ── Quick View (placeholder) ── */
  window.fcQuickView = function(handle) {
    // Abre el producto directamente o integra con tu modal de quick view existente
    window.location.href = '/products/' + handle;
  };

  /* ── Wishlist (placeholder) ── */
  window.fcToggleWishlist = function(handle, btn) {
    btn.classList.toggle('is-active');
    const isActive = btn.classList.contains('is-active');
    btn.style.color = isActive ? 'var(--fc-red)' : '';
    btn.style.fill = isActive ? 'var(--fc-red)' : 'none';
    if (isActive) fcToast('Añadido a favoritos');
    else fcToast('Eliminado de favoritos');
  };

  /* ── Handle sort_by from URL on load ── */
  document.addEventListener('DOMContentLoaded', function() {
    const params = new URLSearchParams(window.location.search);
    const sort = params.get('sort_by');
    if (sort) {
      const sel = document.querySelector('.fc-sort');
      if (sel) sel.value = window.location.pathname + '?sort_by=' + sort;
    }
  });

})();
</script>

{% schema %}
{
  "name": "Frutos Collection Final",
  "tag": "section",
  "class": "frutos-collection-section",
  "settings": [
    {
      "type": "header",
      "content": "Configuración de la colección"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24,
      "label": "Productos por página"
    },
    {
      "type": "text",
      "id": "whatsapp_number",
      "default": "573027045952",
      "label": "Número de WhatsApp",
      "info": "Incluye código de país, sin + ni espacios. Ej: 573027045952"
    },
    {
      "type": "checkbox",
      "id": "show_filters",
      "default": true,
      "label": "Mostrar filtros"
    },
    {
      "type": "checkbox",
      "id": "show_sidebar",
      "default": true,
      "label": "Mostrar sidebar en desktop"
    }
  ],
  "presets": [
    {
      "name": "Frutos Collection Final",
      "category": "Frutos de la Raíz"
    }
  ]
}
{% endschema %}
