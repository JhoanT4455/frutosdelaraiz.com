    {% render 'fc-collection-filters-panel', collection: collection, context: 'mobile', active_tags: active_tags %}

    <div class="fc-mobile-panel__footer">
      <button type="button" class="fc-mobile-panel__apply" id="fcMobileApplyBtn" onclick="fcClosePanel()">Ver resultados</button>
    </div>
  </div>
{%- endif -%}

