    },
    {
      "type": "url",
      "id": "btn2_link",
      "label": "Botón secundario — Enlace"
    },
    {
      "type": "color",
      "id": "btn2_bg_color",
      "label": "Botón secundario — Fondo",
      "default": "#0a2e0a"
    },
    {
      "type": "color",
      "id": "btn2_border_color",
      "label": "Botón secundario — Borde y hover",
      "default": "#1B5E20"
    },
    {
      "type": "color",
      "id": "btn2_text_color",
      "label": "Botón secundario — Color de texto",
      "default": "#1B5E20"
    },
    {
      "type": "header",
      "content": "⭐ Prueba Social"
    },
    {
      "type": "checkbox",
      "id": "show_social_proof",
      "label": "Mostrar prueba social",
      "default": true
    },
