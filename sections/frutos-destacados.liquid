      "label": "Estilo del borde",
      "options": [
        { "value": "solid",  "label": "Sólido" },
        { "value": "dashed", "label": "Punteado" },
        { "value": "dotted", "label": "Puntos" }
      ],
      "default": "dashed"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Color del borde",
      "default": "#5D4037"
