      "default": "✅ ¡Añadido al carrito!"
    },
    {
      "type": "color",
      "id": "toast_bg",
      "label": "Color de fondo del toast",
      "default": "#1B5E20"
    },
    {
      "type": "color",
      "id": "toast_color",
      "label": "Color del texto del toast",
      "default": "#ffffff"
    },
    {
