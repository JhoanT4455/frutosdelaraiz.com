      "default": "✅ 100% natural · Sin aditivos"
    },
    {
      "type": "text",
      "id": "benefit_2",
      "label": "Beneficio 2",
      "default": "🌱 Origen consciente y local"
    },
    {
      "type": "text",
      "id": "benefit_3",
      "label": "Beneficio 3",
