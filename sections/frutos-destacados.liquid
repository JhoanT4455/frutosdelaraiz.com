      "default": "#FF5722"
    },
    {
      "type": "checkbox",
      "id": "show_crosssell",
      "label": "Mostrar sugerencia de combo (solo productos con tag 'combo')",
      "default": true
    },
    {
      "type": "text",
      "id": "crosssell_text",
      "label": "Texto del cross-sell",
      "default": "🎁 Llévalo en combo y ahorra más"
    },
