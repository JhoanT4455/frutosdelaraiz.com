{{ 'https://fonts.googleapis.com/css2?family=Amatic+SC:wght@700&family=Montserrat:wght@400;500;600;700&family=Lato:wght@400;700&display=swap' | stylesheet_tag }}

<!-- ===================== BARRA SUPERIOR ===================== -->
<div class="fdr-topbar">
  <span class="fdr-topbar__text">
    {{ section.settings.topbar_text }}
  </span>
</div>

<!-- ===================== HEADER PRINCIPAL ===================== -->
<header class="fdr-header" id="fdr-header">
  <div class="fdr-header__inner">

    <!-- LOGO -->
    <a href="{{ routes.root_url }}" class="fdr-logo" aria-label="{{ shop.name }}">
      {%- if section.settings.logo != blank -%}
        <img
          src="{{ section.settings.logo | image_url: width: 120 }}"
          alt="{{ shop.name }}"
          class="fdr-logo__img"
          width="60"
          height="60"
          loading="eager"
        >
      {%- else -%}
        <span class="fdr-logo__icon">🌿</span>
      {%- endif -%}
      <div class="fdr-logo__text-wrap">
        <span class="fdr-logo__name">{{ shop.name }}</span>
        <span class="fdr-logo__tagline">{{ section.settings.tagline }}</span>
      </div>
    </a>

    <!-- BÚSQUEDA -->
    <form class="fdr-search" action="{{ routes.search_url }}" method="get" role="search">
      <input
        type="search"
        name="q"
        class="fdr-search__input"
        placeholder="{{ section.settings.search_placeholder }}"
        aria-label="Buscar productos"
        autocomplete="off"
      >
      <button type="submit" class="fdr-search__btn" aria-label="Buscar">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      </button>
    </form>

    <!-- ACCIONES (cuenta + carrito) -->
    <div class="fdr-actions">

      <!-- Cuenta -->
      {%- if shop.customer_accounts_enabled -%}
        <a
          href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
          class="fdr-actions__btn"
          aria-label="Mi cuenta"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </a>
      {%- endif -%}

      <!-- Carrito — FIX: data-count para que el CSS oculte el 0 -->
      <a href="{{ routes.cart_url }}" class="fdr-actions__btn fdr-cart" aria-label="Ver carrito">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
        <span
          class="fdr-cart__count"
          id="fdr-cart-count"
          data-count="{{ cart.item_count }}"
        >{{ cart.item_count }}</span>
      </a>

      <!-- Botón hamburguesa móvil -->
      <button class="fdr-burger" id="fdr-burger" aria-label="Abrir menú" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>

    </div>

  </div><!-- /.fdr-header__inner -->

  <!-- ===================== MENÚ DE NAVEGACIÓN ===================== -->
  <nav class="fdr-nav" id="fdr-nav" aria-label="Navegación principal">
    <ul class="fdr-nav__list">
      {%- for link in linklists[section.settings.menu].links -%}
        <li class="fdr-nav__item">
          <a
            href="{{ link.url }}"
            class="fdr-nav__link{% if link.active %} fdr-nav__link--active{% endif %}{% if link.title == section.settings.highlight_item %} fdr-nav__link--highlight{% endif %}"
          >
            {{ link.title }}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </nav>

  <!-- Overlay móvil -->
  <div class="fdr-overlay" id="fdr-overlay"></div>

</header>

<!-- ===================== ESTILOS ===================== -->
<style>

  /* === RESET === */
  .fdr-topbar,
  .fdr-header,
  .fdr-header * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  /* === BARRA SUPERIOR === */
  .fdr-topbar {
    background-color: {{ section.settings.topbar_bg }};
    color: {{ section.settings.topbar_text_color }};
    text-align: center;
    padding: {{ section.settings.topbar_padding }}px 20px;
    font-family: 'Montserrat', cursive;
    font-size: {{ section.settings.topbar_font_size }}rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    line-height: 1.3;
  }

  /* === HEADER === */
  .fdr-header {
    background: {{ section.settings.header_bg }};
    box-shadow: 0 2px 16px rgba(93, 64, 55, 0.07);
    position: sticky;
    top: 0;
    z-index: 9999;
    width: 100%;
    transition: box-shadow 0.3s ease;
  }

  .fdr-header.fdr-header--scrolled {
    box-shadow: 0 4px 24px rgba(93, 64, 55, 0.13);
  }

  .fdr-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    max-width: {{ section.settings.header_max_width }}px;
    margin: 0 auto;
    padding: {{ section.settings.header_padding_y }}px {{ section.settings.header_padding_x }}px;
  }

  /* === LOGO === */
  .fdr-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    flex-shrink: 0;
  }

  .fdr-logo__img {
    width: 58px;
    height: 58px;
    object-fit: contain;
  }

  .fdr-logo__icon {
    font-size: 2.2rem;
    line-height: 1;
  }

  .fdr-logo__text-wrap {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .fdr-logo__name {
    font-family: 'Amatic SC', cursive;
    font-size: {{ section.settings.logo_name_size }}rem;
    font-weight: 700;
    color: {{ section.settings.logo_name_color }};
    letter-spacing: 1px;
    line-height: 1;
  }

  .fdr-logo__tagline {
    font-family: 'Montserrat', sans-serif;
    font-size: 0.52rem;
    font-weight: 600;
    color: {{ section.settings.logo_tagline_color }};
    letter-spacing: 3px;
    text-transform: uppercase;
    margin-top: 3px;
  }

  /* === BÚSQUEDA === */
  .fdr-search {
    flex: 1;
    max-width: {{ section.settings.search_max_width }}px;
    display: flex;
    align-items: center;
    border: 1.5px solid #e0e0e0;
    border-radius: 30px;
    overflow: hidden;
    background: #FAFAF8;
    transition: border-color 0.3s, box-shadow 0.3s;
  }

  .fdr-search:focus-within {
    border-color: {{ section.settings.accent_color }};
    box-shadow: 0 0 0 3px {{ section.settings.accent_color }}1a;
    background: #ffffff;
  }

  .fdr-search__input {
    flex: 1;
    border: none;
    background: transparent;
    padding: 10px 18px;
    font-family: 'Lato', sans-serif;
    font-size: 0.9rem;
    color: #333;
    outline: none;
    width: 100%;
  }

  .fdr-search__input::placeholder { color: #aaa; }

  .fdr-search__btn {
    background: {{ section.settings.accent_color }};
    border: none;
    cursor: pointer;
    padding: 0 16px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    transition: background 0.2s;
    flex-shrink: 0;
  }

  .fdr-search__btn:hover { background: {{ section.settings.accent_color_dark }}; }

  /* === ACCIONES === */
  .fdr-actions {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
  }

  .fdr-actions__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    color: {{ section.settings.icon_color }};
    text-decoration: none;
    border-radius: 50%;
    transition: color 0.2s, background 0.2s;
    position: relative;
  }

  .fdr-actions__btn:hover {
    color: {{ section.settings.accent_color }};
    background: {{ section.settings.accent_color }}0f;
  }

  .fdr-cart { position: relative; }

  .fdr-cart__count {
    position: absolute;
    top: 2px;
    right: 2px;
    background: {{ section.settings.cart_badge_color }};
    color: #ffffff;
    font-family: 'Montserrat', sans-serif;
    font-weight: 700;
    font-size: 0.65rem;
    min-width: 18px;
    height: 18px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid {{ section.settings.header_bg }};
    line-height: 1;
    pointer-events: none;
    transition: transform 0.2s;
  }

  /* Ocultar burbuja cuando está en 0 */
  .fdr-cart__count[data-count="0"] { display: none; }

  /* Animación al añadir al carrito */
  .fdr-cart__count.fdr-cart--bump {
    animation: cart-bump 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  @keyframes cart-bump {
    0%   { transform: scale(1); }
    50%  { transform: scale(1.5); }
    100% { transform: scale(1); }
  }

  /* === NAVEGACIÓN === */
  .fdr-nav {
    border-top: 1px solid {{ section.settings.accent_color }}1a;
  }

  .fdr-nav__list {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    list-style: none;
    max-width: {{ section.settings.header_max_width }}px;
    margin: 0 auto;
    padding: 0 {{ section.settings.header_padding_x }}px;
  }

  .fdr-nav__link {
    display: block;
    padding: {{ section.settings.nav_padding_y }}px {{ section.settings.nav_padding_x }}px;
    font-family: 'Amatic SC', cursive;
    font-size: {{ section.settings.nav_font_size }}rem;
    font-weight: 700;
    color: {{ section.settings.nav_link_color }};
    text-decoration: none;
    letter-spacing: 1px;
    text-transform: uppercase;
    position: relative;
    transition: color 0.25s;
  }

  .fdr-nav__link::after {
    content: '';
    position: absolute;
    bottom: 6px;
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 2px;
    background: {{ section.settings.accent_color }};
    border-radius: 2px;
    transition: width 0.3s ease;
  }

  .fdr-nav__link:hover,
  .fdr-nav__link--active {
    color: {{ section.settings.accent_color }};
  }

  .fdr-nav__link:hover::after,
  .fdr-nav__link--active::after {
    width: 60%;
  }

  /* Ítem destacado */
  .fdr-nav__link--highlight {
    color: {{ section.settings.highlight_color }} !important;
  }

  .fdr-nav__link--highlight::after {
    background: {{ section.settings.highlight_color }} !important;
  }

  .fdr-nav__link--highlight:hover {
    color: {{ section.settings.highlight_color }} !important;
    opacity: 0.85;
  }

  /* === HAMBURGUESA (MÓVIL) === */
  .fdr-burger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
    width: 38px;
    height: 38px;
    justify-content: center;
    align-items: center;
  }

  .fdr-burger span {
    display: block;
    width: 22px;
    height: 2px;
    background: {{ section.settings.icon_color }};
    border-radius: 2px;
    transition: all 0.3s ease;
  }

  .fdr-burger.fdr-burger--open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .fdr-burger.fdr-burger--open span:nth-child(2) { opacity: 0; }
  .fdr-burger.fdr-burger--open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* === OVERLAY MÓVIL === */
  .fdr-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    z-index: 9990;
    opacity: 0;
    transition: opacity 0.3s;
  }

  .fdr-overlay.fdr-overlay--visible {
    display: block;
    opacity: 1;
  }

  /* === RESPONSIVE === */
  @media (max-width: 768px) {
    .fdr-header__inner { padding: 10px 16px; gap: 10px; }
    .fdr-logo__name { font-size: {{ section.settings.logo_name_size | times: 0.82 }}rem; }
    .fdr-logo__tagline { display: none; }
    .fdr-logo__img { width: 44px; height: 44px; }
    .fdr-search { display: none; }
    .fdr-burger { display: flex; }

    .fdr-nav {
      position: fixed;
      top: 0;
      left: -280px;
      width: 280px;
      height: 100vh;
      background: {{ section.settings.header_bg }};
      border-right: 3px solid {{ section.settings.accent_color }};
      z-index: 9995;
      overflow-y: auto;
      transition: left 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      border-top: none;
    }

    .fdr-nav.fdr-nav--open { left: 0; }

    .fdr-nav__list {
      flex-direction: column;
      align-items: flex-start;
      padding: 60px 0 20px 0;
      gap: 0;
    }

    .fdr-nav__item {
      width: 100%;
      border-bottom: 1px solid {{ section.settings.accent_color }}14;
    }

    .fdr-nav__link {
      font-size: 2rem;
      padding: 14px 28px;
      width: 100%;
    }

    .fdr-nav__link::after { display: none; }
  }

  @media (max-width: 480px) {
    .fdr-topbar {
      font-size: 0.9rem;
      padding: 6px 12px;
    }
  }

</style>

<!-- ===================== JAVASCRIPT ===================== -->
<script>
(function() {

  /* --- Sticky shadow --- */
  var header = document.getElementById('fdr-header');
  if (header) {
    window.addEventListener('scroll', function() {
      header.classList.toggle('fdr-header--scrolled', window.scrollY > 10);
    }, { passive: true });
  }

  /* --- Menú móvil --- */
  var burger  = document.getElementById('fdr-burger');
  var nav     = document.getElementById('fdr-nav');
  var overlay = document.getElementById('fdr-overlay');

  function openMenu() {
    nav.classList.add('fdr-nav--open');
    overlay.classList.add('fdr-overlay--visible');
    burger.classList.add('fdr-burger--open');
    burger.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    nav.classList.remove('fdr-nav--open');
    overlay.classList.remove('fdr-overlay--visible');
    burger.classList.remove('fdr-burger--open');
    burger.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  if (burger) {
    burger.addEventListener('click', function() {
      nav.classList.contains('fdr-nav--open') ? closeMenu() : openMenu();
    });
  }

  if (overlay) overlay.addEventListener('click', closeMenu);

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeMenu();
  });

  /* --- Contador carrito AJAX + animación bump --- */
  var cartEl = document.getElementById('fdr-cart-count');

  function updateCartCount() {
    fetch('/cart.js')
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (!cartEl) return;
        var prev = parseInt(cartEl.getAttribute('data-count') || '0', 10);
        cartEl.textContent = data.item_count;
        cartEl.setAttribute('data-count', data.item_count);
        /* Animación bump solo si aumentó */
        if (data.item_count > prev) {
          cartEl.classList.remove('fdr-cart--bump');
          void cartEl.offsetWidth; /* reflow para reiniciar animación */
          cartEl.classList.add('fdr-cart--bump');
        }
      })
      .catch(function() {});
  }

  document.addEventListener('cart:updated', updateCartCount);
  document.addEventListener('cart:refresh', updateCartCount);

})();
</script>

{% schema %}
{
  "name": "Header Frutos",
  "tag": "header",
  "class": "fdr-header-section",
  "settings": [
    {
      "type": "header",
      "content": "📢 Barra Superior"
    },
    {
      "type": "color",
      "id": "topbar_bg",
      "label": "Fondo barra superior",
      "default": "#1B5E20"
    },
    {
      "type": "color",
      "id": "topbar_text_color",
      "label": "Color texto barra",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "topbar_text",
      "label": "Texto barra superior",
      "default": "🚚 Envíos gratis por compras mayores a $120.000 (Área Metropolitana) | ⭐ Calidad Garantizada"
    },
    {
      "type": "range",
      "id": "topbar_padding",
      "label": "Padding barra",
      "min": 4,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "topbar_font_size",
      "label": "Tamaño fuente barra",
      "min": 0.8,
      "max": 1.4,
      "step": 0.1,
      "unit": "rem",
      "default": 1.1
    },
    {
      "type": "header",
      "content": "🏠 Header Principal"
    },
    {
      "type": "color",
      "id": "header_bg",
      "label": "Fondo del header",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Color de acento (búsqueda, subrayados)",
      "default": "#1B5E20"
    },
    {
      "type": "color",
      "id": "accent_color_dark",
      "label": "Color acento oscuro (hover botón búsqueda)",
      "default": "#145214"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Color de íconos (cuenta/carrito/burger)",
      "default": "#5D4037"
    },
    {
      "type": "color",
      "id": "cart_badge_color",
      "label": "Color burbuja del carrito",
      "default": "#FF5722"
    },
    {
      "type": "range",
      "id": "header_max_width",
      "label": "Ancho máximo del header",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "default": 1400
    },
    {
      "type": "range",
      "id": "header_padding_y",
      "label": "Padding vertical del header",
      "min": 6,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "header_padding_x",
      "label": "Padding horizontal del header",
      "min": 12,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "🌿 Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo imagen (opcional — si no hay, usa emoji 🌿)"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Slogan bajo el logo",
      "default": "Alimentación Consciente"
    },
    {
      "type": "color",
      "id": "logo_name_color",
      "label": "Color del nombre del logo",
      "default": "#5D4037"
    },
    {
      "type": "color",
      "id": "logo_tagline_color",
      "label": "Color del slogan",
      "default": "#8D6E63"
    },
    {
      "type": "range",
      "id": "logo_name_size",
      "label": "Tamaño del nombre del logo",
      "min": 1.4,
      "max": 3.0,
      "step": 0.1,
      "unit": "rem",
      "default": 1.9
    },
    {
      "type": "header",
      "content": "🔍 Búsqueda"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Placeholder del buscador",
      "default": "¿Qué estás buscando hoy? (Ej: Chía, Aromática...)"
    },
    {
      "type": "range",
      "id": "search_max_width",
      "label": "Ancho máximo del buscador",
      "min": 300,
      "max": 700,
      "step": 20,
      "unit": "px",
      "default": 480
    },
    {
      "type": "header",
      "content": "🧭 Navegación"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menú de navegación",
      "default": "main-menu",
      "info": "Configura los links en Shopify Admin → Tienda online → Navegación → Menú principal"
    },
    {
      "type": "text",
      "id": "highlight_item",
      "label": "Ítem destacado del menú",
      "default": "Combos",
      "info": "Escribe EXACTAMENTE el nombre del ítem que quieres resaltar en color especial"
    },
    {
      "type": "color",
      "id": "nav_link_color",
      "label": "Color de los links del menú",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Color del ítem destacado",
      "default": "#FF5722"
    },
    {
      "type": "range",
      "id": "nav_font_size",
      "label": "Tamaño de fuente del menú",
      "min": 1.0,
      "max": 2.5,
      "step": 0.1,
      "unit": "rem",
      "default": 1.5
    },
    {
      "type": "range",
      "id": "nav_padding_y",
      "label": "Padding vertical de los links",
      "min": 6,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "nav_padding_x",
      "label": "Padding horizontal de los links",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Header Frutos"
    }
  ]
}
{% endschema %}