  }

  /* ===== Scrollbar estilizada ===== */
  .fdr-nav::-webkit-scrollbar { width: 4px; }
  .fdr-nav::-webkit-scrollbar-track { background: transparent; }
  .fdr-nav::-webkit-scrollbar-thumb { background: {{ section.settings.accent_color }}40; border-radius: 4px; }
  .fdr-nav::-webkit-scrollbar-thumb:hover { background: {{ section.settings.accent_color }}80; }

  .fdr-search__dropdown::-webkit-scrollbar { width: 5px; }
  .fdr-search__dropdown::-webkit-scrollbar-track { background: transparent; }
  .fdr-search__dropdown::-webkit-scrollbar-thumb { background: #ddd; border-radius: 4px; }

</style>


<!-- ===================== JAVASCRIPT ===================== -->
<script>
(function() {
  'use strict';

  /* ================================================================
     REFERENCIAS DOM
  ================================================================ */
  var header        = document.getElementById('fdr-header');
  var burger        = document.getElementById('fdr-burger');
  var nav           = document.getElementById('fdr-nav');
  var overlay       = document.getElementById('fdr-overlay');
  var cartEl        = document.getElementById('fdr-cart-count');
  var searchInput   = document.getElementById('fdr-search-input');
  var searchDrop    = document.getElementById('fdr-search-dropdown');
  var searchResults = document.getElementById('fdr-search-results');
  var shippingBar   = document.getElementById('fdr-shipping-bar');
  var promoCountdown= document.getElementById('fdr-promo-countdown');

  var enableShrink  = header && header.getAttribute('data-shrink') === 'true';

  /* ================================================================
     1. SHRINK EFFECT + BACKDROP BLUR AL SCROLLEAR
  ================================================================ */
  var shrinkThreshold = 50;
  var scrollTicking   = false;

  function onScroll() {
    if (!header) return;
    var sy = window.scrollY || window.pageYOffset;

    /* Clase scrolled */
    header.classList.toggle('fdr-header--scrolled', sy > 10);

    /* Shrink effect */
    if (enableShrink) {
      header.classList.toggle('fdr-header--shrink', sy > shrinkThreshold);
    }

    /* Backdrop blur */
    header.classList.toggle('fdr-header--blurred', sy > shrinkThreshold);

    scrollTicking = false;
  }

  window.addEventListener('scroll', function() {
    if (!scrollTicking) {
      requestAnimationFrame(onScroll);
      scrollTicking = true;
    }
  }, { passive: true });

  /* Ejecutar al cargar */
  onScroll();

  /* ================================================================
     2. BARRA DE ENVIO GRATIS DINAMICA (AJAX)
  ================================================================ */
  function formatMoney(cents) {
    var val = (cents / 100).toFixed(0);
    return '$' + val.replace(/\B(?=(\d{3})+(?!\d))/g, '.');
  }

  window.fdrUpdateShippingBar = function(cartData) {
    if (!shippingBar) return;
    /* Threshold del setting está en pesos (ej: 200000 = $200.000)
       /cart.js devuelve total_price en centavos (ej: 5000000 = $50.000)
       Multiplicamos threshold × 100 para comparar en la misma unidad */
    var threshold = parseInt(shippingBar.getAttribute('data-threshold') || '200000', 10) * 100;
    var total     = cartData && cartData.total_price ? parseInt(cartData.total_price, 10) : 0;
    var remaining = Math.max(0, threshold - total);
    var progress  = Math.min(100, Math.round(total * 100 / threshold));

    var iconEl    = document.getElementById('fdr-shipping-icon');
    var textEl    = document.getElementById('fdr-shipping-text');
    var progEl    = document.getElementById('fdr-shipping-progress');
    var goalEl    = document.getElementById('fdr-shipping-goal');

    if (iconEl) iconEl.textContent = total >= threshold ? '🎉' : (total > 0 ? '🚚' : '🚚');

    if (textEl) {
      if (total >= threshold) {
        textEl.textContent = '{{ section.settings.shipping_free_message | default: "¡Felicidades! Tienes envío gratis" | escape }}';
      } else if (total > 0) {
        textEl.textContent = '\u00a1Te faltan ' + formatMoney(remaining) + ' para envío gratis!';
      } else {
        textEl.textContent = '{{ section.settings.shipping_default_message | default: "Envíos gratis por compras mayores a $200.000" | escape }}';
      }
    }

    if (progEl) progEl.style.width = progress + '%';

    if (goalEl) {
      goalEl.style.display = total >= threshold ? 'none' : '';
    }

    if (total >= threshold) {
      shippingBar.classList.add('fdr-shipping-bar--complete');
    } else {
      shippingBar.classList.remove('fdr-shipping-bar--complete');
    }
  };

  /* ================================================================
     3. BÚSQUEDA PREDICTIVA (debounce 200ms)
  ================================================================ */
  var searchDebounce = null;
  var lastQuery      = '';
  var searchAbort    = null;

  function closeSearchDropdown() {
    if (searchDrop) {
      searchDrop.classList.remove('fdr-search__dropdown--open');
    }
  }

  function openSearchDropdown() {
    if (searchDrop) {
      searchDrop.classList.add('fdr-search__dropdown--open');
    }
  }

  function renderSearchLoading() {
    if (!searchResults) return;
    searchResults.innerHTML =
      '<div class="fdr-search__loading">' +
        '<div class="fdr-search__loading-spinner"></div>' +
        'Buscando...' +
      '</div>';
    openSearchDropdown();
  }

  function renderSearchResults(products, query) {
    if (!searchResults) return;
    if (!products || products.length === 0) {
      searchResults.innerHTML =
        '<div class="fdr-search__no-results">' +
          'No encontramos productos para "' + escapeHtml(query) + '"' +
        '</div>';
      openSearchDropdown();
      return;
    }

    var html = '';
    for (var i = 0; i < products.length; i++) {
      var p     = products[i];
      var img   = p.featured_image ? ('<img src="' + escapeHtml(p.featured_image) + '" alt="" class="fdr-search__result-img" width="48" height="48" loading="lazy">') : '<div class="fdr-search__result-img" style="background:#f0f0f0;"></div>';
      var price = p.price ? formatMoney(p.price) : '';
      var comp  = p.compare_at_price && p.compare_at_price > p.price ? ('<span class="fdr-search__result-compare">' + formatMoney(p.compare_at_price) + '</span>') : '';
      var vid   = p.variants && p.variants[0] && p.variants[0].id ? p.variants[0].id : '';

      html +=
        '<a href="' + escapeHtml(p.url) + '" class="fdr-search__result-item">' +
          img +
          '<div class="fdr-search__result-info">' +
            '<div class="fdr-search__result-title">' + escapeHtml(p.title) + '</div>' +
            '<div class="fdr-search__result-price">' + price + comp + '</div>' +
          '</div>';
      if (vid) {
        html += '<button type="button" class="fdr-search__result-add" onclick="window.fdrQuickAdd(event, ' + vid + ', this)">Añadir</button>';
      }
      html += '</a>';
    }

    html += '<a href="/search?q=' + encodeURIComponent(query) + '" class="fdr-search__view-all">Ver todos los resultados &rarr;</a>';

    searchResults.innerHTML = html;
    openSearchDropdown();
  }

  function escapeHtml(str) {
    if (!str) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function doSearch(query) {
    query = query.trim();
    if (!query || query.length < 2) {
      closeSearchDropdown();
      return;
    }
    lastQuery = query;
    renderSearchLoading();

    if (searchAbort) searchAbort.abort();
    searchAbort = new AbortController();

    var suggestUrl = '/search/suggest.json?q=' + encodeURIComponent(query) +
      '&resources[type]=product' +
      '&resources[limit]=6' +
      '&resources[options][unavailable_products]=last' +
      '&resources[options][fields]=title,variants.title';

    fetch(suggestUrl, { credentials: 'same-origin', signal: searchAbort.signal })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        var products = [];
        if (data && data.resources && data.resources.results && data.resources.results.products) {
          products = data.resources.results.products;
        }
        renderSearchResults(products, query);
      })
      .catch(function(err) {
        if (err.name === 'AbortError') return;
        if (searchResults) {
          searchResults.innerHTML = '<div class="fdr-search__no-results">Error al buscar: ' + escapeHtml(err.description || err.message) + '</div>';
          openSearchDropdown();
        }
      });
  }

  /* Event listeners búsqueda */
  if (searchInput) {
    searchInput.addEventListener('input', function() {
      var val = this.value;
      clearTimeout(searchDebounce);
      searchDebounce = setTimeout(function() { doSearch(val); }, 200);
    });

    searchInput.addEventListener('focus', function() {
      if (this.value.trim().length >= 2) {
        doSearch(this.value);
      }
    });

    /* Cerrar dropdown al click fuera */
    document.addEventListener('click', function(e) {
      var wrap = document.querySelector('.fdr-search-wrap');
      if (wrap && !wrap.contains(e.target)) {
        closeSearchDropdown();
      }
    });

    /* Tecla Escape cierra dropdown */
    searchInput.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        closeSearchDropdown();
        this.blur();
      }
    });
  }

  /* ================================================================
     4. QUICK ADD DESDE BÚSQUEDA PREDICTIVA
  ================================================================ */
  window.fdrQuickAdd = function(event, variantId, btn) {
    if (event) {
      event.preventDefault();
      event.stopPropagation();
    }
    if (!variantId) return;

    btn.textContent = '...';
    btn.disabled = true;

    fetch('/cart/add.js', {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: variantId, quantity: 1 })
    })
    .then(function(r) { return r.json(); })
    .then(function() {
      btn.textContent = '✓';
      btn.classList.add('fdr-search__result-add--added');
      window.fdrUpdateCartCount();
      setTimeout(function() {
        btn.textContent = 'Añadir';
        btn.classList.remove('fdr-search__result-add--added');
        btn.disabled = false;
      }, 1500);
    })
    .catch(function(err) {
      btn.textContent = 'Error';
      console.error('[FDR] Quick add error:', err.description || err.message);
      setTimeout(function() {
        btn.textContent = 'Añadir';
        btn.disabled = false;
      }, 1500);
    });
  };

  /* ================================================================
     5. CONTADOR CARRITO AJAX + ANIMACIÓN BUMP
  ================================================================ */
  window.fdrUpdateCartCount = function() {
    fetch('/cart.js', { credentials: 'same-origin' })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (!cartEl) return;
        var prev = parseInt(cartEl.getAttribute('data-count') || '0', 10);
        cartEl.textContent = data.item_count;
        cartEl.setAttribute('data-count', data.item_count);

        /* Animación bump si cambió */
        if (data.item_count !== prev) {
          cartEl.classList.remove('fdr-cart--bump');
          void cartEl.offsetWidth; /* reflow */
          cartEl.classList.add('fdr-cart--bump');
          setTimeout(function() { cartEl.classList.remove('fdr-cart--bump'); }, 600);
        }

        /* Guardar datos globalmente */
        window.cartData = data;

        /* Actualizar shipping bar */
        window.fdrUpdateShippingBar(data);

        /* Disparar evento para otros listeners */
        document.dispatchEvent(new CustomEvent('cart:updated', { detail: data }));
      })
      .catch(function(err) {
        console.error('[FDR] Cart update error:', err.description || err.message);
      });
  };

  /* Escuchar eventos de carrito */
  document.addEventListener('cart:updated', window.fdrUpdateCartCount);
  document.addEventListener('cart:refresh', window.fdrUpdateCartCount);

  /* Shopify cart API hooks */
  if (window.Shopify && Shopify.onCartUpdate) {
    var origCartUpdate = Shopify.onCartUpdate;
    Shopify.onCartUpdate = function(cart) {
      window.fdrUpdateCartCount();
      if (origCartUpdate) origCartUpdate(cart);
    };
  }

  /* ================================================================
     6. MENÚ MÓVIL (auto-cierre al click link + acordeón)
  ================================================================ */
  function openMenu() {
    if (!nav || !overlay || !burger) return;
    nav.classList.remove('fdr-nav--closing');
    nav.classList.add('fdr-nav--open');
    overlay.classList.add('fdr-overlay--visible');
    burger.classList.add('fdr-burger--open');
    burger.setAttribute('aria-expanded', 'true');
    burger.setAttribute('aria-label', 'Cerrar menú');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    if (!nav || !overlay || !burger) return;
    nav.classList.add('fdr-nav--closing');
    nav.classList.remove('fdr-nav--open');
    overlay.classList.remove('fdr-overlay--visible');
    burger.classList.remove('fdr-burger--open');
    burger.setAttribute('aria-expanded', 'false');
    burger.setAttribute('aria-label', 'Abrir menú');
    document.body.style.overflow = '';
  }

  function toggleMenu() {
    if (!nav) return;
    if (nav.classList.contains('fdr-nav--open')) {
      closeMenu();
    } else {
      openMenu();
    }
  }

  if (burger) {
    burger.addEventListener('click', function(e) {
      e.stopPropagation();
      toggleMenu();
    });
  }

  if (overlay) overlay.addEventListener('click', closeMenu);

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      closeMenu();
      closeSearchDropdown();
    }
  });

  /* === Auto-cierre móvil al click en cualquier link === */
  if (nav) {
    var allLinks = nav.querySelectorAll('a');
    for (var li = 0; li < allLinks.length; li++) {
      allLinks[li].addEventListener('click', function() {
        /* Solo en móvil (<= 768px) */
        if (window.innerWidth <= 768) {
          closeMenu();
        }
      });
    }

    /* Acordeón para items con subniveles en móvil */
    var itemsWithChildren = nav.querySelectorAll('.fdr-nav__item--has-children');
    for (var ci = 0; ci < itemsWithChildren.length; ci++) {
      (function(item) {
        var linkEl = item.querySelector('.fdr-nav__link');
        if (linkEl) {
          linkEl.addEventListener('click', function(e) {
            if (window.innerWidth > 768) return; /* Solo móvil */
            /* Si tiene submenú, togglear acordeón */
            if (item.classList.contains('fdr-nav__item--has-children')) {
              e.preventDefault();
              e.stopPropagation();
              item.classList.toggle('fdr-nav__item--expanded');
            }
          });
        }
      })(itemsWithChildren[ci]);
    }
  }

  /* ================================================================
     7. COUNTDOWN TIMER PARA PROMO BAR
  ================================================================ */
  function initCountdown() {
    var promoBar = document.getElementById('fdr-promo-bar');
    if (!promoBar || !promoCountdown) return;
    var endStr = promoBar.getAttribute('data-promo-end');
    if (!endStr) return;
    var endDate = new Date(endStr);
    if (isNaN(endDate.getTime())) return;

    function updateCountdown() {
      var now = new Date();
      var diff = endDate - now;
      if (diff <= 0) {
        promoCountdown.textContent = '¡Terminó!';
        promoBar.style.opacity = '0.6';
        return;
      }
      var days    = Math.floor(diff / (1000 * 60 * 60 * 24));
      var hours   = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      var minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      var seconds = Math.floor((diff % (1000 * 60)) / 1000);

      var parts = [];
      if (days > 0)    parts.push(days + 'd');
      if (hours > 0 || days > 0) parts.push((hours < 10 ? '0' : '') + hours + 'h');
      parts.push((minutes < 10 ? '0' : '') + minutes + 'm');
      parts.push((seconds < 10 ? '0' : '') + seconds + 's');

      promoCountdown.textContent = parts.join(' ');
    }

    updateCountdown();
    setInterval(updateCountdown, 1000);
  }

  initCountdown();

  /* ================================================================
     8. INICIALIZACIÓN
  ================================================================ */
  document.addEventListener('DOMContentLoaded', function() {
    /* Inicializar contador + shipping bar con datos reales del carrito */
    window.fdrUpdateCartCount();
  });

})();
</script>


