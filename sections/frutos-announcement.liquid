<style>
  /* =============================================
     ANNOUNCEMENT BAR - CRO URGENCIA
     ============================================= */
  .announcement-frutos {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    text-align: center;
    padding: 10px 20px;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.9rem; /* Agregado el 0 para mejor sintaxis */
    font-weight: 600;
    letter-spacing: 0.5px; /* Agregado el 0 */
    position: relative;
    z-index: 100;
  }

  .announcement-frutos a {
    color: {{ section.settings.text_color }};
    text-decoration: underline;
    font-weight: 700;
  }

  .announcement-frutos a:hover {
    opacity: 0.8; /* Agregado el 0 */
  }

  .announcement-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 30px;
    flex-wrap: wrap;
    max-width: 1400px;
    margin: 0 auto;
  }

  .announcement-item {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  @media (max-width: 768px) {
    .announcement-frutos { font-size: 0.78rem; padding: 8px 15px; } /* Agregado el 0 */
    .announcement-inner { gap: 15px; }
  }
</style>

<div class="announcement-frutos">
  <div class="announcement-inner">
    {% for block in section.blocks %}
      <span class="announcement-item" {{ block.shopify_attributes }}>
        {% if block.settings.icon != blank %}
          {{ block.settings.icon }}
        {% endif %}
        {% if block.settings.link != blank %}
          <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
        {% else %}
          {{ block.settings.text }}
        {% endif %}
      </span>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Barra de Urgencia Frutos",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Color de fondo",
      "default": "#1B5E20"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color del texto",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Mensaje",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Emoji o ícono",
          "default": "🚚"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "Envíos gratis desde $120.000 en Bogotá"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace (opcional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Barra de Urgencia Frutos",
      "category": "Custom",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "icon": "🚚",
            "text": "Envíos gratis desde $120.000 en Bogotá"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "🌱",
            "text": "Compra local · Apoya comercio consciente"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "⭐",
            "text": "4.9 en Google · 32 reseñas reales"
          }
        }
      ]
    }
  ]
}
{% endschema %}
